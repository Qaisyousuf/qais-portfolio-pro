---
// Loader.astro - Shows first, triggers content load after completion
---

<div id="loader" class="loader">
  <div class="loader__content">
    <div class="loader__text">
      <span class="loader__line">Built with</span>
      <div class="loader__icons">
        <span class="loader__heart">❤️</span>
        <span class="loader__and">and</span>
        <span class="loader__coffee">☕</span>
      </div>
    </div>
    
   
    
    <div class="loader__dots">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
    </div>
  </div>
</div>

<!-- Content will be injected here after loader -->
<div id="main-content"></div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: opacity 0.8s ease, visibility 0.8s ease;
  }

  .loader.fade-out {
    opacity: 0;
    visibility: hidden;
  }

  .loader__content {
    text-align: center;
  }

  .loader__text {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: 1.5rem;
    animation: fadeInUp 0.8s ease both;
  }

  .loader__line {
    display: block;
    margin-bottom: 1rem;
  }

  .loader__icons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-size: clamp(1.75rem, 5vw, 3rem);
  }

  .loader__heart {
    animation: heartbeat 1.5s ease-in-out infinite;
    display: inline-block;
  }

  .loader__and {
    font-size: clamp(1.25rem, 3vw, 2rem);
    color: rgba(255, 255, 255, 0.6);
    font-weight: 600;
  }

  .loader__coffee {
    animation: steam 2s ease-in-out infinite;
    display: inline-block;
  }

  .loader__author {
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 600;
    color: #3b82f6;
    margin-bottom: 2rem;
    animation: fadeInUp 0.8s ease 0.2s both;
  }

  .loader__dots {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    animation: fadeInUp 0.8s ease 0.4s both;
  }

  .dot {
    width: 8px;
    height: 8px;
    background: rgba(255, 255, 255, 0.4);
    border-radius: 50%;
    animation: bounce 1.4s ease-in-out infinite;
  }

  .dot:nth-child(2) {
    animation-delay: 0.2s;
  }

  .dot:nth-child(3) {
    animation-delay: 0.4s;
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heartbeat {
    0%, 100% {
      transform: scale(1);
    }
    10%, 30% {
      transform: scale(1.1);
    }
    20%, 40% {
      transform: scale(1);
    }
  }

  @keyframes steam {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-3px) rotate(5deg);
    }
  }

  @keyframes bounce {
    0%, 80%, 100% {
      transform: scale(0);
      opacity: 0.5;
    }
    40% {
      transform: scale(1);
      opacity: 1;
    }
  }
</style>

<script>
  // Prevent scrolling during loader
  document.documentElement.style.overflow = 'hidden';
  document.body.style.overflow = 'hidden';
  
  // Wait for loader animation (4 seconds)
  setTimeout(() => {
    const loader = document.getElementById('loader');
    
    // Fade out loader
    loader?.classList.add('fade-out');
    
    // After fade, remove loader and load content
    setTimeout(() => {
      loader?.remove();
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      
      // Trigger content load by dispatching custom event
      window.dispatchEvent(new CustomEvent('loader-complete'));
    }, 800);
  }, 4000);
</script>