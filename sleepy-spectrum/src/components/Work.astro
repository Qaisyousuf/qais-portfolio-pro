---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

import enTranslations from '../translations/en.json';
import daTranslations from '../translations/da.json';
import frTranslations from '../translations/fr.json';
import svTranslations from '../translations/sv.json';
import nlTranslations from '../translations/nl.json';

// Get the right translations based on lang prop
const translations = {
  en: enTranslations,
  da: daTranslations,
  fr: frTranslations,
  sv: svTranslations,
  nl: nlTranslations
}[lang] || enTranslations;

// Get work-specific translations
const t = translations.work;

const projects = [
  {
    id: "a-survey",
    category: t.projects.aSurvey.category,
    title: t.projects.aSurvey.title,
    tagline: t.projects.aSurvey.tagline,
    badges: [
      { type: "status", label: t.projects.aSurvey.badges.status, color: "green" },
      { type: "year", label: t.projects.aSurvey.badges.year, color: "default" },
      { type: "tech", label: t.projects.aSurvey.badges.tech, color: "blue" }
    ],
    client: t.projects.aSurvey.client,
    overview: t.projects.aSurvey.overview,
    impact: t.projects.aSurvey.impact.map((item: any) => ({
      metric: item.metric,
      value: item.value,
      desc: item.desc,
      chartType: item === t.projects.aSurvey.impact[0] ? "doughnut" : item === t.projects.aSurvey.impact[1] ? "bar" : "line"
    })),
    capabilities: t.projects.aSurvey.capabilities,
    techStack: t.projects.aSurvey.techStack,
    projectDetails: t.projects.aSurvey.projectDetails,
    links: t.projects.aSurvey.links
  },
  {
    id: "tasksync",
    category: t.projects.taskSync.category,
    title: t.projects.taskSync.title,
    tagline: t.projects.taskSync.tagline,
    badges: [
      { type: "status", label: t.projects.taskSync.badges.status, color: "blue" },
      { type: "year", label: t.projects.taskSync.badges.year, color: "default" },
      { type: "tech", label: t.projects.taskSync.badges.tech, color: "purple" }
    ],
    client: t.projects.taskSync.client,
    overview: t.projects.taskSync.overview,
    impact: t.projects.taskSync.impact.map((item: any, idx: number) => ({
      metric: item.metric,
      value: item.value,
      desc: item.desc,
      chartType: idx === 0 ? "radar" : idx === 1 ? "polarArea" : "line"
    })),
    capabilities: t.projects.taskSync.capabilities,
    techStack: t.projects.taskSync.techStack,
    projectDetails: t.projects.taskSync.projectDetails,
    links: t.projects.taskSync.links
  },
  {
    id: "invoice-studio",
    category: t.projects.invoiceStudio.category,
    title: t.projects.invoiceStudio.title,
    tagline: t.projects.invoiceStudio.tagline,
    badges: [
      { type: "status", label: t.projects.invoiceStudio.badges.status, color: "blue" },
      { type: "year", label: t.projects.invoiceStudio.badges.year, color: "default" },
      { type: "tech", label: t.projects.invoiceStudio.badges.tech, color: "blue" }
    ],
    client: t.projects.invoiceStudio.client,
    overview: t.projects.invoiceStudio.overview,
    impact: t.projects.invoiceStudio.impact.map((item: any, idx: number) => ({
      metric: item.metric,
      value: item.value,
      desc: item.desc,
      chartType: idx === 0 ? "bar" : idx === 1 ? "doughnut" : "line"
    })),
    capabilities: t.projects.invoiceStudio.capabilities,
    techStack: t.projects.invoiceStudio.techStack,
    projectDetails: t.projects.invoiceStudio.projectDetails,
    links: t.projects.invoiceStudio.links
  },
  {
    id: "seosoft",
    category: t.projects.seoSoft.category,
    title: t.projects.seoSoft.title,
    tagline: t.projects.seoSoft.tagline,
    badges: [
      { type: "status", label: t.projects.seoSoft.badges.status, color: "green" },
      { type: "year", label: t.projects.seoSoft.badges.year, color: "default" },
      { type: "tech", label: t.projects.seoSoft.badges.tech, color: "orange" }
    ],
    client: t.projects.seoSoft.client,
    overview: t.projects.seoSoft.overview,
    impact: t.projects.seoSoft.impact.map((item: any, idx: number) => ({
      metric: item.metric,
      value: item.value,
      desc: item.desc,
      chartType: idx === 0 ? "bar" : idx === 1 ? "doughnut" : "line"
    })),
    capabilities: t.projects.seoSoft.capabilities,
    techStack: t.projects.seoSoft.techStack,
    projectDetails: t.projects.seoSoft.projectDetails,
    links: t.projects.seoSoft.links
  }
];

const defaultProject = projects[0];
const encode = (obj: typeof projects[0]) => encodeURIComponent(JSON.stringify(obj));
---

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<section id="work" class="work-section">
  <div class="work-container">
    <!-- Section Header -->
    <div class="section-header">
      <div class="header-badge">
        <svg class="badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
          <line x1="9" y1="3" x2="9" y2="21" />
        </svg>
        <span>{t.badge}</span>
      </div>
      <h2 class="section-title">{t.title}</h2>
      <p class="section-description">
        {t.subtitle}
      </p>
    </div>
 <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
    <!-- Main Layout -->
    <div class="work-layout">
      <!-- Project Selector -->
      <div class="project-selector">
        {projects.map((project, idx) => (
          <button
            type="button"
            class:list={["selector-card", idx === 0 ? "selector-card--active" : ""]}
            data-project={encode(project)}
          >
            <div class="selector-header">
              <span class="selector-category">{project.category}</span>
              <svg class="selector-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M6 3L11 8L6 13"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
            <h3 class="selector-title">{project.title}</h3>
            <p class="selector-tagline">{project.tagline}</p>
            <div class="selector-badges">
              {project.badges.map((badge) => (
                <span class:list={["selector-badge", `selector-badge--${badge.color}`]}>
                  {badge.label}
                </span>
              ))}
            </div>
          </button>
        ))}
      </div>

      <!-- Main Showcase -->
      <div class="showcase-panel">
        {projects.map((project, idx) => (
          <div
            class="showcase"
            id={`showcase-${project.id}`}
            style={idx === 0 ? "display: block;" : "display: none;"}
          >
            <!-- Header Section with Charts -->
            <div class="showcase-header">
              <div class="header-content">
                <div class="header-text">
                  <div class="header-meta">
                    <span class="meta-category">{project.category}</span>
                    <span class="meta-separator">•</span>
                    <span class="meta-client">{project.client}</span>
                  </div>

                  <h3 class="header-title">{project.title}</h3>
                  <p class="header-tagline">{project.tagline}</p>

                  <div class="header-badges-row">
                    {project.badges.map((badge) => (
                      <span class:list={["badge-pill", `badge-pill--${badge.color}`]}>
                        {badge.label}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Single Prominent Chart -->
                <div class="header-chart-showcase">
                  <canvas id={`chart-showcase-${project.id}`} class="showcase-canvas"></canvas>
                </div>
              </div>
            </div>

            <!-- Overview -->
            <div class="content-section">
              <div class="section-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 16v-4M12 8h.01" />
                </svg>
                <span>{t.labels.overview}</span>
              </div>
              <p class="section-text">{project.overview}</p>
            </div>

            <!-- Impact Metrics -->
            <div class="metrics-section">
              <div class="section-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 3v18h18" />
                  <path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3" />
                </svg>
                <span>{t.labels.impact}</span>
              </div>
              <div class="metrics-grid">
                {project.impact.map((item, metricIdx) => (
                  <div class="metric-card">
                    <div class="metric-chart-container">
                      <canvas id={`chart-${project.id}-${metricIdx}`} class="metric-chart"></canvas>
                    </div>
                    <div class="metric-value">{item.value}</div>
                    <div class="metric-label">{item.metric}</div>
                    <div class="metric-desc">{item.desc}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Two Column Layout -->
            <div class="two-column">
              <!-- Capabilities -->
              <div class="content-section">
                <div class="section-label">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span>{t.labels.capabilities}</span>
                </div>
                <ul class="capabilities-list">
                  {project.capabilities.map((cap) => (
                    <li class="capability-item">
                      <svg class="capability-check" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5" opacity="0.2" />
                        <path
                          d="M5 8L7 10L11 6"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span>{cap}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Project Details -->
              <div class="content-section">
                <div class="section-label">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                  <span>{t.labels.details}</span>
                </div>
                <div class="details-grid">
                  <div class="detail-item">
                    <div class="detail-label">{t.labels.timeline}</div>
                    <div class="detail-value">{project.projectDetails.timeline}</div>
                  </div>
                  <div class="detail-item">
                    <div class="detail-label">{t.labels.role}</div>
                    <div class="detail-value">{project.projectDetails.team}</div>
                  </div>
                  <div class="detail-item">
                    <div class="detail-label">{t.labels.status}</div>
                    <div class="detail-value">{project.projectDetails.delivery}</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tech Stack -->
            <div class="tech-section">
              <div class="section-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                  <line x1="8" y1="21" x2="16" y2="21" />
                  <line x1="12" y1="17" x2="12" y2="21" />
                </svg>
                <span>{t.labels.techStack}</span>
              </div>
              <div class="tech-grid">
                {project.techStack.map((group) => (
                  <div class="tech-group">
                    <div class="tech-category">{group.category}</div>
                    <div class="tech-items">
                      {group.items.map((item) => (
                        <span class="tech-tag">{item}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Actions -->
            <div class="actions-section">
              <a
                href={project.links[0].href}
                class="action-btn action-btn--primary"
                target={project.links[0].href.startsWith("http") ? "_blank" : "_self"}
                rel={project.links[0].href.startsWith("http") ? "noopener noreferrer" : ""}
              >
                <span>{project.links[0].label}</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path
                    d="M3.33337 12.6667L12.6667 3.33337M12.6667 3.33337H3.33337M12.6667 3.33337V12.6667"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
              <a
                href={project.links[1].href}
                class="action-btn action-btn--secondary"
                target={project.links[1].href.startsWith("http") ? "_blank" : "_self"}
                rel={project.links[1].href.startsWith("http") ? "noopener noreferrer" : ""}
              >
                <span>{project.links[1].label}</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path
                    d="M6 3L11 8L6 13"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script is:inline>
    const selectorCards = document.querySelectorAll(".selector-card");
    let currentShowcase = document.getElementById("showcase-a-survey");

    const fadeTransition = async (newShowcase) => {
      currentShowcase.style.opacity = "0.3";
      currentShowcase.style.transform = "translateY(12px)";
      await new Promise((r) => setTimeout(r, 200));

      currentShowcase.style.display = "none";
      newShowcase.style.display = "block";
      newShowcase.style.opacity = "0.3";
      newShowcase.style.transform = "translateY(12px)";

      await new Promise((r) => setTimeout(r, 50));

      newShowcase.style.opacity = "1";
      newShowcase.style.transform = "translateY(0)";

      currentShowcase = newShowcase;
    };

    selectorCards.forEach((card) => {
      card.addEventListener("click", () => {
        const project = JSON.parse(decodeURIComponent(card.dataset.project));
        const newShowcase = document.getElementById(`showcase-${project.id}`);

        if (newShowcase && newShowcase !== currentShowcase) {
          selectorCards.forEach((c) => c.classList.remove("selector-card--active"));
          card.classList.add("selector-card--active");
          fadeTransition(newShowcase);
        }
      });
    });

    function initCharts() {
      if (typeof window.Chart === 'undefined') {
        setTimeout(initCharts, 100);
        return;
      }

      const Chart = window.Chart;

      const showcaseCharts = {
        'a-survey': {
          type: 'bar',
          data: {
            labels: ['Response Quality', 'Processing Time', 'User Satisfaction', 'Data Accuracy', 'Clinical Insights'],
            datasets: [{
              label: 'Improvement %',
              data: [40, 60, 55, 45, 75],
              backgroundColor: [
                'rgba(59, 130, 246, 0.8)',
                'rgba(16, 163, 74, 0.8)',
                'rgba(139, 92, 246, 0.8)',
                'rgba(249, 115, 22, 0.8)',
                'rgba(236, 72, 153, 0.8)'
              ],
              borderRadius: 8,
              borderWidth: 0
            }]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: true,
            animation: {
              duration: 2000,
              easing: 'easeInOutQuart'
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                enabled: true,
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                padding: 12,
                titleColor: '#fff',
                bodyColor: '#fff',
                callbacks: {
                  label: function(context) {
                    return '+' + context.parsed.x + '% improvement';
                  }
                }
              }
            },
            scales: {
              x: {
                grid: {
                  color: 'rgba(255, 255, 255, 0.05)',
                  drawBorder: false
                },
                ticks: {
                  color: 'rgba(255, 255, 255, 0.5)',
                  font: { size: 11 },
                  callback: function(value) {
                    return '+' + value + '%';
                  }
                }
              },
              y: {
                grid: { display: false },
                ticks: {
                  color: 'rgba(255, 255, 255, 0.7)',
                  font: { size: 11, weight: '600' }
                }
              }
            }
          }
        },
        'tasksync': {
          type: 'radar',
          data: {
            labels: ['Sprint Planning', 'Code Quality', 'Velocity', 'Risk Detection', 'Team Clarity', 'Delivery Time'],
            datasets: [
              {
                label: 'Before AI',
                data: [45, 50, 40, 35, 42, 48],
                backgroundColor: 'rgba(239, 68, 68, 0.1)',
                borderColor: 'rgba(239, 68, 68, 0.8)',
                borderWidth: 2,
                pointBackgroundColor: 'rgba(239, 68, 68, 0.8)',
                pointRadius: 4
              },
              {
                label: 'With AI',
                data: [85, 90, 75, 88, 92, 80],
                backgroundColor: 'rgba(59, 130, 246, 0.2)',
                borderColor: 'rgba(59, 130, 246, 0.9)',
                borderWidth: 3,
                pointBackgroundColor: 'rgba(59, 130, 246, 0.9)',
                pointRadius: 5
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            animation: {
              duration: 2000,
              easing: 'easeInOutQuart'
            },
            plugins: {
              legend: {
                display: true,
                position: 'top',
                labels: {
                  color: 'rgba(255, 255, 255, 0.7)',
                  font: { size: 12, weight: '600' },
                  padding: 15
                }
              },
              tooltip: {
                enabled: true,
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                padding: 12
              }
            },
            scales: {
              r: {
                beginAtZero: true,
                max: 100,
                ticks: {
                  color: 'rgba(255, 255, 255, 0.4)',
                  backdropColor: 'transparent',
                  font: { size: 10 }
                },
                grid: {
                  color: 'rgba(255, 255, 255, 0.1)'
                },
                pointLabels: {
                  color: 'rgba(255, 255, 255, 0.7)',
                  font: { size: 11, weight: '600' }
                }
              }
            }
          }
        },
        'invoice-studio': {
          type: 'line',
          data: {
            labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5', 'Week 6', 'Week 7', 'Week 8'],
            datasets: [
              {
                label: 'Manual Processing',
                data: [100, 98, 95, 93, 90, 88, 85, 83],
                borderColor: 'rgba(239, 68, 68, 0.8)',
                backgroundColor: 'rgba(239, 68, 68, 0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.4,
                pointRadius: 4,
                pointBackgroundColor: 'rgba(239, 68, 68, 0.8)'
              },
              {
                label: 'AI-Assisted',
                data: [100, 150, 200, 240, 270, 290, 300, 305],
                borderColor: 'rgba(16, 163, 74, 0.9)',
                backgroundColor: 'rgba(16, 163, 74, 0.1)',
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointRadius: 5,
                pointBackgroundColor: 'rgba(16, 163, 74, 0.9)'
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            animation: {
              duration: 2000,
              easing: 'easeInOutQuart'
            },
            plugins: {
              legend: {
                display: true,
                position: 'top',
                labels: {
                  color: 'rgba(255, 255, 255, 0.7)',
                  font: { size: 12, weight: '600' },
                  padding: 15
                }
              },
              tooltip: {
                enabled: true,
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                padding: 12
              }
            },
            scales: {
              x: {
                grid: {
                  color: 'rgba(255, 255, 255, 0.05)',
                  drawBorder: false
                },
                ticks: {
                  color: 'rgba(255, 255, 255, 0.5)',
                  font: { size: 11 }
                }
              },
              y: {
                beginAtZero: true,
                grid: {
                  color: 'rgba(255, 255, 255, 0.05)',
                  drawBorder: false
                },
                ticks: {
                  color: 'rgba(255, 255, 255, 0.5)',
                  font: { size: 11 },
                  callback: function(value) {
                    return value + ' invoices';
                  }
                }
              }
            }
          }
        },
        'seosoft': {
          type: 'doughnut',
          data: {
            labels: ['Production Systems', 'In Development', 'Maintenance', 'Completed'],
            datasets: [{
              data: [12, 3, 8, 15],
              backgroundColor: [
                'rgba(59, 130, 246, 0.9)',
                'rgba(139, 92, 246, 0.9)',
                'rgba(249, 115, 22, 0.9)',
                'rgba(16, 163, 74, 0.9)'
              ],
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            animation: {
              duration: 2000,
              easing: 'easeInOutQuart'
            },
            plugins: {
              legend: {
                display: true,
                position: 'right',
                labels: {
                  color: 'rgba(255, 255, 255, 0.7)',
                  font: { size: 12, weight: '600' },
                  padding: 15,
                  generateLabels: function(chart) {
                    const data = chart.data;
                    return data.labels.map((label, i) => ({
                      text: label + ': ' + data.datasets[0].data[i],
                      fillStyle: data.datasets[0].backgroundColor[i],
                      hidden: false,
                      index: i
                    }));
                  }
                }
              },
              tooltip: {
                enabled: true,
                backgroundColor: 'rgba(0, 0, 0, 0.8)',
                padding: 12,
                callbacks: {
                  label: function(context) {
                    return context.label + ': ' + context.parsed + ' projects';
                  }
                }
              }
            },
            cutout: '60%'
          }
        }
      };

      Object.keys(showcaseCharts).forEach(projectId => {
        const ctx = document.getElementById(`chart-showcase-${projectId}`);
        if (ctx) {
          const config = showcaseCharts[projectId];
          new Chart(ctx, {
            type: config.type,
            data: config.data,
            options: config.options
          });
        }
      });

      const projects = [
        {
          id: "a-survey",
          charts: [
            { 
              type: "doughnut", 
              data: [40, 60], 
              colors: ['rgba(59, 130, 246, 0.9)', 'rgba(59, 130, 246, 0.1)'],
              title: "+40% Response Quality"
            },
            { 
              type: "bar", 
              data: [100, 40], 
              colors: ['rgba(239, 68, 68, 0.3)', 'rgba(16, 163, 74, 0.9)'],
              labels: ['Before', 'After'],
              title: "-60% Processing Time"
            },
            { 
              type: "line", 
              data: [20, 35, 45, 60, 75, 85, 100], 
              color: 'rgba(139, 92, 246, 0.9)',
              title: "Real-time Growth"
            }
          ]
        },
        {
          id: "tasksync",
          charts: [
            { 
              type: "radar", 
              data: [55, 65, 70, 60, 75], 
              color: 'rgba(59, 130, 246, 0.7)',
              title: "+55% Delivery Clarity"
