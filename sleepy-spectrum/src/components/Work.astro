            }
          ]
        },
        {
          id: "invoice-studio",
          charts: [
            { 
              type: "bar", 
              data: [100, 300], 
              colors: ['rgba(239, 68, 68, 0.3)', 'rgba(59, 130, 246, 0.9)'],
