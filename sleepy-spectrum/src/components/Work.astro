---
/**
 * WORK SECTION — Dark badge style with refined design
 */

interface ProjectLink {
  label: string;
  href: string;
}

interface ProjectData {
  label: string;
  value: string;
}

interface Project {
  id: string;
  chip: string;
  title: string;
  subtitle: string;
  status: string;
  timeframe: string;
  role: string;
  summary: string;
  highlights: string[];
  stack: string[];
  data: ProjectData[];
  links: ProjectLink[];
}

const projects: Project[] = [
  {
    id: "a-survey",
    chip: "AI • Mental Health",
    title: "A-Survey",
    subtitle: "AI-powered online mental health questionnaire",
    status: "Live",
    timeframe: "2025 — Present",
    role: "Full-stack • AI integration",
    summary:
      "An online mental health questionnaire platform using AI to improve question clarity, support structured flows, and produce analytics-ready reporting.",
    highlights: [
      "AI-assisted question refinement (clarity + tone)",
      "Admin builder for questionnaires and flows",
      "Analytics-ready reporting views for insights",
    ],
    stack: ["ASP.NET Core", "Web API", "SQL Server", "Tailwind", "AI Layer"],
    data: [
      { label: "Core modules", value: "Question Builder • AI Assist • Reporting" },
      { label: "Focus", value: "Mental health questionnaires" },
      { label: "Delivery", value: "Production-ready system" },
      { label: "Collaboration", value: "DK ↔ FR (with SeoSoft)" },
    ],
    links: [
      { label: "View collaboration", href: "#credentials" },
      { label: "Contact", href: "#contact" },
    ],
  },
  {
    id: "invoice-studio",
    chip: "AI • Finance",
    title: "Invoice Studio",
    subtitle: "AI-assisted invoicing workflow",
    status: "Active",
    timeframe: "2025 — Present",
    role: "Backend + AI workflows",
    summary:
      "An AI-assisted invoicing system that speeds up invoice creation, improves line item descriptions, and supports automation-friendly exports.",
    highlights: [
      "AI suggestions for invoice items and descriptions",
      "Template-based invoice generation for speed",
      "Export-friendly formats for finance workflows",
    ],
    stack: ["ASP.NET Core", "SQL Server", "AI Assist", "Workflow Engine"],
    data: [
      { label: "Core", value: "Templates • AI suggestions • Exports" },
      { label: "Goal", value: "Faster invoicing + clean data" },
      { label: "Delivery", value: "Active build" },
      { label: "Collaboration", value: "Cross-team iteration" },
    ],
    links: [
      { label: "View collaboration", href: "#credentials" },
      { label: "Contact", href: "#contact" },
    ],
  },
  {
    id: "tasksync",
    chip: "AI • Product",
    title: "TaskSync AI",
    subtitle: "AI-powered project insight dashboard",
    status: "Active",
    timeframe: "2025 — Present",
    role: "Product • Full-stack",
    summary:
      "A dashboard that improves delivery clarity using AI-generated insights, ticket improvements, PR risk signals, and sprint health visibility.",
    highlights: [
      "AI-generated insights and clarity scoring",
      "Secure integrations (OAuth) with engineering tools",
      "Sprint health + QA/test suggestions",
    ],
    stack: ["ASP.NET Core", "Angular", "Tailwind", "OAuth 2.0", "AI Pipelines"],
    data: [
      { label: "Signals", value: "Risk • Clarity • Sprint Health" },
      { label: "Integrations", value: "Jira • GitHub (and more)" },
      { label: "Delivery", value: "Active build" },
      { label: "Website", value: "tasksync.ai" },
    ],
    links: [
      { label: "Visit website", href: "https://tasksync.ai/" },
      { label: "View collaboration", href: "#credentials" },
    ],
  },
  {
    id: "seosoft",
    chip: "Enterprise • Delivery",
    title: "SeoSoft Projects",
    subtitle: "Enterprise portfolio delivered with SeoSoft ApS",
    status: "Ongoing",
    timeframe: "2024 — Present",
    role: "Engineering partner",
    summary:
      "A portfolio of enterprise solutions built with SeoSoft ApS, including automation platforms, education tools, and AI-supported systems.",
    highlights: [
      "OrtoDOC • structured document workflows",
      "SMS Reminder • notification automation",
      "CyberLearn, BatchVision • specialized platforms",
    ],
    stack: ["Enterprise Delivery", "Automation", "AI Systems", "Maintenance"],
    data: [
      { label: "Projects", value: "OrtoDOC • SMS Reminder • CyberLearn • BatchVision" },
      { label: "Model", value: "Long-term collaboration" },
      { label: "Delivery", value: "Ongoing releases" },
      { label: "Website", value: "seosoft.dk" },
    ],
    links: [
      { label: "Visit SeoSoft", href: "https://seosoft.dk/" },
      { label: "View collaboration", href: "#credentials" },
    ],
  },
];

const defaultProject = projects[0];
const encode = (obj: Project): string => encodeURIComponent(JSON.stringify(obj));

interface ExpertiseItem {
  label: string;
  icon: string;
}

const expertise: ExpertiseItem[] = [
  { label: "AI Health", icon: "🏥" },
  { label: "Automation", icon: "⚡" },
  { label: "Analytics", icon: "📊" },
  { label: "Workflows", icon: "🔄" },
];
---

<section id="work" class="relative overflow-hidden bg-black text-white">
  <!-- Minimal dark background -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(255,255,255,0.03),transparent_60%)]"></div>
    <div class="absolute inset-0 opacity-[0.15] [background-image:radial-gradient(rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:32px_32px]"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6 py-28 lg:py-32">
    <!-- Header -->
    <div class="text-center">
      <div class="inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.02] px-4 py-2 text-xs font-bold tracking-wide text-white/60 backdrop-blur-xl">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white/40 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-white/60"></span>
        </span>
        FEATURED WORK
      </div>

      <h2 class="mt-6 bg-gradient-to-b from-white to-white/50 bg-clip-text text-5xl font-black tracking-tight text-transparent sm:text-6xl lg:text-7xl">
        Project Showcase
      </h2>

      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/40">
        Production-ready solutions built with modern tech stacks and clean architecture principles.
      </p>
    </div>

    <!-- FOCUS AREAS - Dark badge style (no colors) -->
    <div class="mx-auto mt-16 max-w-4xl">
      <div class="mb-5 text-center text-xs font-bold uppercase tracking-widest text-white/30">
        Focus Areas
      </div>
      
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {expertise.map((e) => (
          <div class="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] p-5 backdrop-blur-xl transition-all duration-300 hover:border-white/20 hover:bg-white/[0.04] hover:shadow-[0_8px_32px_rgba(0,0,0,0.4)]">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/[0.03] text-xl backdrop-blur-sm transition-all duration-300 group-hover:border-white/20 group-hover:bg-white/[0.06]">
                {e.icon}
              </div>
              <div class="text-sm font-bold text-white/80 transition-colors group-hover:text-white">
                {e.label}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Main layout -->
    <div class="mt-20 grid gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- LEFT: Project rail -->
      <div class="lg:col-span-4">
        <div class="sticky top-24 rounded-2xl border border-white/10 bg-white/[0.02] p-5 backdrop-blur-xl shadow-[0_8px_32px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.06)]">
          <div class="flex items-center justify-between border-b border-white/10 pb-4">
            <div class="text-sm font-bold text-white/90">
              Projects
            </div>
            <div class="rounded-full border border-white/10 bg-white/[0.03] px-2.5 py-1 text-[10px] font-bold text-white/40">
              {projects.length}
            </div>
          </div>

          <div class="mt-4 grid gap-3">
            {projects.map((p, idx) => (
              <button
                type="button"
                class:list={[
                  "project-btn group relative w-full overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] p-4 text-left backdrop-blur-sm transition-all duration-300",
                  "hover:border-white/20 hover:bg-white/[0.04] hover:shadow-[0_8px_24px_rgba(0,0,0,0.5)]",
                  idx === 0 ? "border-white/20 bg-white/[0.04]" : "",
                ]}
                data-project={encode(p)}
              >
                <div class="relative flex items-start justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="rounded-lg border border-white/10 bg-white/[0.04] px-2.5 py-1 text-[10px] font-bold tracking-wide text-white/70">
                        {p.chip}
                      </span>
                      <span class="text-[10px] text-white/30">{p.timeframe}</span>
                    </div>

                    <div class="mt-2.5 truncate text-sm font-black text-white transition-colors group-hover:text-white">
                      {p.title}
                    </div>
                    <div class="mt-1 line-clamp-2 text-xs leading-relaxed text-white/40 transition-colors group-hover:text-white/60">
                      {p.subtitle}
                    </div>
                  </div>

                  <span class="shrink-0 rounded-lg border border-white/10 bg-white/[0.04] px-2.5 py-1 text-[10px] font-bold text-white/70">
                    {p.status}
                  </span>
                </div>

                <div class="relative mt-3.5 flex flex-wrap gap-1.5">
                  {p.stack.slice(0, 3).map((t) => (
                    <span class="rounded-md border border-white/[0.08] bg-white/[0.02] px-2 py-0.5 text-[10px] text-white/50 backdrop-blur-sm">
                      {t}
                    </span>
                  ))}
                </div>

                <div class="relative mt-3 flex items-center justify-between border-t border-white/[0.06] pt-3 text-[10px] text-white/30">
                  <span class="truncate">{p.role}</span>
                  <span class="flex items-center gap-1 opacity-0 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100">
                    View <span>→</span>
                  </span>
                </div>
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- RIGHT: Case study panel -->
      <div class="lg:col-span-8">
        <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] p-8 backdrop-blur-xl shadow-[0_8px_32px_rgba(0,0,0,0.6),inset_0_1px_0_rgba(255,255,255,0.06)] lg:p-10">
          <!-- Subtle glow -->
          <div class="pointer-events-none absolute -top-32 left-1/2 h-64 w-[600px] -translate-x-1/2 rounded-full bg-white/[0.02] blur-3xl"></div>

          <div id="casePanel" class="relative transition-all duration-300">
            <!-- Header -->
            <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span id="caseChip" class="rounded-lg border border-white/10 bg-white/[0.04] px-3.5 py-1.5 text-xs font-bold text-white/70 backdrop-blur-sm">
                    {defaultProject.chip}
                  </span>

                  <span id="caseStatus" class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-3.5 py-1.5 text-xs font-bold text-white/70 backdrop-blur-sm">
                    <span class="h-2 w-2 rounded-full bg-white/60"></span>
                    {defaultProject.status}
                  </span>

                  <span id="caseTime" class="rounded-lg border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-xs text-white/50 backdrop-blur-sm">
                    {defaultProject.timeframe}
                  </span>

                  <span id="caseRole" class="rounded-lg border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-xs text-white/50 backdrop-blur-sm">
                    {defaultProject.role}
                  </span>
                </div>

                <h3 id="caseTitle" class="mt-6 bg-gradient-to-br from-white via-white to-white/60 bg-clip-text text-4xl font-black tracking-tight text-transparent lg:text-5xl">
                  {defaultProject.title}
                </h3>
                <p id="caseSubtitle" class="mt-3 text-base leading-relaxed text-white/40">
                  {defaultProject.subtitle}
                </p>
              </div>

              <div class="flex flex-wrap gap-2.5">
                
                  id="caseLinkPrimary"
                  href={defaultProject.links[0].href}
                  class="group relative inline-flex items-center justify-center gap-2 overflow-hidden rounded-xl border border-white/10 bg-white/[0.04] px-5 py-3 text-sm font-bold text-white backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.06] hover:shadow-[0_8px_32px_rgba(0,0,0,0.6)]"
                  target={defaultProject.links[0].href.startsWith("http") ? "_blank" : "_self"}
                  rel={defaultProject.links[0].href.startsWith("http") ? "noopener noreferrer" : ""}
                >
                  <span class="relative z-10">{defaultProject.links[0].label}</span>
                  <span aria-hidden="true" class="relative z-10 transition-transform duration-300 group-hover:translate-x-0.5">→</span>
                </a>

                
                  id="caseLinkSecondary"
                  href={defaultProject.links[1].href}
                  class="group inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.02] px-5 py-3 text-sm font-bold text-white/60 backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.04] hover:text-white/80"
                  target={defaultProject.links[1].href.startsWith("http") ? "_blank" : "_self"}
                  rel={defaultProject.links[1].href.startsWith("http") ? "noopener noreferrer" : ""}
                >
                  {defaultProject.links[1].label}
                  <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5">→</span>
                </a>
              </div>
            </div>

            <p id="caseSummary" class="mt-8 max-w-4xl text-base leading-loose text-white/50">
              {defaultProject.summary}
            </p>

            <!-- Data tiles -->
            <div id="caseTiles" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
              {defaultProject.data.map((d) => (
                <div class="group relative overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] p-5 backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.04] hover:shadow-[0_8px_24px_rgba(0,0,0,0.4)]">
                  <div class="relative text-[10px] font-bold uppercase tracking-widest text-white/30">
                    {d.label}
                  </div>
                  <div class="relative mt-3 text-sm font-bold leading-relaxed text-white/80 transition-colors group-hover:text-white">
                    {d.value}
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-8 grid gap-4 lg:grid-cols-12">
              <!-- Highlights -->
              <div class="relative overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] p-6 backdrop-blur-sm lg:col-span-7">
                <div class="flex items-center justify-between border-b border-white/[0.06] pb-4">
                  <div class="text-xs font-bold uppercase tracking-widest text-white/30">Key Highlights</div>
                  <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1 text-[10px] font-bold text-white/40">
                    Outcomes
                  </span>
                </div>

                <ul id="caseHighlights" class="mt-5 space-y-3.5 text-sm text-white/60">
                  {defaultProject.highlights.map((h) => (
                    <li class="flex gap-3">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-white/50"></span>
                      <span class="leading-relaxed">{h}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Stack -->
              <div class="relative overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] p-6 backdrop-blur-sm lg:col-span-5">
                <div class="border-b border-white/[0.06] pb-4 text-xs font-bold uppercase tracking-widest text-white/30">
                  Tech Stack
                </div>
                <div id="caseStack" class="mt-5 flex flex-wrap gap-2">
                  {defaultProject.stack.map((t) => (
                    <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-white/60 backdrop-blur-sm transition-all hover:border-white/20 hover:bg-white/[0.05] hover:text-white/80">
                      {t}
                    </span>
                  ))}
                </div>

                <div class="mt-6 rounded-xl border border-white/[0.08] bg-white/[0.02] p-4">
                  <div class="text-[10px] font-bold uppercase tracking-widest text-white/25">Technical Notes</div>
                  <div class="mt-2.5 text-xs leading-relaxed text-white/40">
                    Production-ready with clean architecture, comprehensive testing, and scalable infrastructure.
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const btns = document.querySelectorAll(".project-btn");
    const $ = (id: string) => document.getElementById(id);
    const panel = $("casePanel");

    const fadeOutIn = async (fn: () => void) => {
      if (!panel) return;
      panel.classList.add("case-fade-out");
      await new Promise((r) => setTimeout(r, 150));
      fn();
      panel.classList.remove("case-fade-out");
      panel.classList.add("case-fade-in");
      setTimeout(() => panel.classList.remove("case-fade-in"), 300);
    };

    const renderTiles = (data: { label: string; value: string }[]) =>
      data
        .map(
          (d) => `
          <div class="group relative overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] p-5 backdrop-blur-sm transition-all duration-300 hover:border-white/20 hover:bg-white/[0.04] hover:shadow-[0_8px_24px_rgba(0,0,0,0.4)]">
            <div class="relative text-[10px] font-bold uppercase tracking-widest text-white/30">${d.label}</div>
            <div class="relative mt-3 text-sm font-bold leading-relaxed text-white/80 transition-colors group-hover:text-white">${d.value}</div>
          </div>
        `
        )
        .join("");

    const renderHighlights = (items: string[]) =>
      items
        .map(
          (h) => `
          <li class="flex gap-3">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-white/50"></span>
            <span class="leading-relaxed">${h}</span>
          </li>
        `
        )
        .join("");

    const renderStack = (items: string[]) =>
      items
        .map(
          (t) => `
          <span class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 text-xs font-medium text-white/60 backdrop-blur-sm transition-all hover:border-white/20 hover:bg-white/[0.05] hover:text-white/80">${t}</span>
        `
        )
        .join("");

    const setLinks = (primary: HTMLElement | null, secondary: HTMLElement | null, links: { label: string; href: string }[]) => {
      if (!primary || !secondary) return;
      const p0 = links[0], p1 = links[1];

      primary.innerHTML = `<span class="relative z-10">${p0.label}</span><span aria-hidden="true" class="relative z-10 transition-transform duration-300 group-hover:translate-x-0.5">→</span>`;
      primary.setAttribute('href', p0.href);
      primary.setAttribute('target', p0.href.startsWith("http") ? "_blank" : "_self");
      if (p0.href.startsWith("http")) primary.setAttribute('rel', "noopener noreferrer");

      secondary.innerHTML = `${p1.label}<span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5">→</span>`;
      secondary.setAttribute('href', p1.href);
      secondary.setAttribute('target', p1.href.startsWith("http") ? "_blank" : "_self");
      if (p1.href.startsWith("http")) secondary.setAttribute('rel', "noopener noreferrer");
    };

    interface ProjectData {
      chip: string;
      status: string;
      timeframe: string;
      role: string;
      title: string;
      subtitle: string;
      summary: string;
      data: { label: string; value: string }[];
      highlights: string[];
      stack: string[];
      links: { label: string; href: string }[];
    }

    const setPanel = (p: ProjectData) => {
      const caseChip = $("caseChip");
      const caseStatus = $("caseStatus");
      const caseTime = $("caseTime");
      const caseRole = $("caseRole");
      const caseTitle = $("caseTitle");
      const caseSubtitle = $("caseSubtitle");
      const caseSummary = $("caseSummary");
      const caseTiles = $("caseTiles");
      const caseHighlights = $("caseHighlights");
      const caseStack = $("caseStack");

      if (caseChip) caseChip.textContent = p.chip;
      if (caseStatus) caseStatus.innerHTML = `<span class="h-2 w-2 rounded-full bg-white/60"></span>${p.status}`;
      if (caseTime) caseTime.textContent = p.timeframe;
      if (caseRole) caseRole.textContent = p.role;
      if (caseTitle) caseTitle.textContent = p.title;
      if (caseSubtitle) caseSubtitle.textContent = p.subtitle;
      if (caseSummary) caseSummary.textContent = p.summary;
      if (caseTiles) caseTiles.innerHTML = renderTiles(p.data);
      if (caseHighlights) caseHighlights.innerHTML = renderHighlights(p.highlights);
      if (caseStack) caseStack.innerHTML = renderStack(p.stack);

      setLinks($("caseLinkPrimary"), $("caseLinkSecondary"), p.links);
    };

    btns.forEach((b) => {
      b.addEventListener("click", () => {
        const projectData = (b as HTMLElement).dataset.project;
        if (!projectData) return;
        
        const p: ProjectData = JSON.parse(decodeURIComponent(projectData));

        btns.forEach((x) => {
          x.classList.remove("border-white/20", "bg-white/[0.04]");
        });
        b.classList.add("border-white/20", "bg-white/[0.04]");

        fadeOutIn(() => setPanel(p));
      });
    });
  </script>

  <style>
    .case-fade-out {
      opacity: 0.3;
      transform: translateY(8px);
      transition: opacity 150ms ease, transform 150ms ease;
    }
    .case-fade-in {
      opacity: 1;
      transform: translateY(0);
      transition: opacity 300ms ease, transform 300ms ease;
    }
    @media (prefers-reduced-motion: reduce) {
      .case-fade-out,
      .case-fade-in {
        transition: none !important;
        transform: none !important;
      }
    }

    @keyframes ping {
      75%, 100% {
        transform: scale(2);
        opacity: 0;
      }
    }

    .animate-ping {
      animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  </style>
</section>