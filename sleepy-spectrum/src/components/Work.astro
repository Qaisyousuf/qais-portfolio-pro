              data: [80, 85, 92, 95, 98, 99.5, 100], 
              color: 'rgba(139, 92, 246, 0.9)',
              title: "100% EU Compliance"
            }
          ]
        },
        {
          id: "seosoft",
          charts: [
            { 
              type: "bar", 
              data: [0, 12], 
              colors: ['rgba(59, 130, 246, 0.2)', 'rgba(59, 130, 246, 0.9)'],
              labels: ['Start', 'Now'],
              title: "12+ Projects"
            },
            { 
              type: "doughnut", 
              data: [99.9, 0.1], 
              colors: ['rgba(16, 163, 74, 0.9)', 'rgba(239, 68, 68, 0.2)'],
              title: "99.9% Uptime"
            },
            { 
              type: "line", 
              data: [6, 10, 14, 18, 20, 22, 24], 
              color: 'rgba(139, 92, 246, 0.9)',
              title: "2+ Years Growth"
            }
          ]
        }
      ];

      const commonOptions = {
        responsive: true,
        maintainAspectRatio: true,
        animation: {
          duration: 2000,
          easing: 'easeInOutQuart'
        },
        plugins: {
          legend: { display: false },
          tooltip: { enabled: false }
        }
      };

      function createChart(ctx, chartConfig, isHeader = false) {
        if (!ctx) return;

        switch(chartConfig.type) {
          case "doughnut":
            new Chart(ctx, {
              type: 'doughnut',
              data: {
                datasets: [{
                  data: chartConfig.data,
                  backgroundColor: chartConfig.colors,
                  borderWidth: 0,
                  circumference: isHeader ? 270 : 180,
                  rotation: isHeader ? 225 : 270
                }]
              },
              options: {
                ...commonOptions,
                aspectRatio: isHeader ? 1 : 2,
                cutout: '70%'
              }
            });
            break;

          case "bar":
            new Chart(ctx, {
              type: 'bar',
              data: {
                labels: chartConfig.labels || ['A', 'B'],
                datasets: [{
                  data: chartConfig.data,
                  backgroundColor: chartConfig.colors,
                  borderRadius: 8,
                  borderWidth: 0,
                  barThickness: isHeader ? 24 : 16
                }]
              },
              options: {
                ...commonOptions,
                indexAxis: 'y',
                aspectRatio: isHeader ? 1 : 2.5,
                scales: {
                  x: { display: false },
                  y: { display: false }
                }
              }
            });
            break;

          case "line":
            new Chart(ctx, {
              type: 'line',
              data: {
                labels: Array(chartConfig.data.length).fill(''),
                datasets: [{
                  data: chartConfig.data,
                  borderColor: chartConfig.color,
                  backgroundColor: chartConfig.color.replace('0.9)', '0.15)'),
                  borderWidth: isHeader ? 3 : 2,
                  fill: true,
                  tension: 0.4,
                  pointRadius: 0,
                  pointHoverRadius: 0
                }]
              },
              options: {
                ...commonOptions,
                aspectRatio: isHeader ? 1 : 2.5,
                scales: {
                  x: { display: false },
                  y: { display: false }
                }
              }
            });
            break;

          case "radar":
            new Chart(ctx, {
              type: 'radar',
              data: {
                labels: ['Sprint 1', 'Sprint 2', 'Sprint 3', 'Sprint 4', 'Sprint 5'],
                datasets: [{
                  data: chartConfig.data,
                  backgroundColor: chartConfig.color.replace('0.7)', '0.2)'),
                  borderColor: chartConfig.color,
                  borderWidth: 2,
                  pointRadius: isHeader ? 3 : 0,
                  pointBackgroundColor: chartConfig.color
                }]
              },
              options: {
                ...commonOptions,
                aspectRatio: isHeader ? 1 : 2,
                scales: {
                  r: {
                    display: false,
                    beginAtZero: true,
                    max: 100
                  }
                }
              }
            });
            break;

          case "polarArea":
            new Chart(ctx, {
              type: 'polarArea',
              data: {
                labels: ['Q1', 'Q2', 'Q3', 'Q4', 'Q5'],
                datasets: [{
                  data: chartConfig.data,
                  backgroundColor: chartConfig.colors,
                  borderWidth: 0
                }]
              },
              options: {
                ...commonOptions,
                aspectRatio: isHeader ? 1 : 2,
                scales: {
                  r: { display: false }
                }
              }
            });
            break;
        }
      }

      projects.forEach(project => {
        project.charts.forEach((chartConfig, idx) => {
          const metricsCtx = document.getElementById(`chart-${project.id}-${idx}`);
          createChart(metricsCtx, chartConfig, false);
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCharts);
    } else {
      initCharts();
    }
  </script>
