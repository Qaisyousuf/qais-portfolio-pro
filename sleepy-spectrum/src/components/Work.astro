---
/**
 * WORK SECTION — Next-generation professional showcase
 * - Beautiful badge designs with icons
 * - Organized content with meaningful hierarchy
 * - Stunning glassmorphism cards
 */

const projects = [
  {
    id: "a-survey",
    category: "AI • Mental Health",
    title: "A-Survey",
    tagline: "AI-powered mental health assessment platform",
    badges: [
      { type: "status", label: "Production", color: "green" },
      { type: "year", label: "2025", color: "default" },
      { type: "tech", label: "AI-Powered", color: "blue" }
    ],
    client: "Healthcare Sector (DK)",
    overview:
      "A sophisticated mental health questionnaire platform leveraging AI to enhance question clarity, support structured assessment flows, and generate actionable analytics for healthcare professionals.",
    impact: [
      { metric: "Response Quality", value: "+40%", desc: "improvement through AI assistance" },
      { metric: "Processing Time", value: "-60%", desc: "reduction in report generation" },
      { metric: "Clinical Insights", value: "Real-time", desc: "analytics dashboard" }
    ],
    capabilities: [
      "AI-powered question refinement and tone optimization",
      "Dynamic questionnaire builder with conditional logic",
      "Advanced analytics engine with clinical reporting",
      "GDPR-compliant data handling and encryption"
    ],
    techStack: [
      { category: "Backend", items: ["ASP.NET Core 8", "Web API", "SQL Server", "Azure AI"] },
      { category: "Frontend", items: ["Blazor", "Tailwind CSS", "Chart.js"] },
      { category: "AI/ML", items: ["OpenAI GPT-4", "Azure Cognitive", "ML.NET"] },
      { category: "Cloud", items: ["Azure App Service", "Azure SQL", "Key Vault"] }
    ],
    projectDetails: {
      timeline: "12 weeks",
      team: "Lead Engineer",
      delivery: "Production-ready system"
    },
    links: [
      { label: "View Case Study", href: "#credentials" },
      { label: "Contact for Demo", href: "#contact" }
    ]
  },
  {
    id: "tasksync",
    category: "AI • Product",
    title: "TaskSync AI",
    tagline: "Intelligent project delivery insights platform",
    badges: [
      { type: "status", label: "Active", color: "blue" },
      { type: "year", label: "2025", color: "default" },
      { type: "tech", label: "ML-Driven", color: "purple" }
    ],
    client: "TaskSync AI (FR)",
    overview:
      "An AI-powered dashboard that transforms project management by providing delivery clarity through intelligent insights, ticket quality scoring, PR risk signals, and sprint health monitoring across engineering teams.",
    impact: [
      { metric: "Delivery Clarity", value: "+55%", desc: "sprint predictability boost" },
      { metric: "Risk Detection", value: "Early", desc: "blocker identification" },
      { metric: "Team Velocity", value: "+35%", desc: "productivity increase" }
    ],
    capabilities: [
      "AI-generated clarity scores for tickets and PRs",
      "Secure OAuth integrations with Jira and GitHub",
      "Predictive sprint health analytics",
      "Automated QA suggestions and test recommendations"
    ],
    techStack: [
      { category: "Backend", items: ["ASP.NET Core 8", "Clean Architecture", "MediatR"] },
      { category: "Frontend", items: ["Angular 18", "TypeScript", "RxJS", "Tailwind"] },
      { category: "AI/ML", items: ["Custom ML Models", "Azure OpenAI", "Semantic Analysis"] },
      { category: "Cloud", items: ["Docker", "Azure Kubernetes", "Redis Cache"] }
    ],
    projectDetails: {
      timeline: "16 weeks",
      team: "Product Engineer",
      delivery: "Active development"
    },
    links: [
      { label: "Visit Website", href: "https://tasksync.ai/" },
      { label: "View Collaboration", href: "#credentials" }
    ]
  },
  {
    id: "invoice-studio",
    category: "AI • Finance",
    title: "Invoice Studio",
    tagline: "Smart invoicing with AI assistance",
    badges: [
      { type: "status", label: "Active", color: "blue" },
      { type: "year", label: "2025", color: "default" },
      { type: "tech", label: "AI-Enhanced", color: "blue" }
    ],
    client: "Financial Services (EU)",
    overview:
      "An intelligent invoicing system that accelerates invoice creation through AI-powered line item suggestions, template-based generation, and automation-ready export formats for European financial workflows.",
    impact: [
      { metric: "Creation Speed", value: "3x", desc: "faster invoice generation" },
      { metric: "Data Accuracy", value: "99.2%", desc: "with AI validation" },
      { metric: "EU Compliance", value: "100%", desc: "format compatibility" }
    ],
    capabilities: [
      "AI-powered invoice item and description suggestions",
      "Smart template engine with customization",
      "Multi-currency support with live exchange rates",
      "Automated export to accounting systems"
    ],
    techStack: [
      { category: "Backend", items: ["ASP.NET Core 8", "Entity Framework", "SQL Server"] },
      { category: "Frontend", items: ["Blazor Server", "MudBlazor", "SignalR"] },
      { category: "AI/ML", items: ["GPT-4", "Pattern Recognition"] },
      { category: "Cloud", items: ["Azure App Service", "Azure Functions", "Blob Storage"] }
    ],
    projectDetails: {
      timeline: "8 weeks",
      team: "Backend Engineer",
      delivery: "Feature-complete"
    },
    links: [
      { label: "Technical Details", href: "#credentials" },
      { label: "Discuss Your Project", href: "#contact" }
    ]
  },
  {
    id: "seosoft",
    category: "Enterprise • Partnership",
    title: "SeoSoft Portfolio",
    tagline: "Enterprise solutions delivery partnership",
    badges: [
      { type: "status", label: "Ongoing", color: "green" },
      { type: "year", label: "2024 — Present", color: "default" },
      { type: "tech", label: "Enterprise", color: "orange" }
    ],
    client: "SeoSoft ApS (DK)",
    overview:
      "Long-term engineering partnership delivering enterprise-grade solutions including OrtoDOC document workflows, SMS Reminder automation, CyberLearn education platform, and BatchVision specialized systems.",
    impact: [
      { metric: "Projects", value: "12+", desc: "production systems" },
      { metric: "Uptime", value: "99.9%", desc: "platform reliability" },
      { metric: "Partnership", value: "2+ years", desc: "active collaboration" }
    ],
    capabilities: [
      "Enterprise architecture and system design",
      "Multi-tenant SaaS platform development",
      "Legacy system modernization and migration",
      "Ongoing maintenance and feature development"
    ],
    techStack: [
      { category: "Backend", items: ["ASP.NET Core", "Microservices", "Event-Driven"] },
      { category: "Frontend", items: ["Angular", "React", "Modern CSS"] },
      { category: "Practices", items: ["Clean Architecture", "TDD", "SOLID"] },
      { category: "Cloud", items: ["Azure", "DevOps Pipelines", "Monitoring"] }
    ],
    projectDetails: {
      timeline: "Ongoing",
      team: "Senior Partner",
      delivery: "Continuous releases"
    },
    links: [
      { label: "Visit SeoSoft", href: "https://seosoft.dk/" },
      { label: "Partnership Details", href: "#credentials" }
    ]
  }
];

const defaultProject = projects[0];
const encode = (obj: typeof projects[0]) => encodeURIComponent(JSON.stringify(obj));
---

<section id="work" class="work-section">
  <div class="work-container">
    <!-- Section Header -->
    <div class="section-header">
      <div class="header-badge">
        <svg class="badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
          <line x1="9" y1="3" x2="9" y2="21" />
        </svg>
        <span>Featured Projects</span>
      </div>
      <h2 class="section-title">Building the Future</h2>
      <p class="section-description">
        Production-grade systems combining clean architecture, AI capabilities, and enterprise reliability
      </p>
    </div>

    <!-- Main Layout -->
    <div class="work-layout">
      <!-- Project Selector -->
      <div class="project-selector">
        {projects.map((project, idx) => (
          <button
            type="button"
            class:list={["selector-card", idx === 0 ? "selector-card--active" : ""]}
            data-project={encode(project)}
          >
            <div class="selector-header">
              <span class="selector-category">{project.category}</span>
              <svg class="selector-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path
                  d="M6 3L11 8L6 13"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
            <h3 class="selector-title">{project.title}</h3>
            <p class="selector-tagline">{project.tagline}</p>
            <div class="selector-badges">
              {project.badges.map((badge) => (
                <span class:list={["selector-badge", `selector-badge--${badge.color}`]}>
                  {badge.label}
                </span>
              ))}
            </div>
          </button>
        ))}
      </div>

      <!-- Main Showcase -->
      <div class="showcase-panel">
        {projects.map((project, idx) => (
          <div
            class="showcase"
            id={`showcase-${project.id}`}
            style={idx === 0 ? "display: block;" : "display: none;"}
          >
            <!-- Header Section -->
            <div class="showcase-header">
              <div class="header-meta">
                <span class="meta-category">{project.category}</span>
                <span class="meta-separator">•</span>
                <span class="meta-client">{project.client}</span>
              </div>

              <h3 class="header-title">{project.title}</h3>
              <p class="header-tagline">{project.tagline}</p>

              <div class="header-badges-row">
                {project.badges.map((badge) => (
                  <span class:list={["badge-pill", `badge-pill--${badge.color}`]}>
                    {badge.label}
                  </span>
                ))}
              </div>
            </div>

            <!-- Overview -->
            <div class="content-section">
              <div class="section-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 16v-4M12 8h.01" />
                </svg>
                <span>Project Overview</span>
              </div>
              <p class="section-text">{project.overview}</p>
            </div>

            <!-- Impact Metrics -->
            <div class="metrics-section">
              <div class="section-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 3v18h18" />
                  <path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3" />
                </svg>
                <span>Key Impact</span>
              </div>
              <div class="metrics-grid">
                {project.impact.map((item) => (
                  <div class="metric-card">
                    <div class="metric-value">{item.value}</div>
                    <div class="metric-label">{item.metric}</div>
                    <div class="metric-desc">{item.desc}</div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Two Column Layout -->
            <div class="two-column">
              <!-- Capabilities -->
              <div class="content-section">
                <div class="section-label">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  <span>Core Capabilities</span>
                </div>
                <ul class="capabilities-list">
                  {project.capabilities.map((cap) => (
                    <li class="capability-item">
                      <svg class="capability-check" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.5" opacity="0.2" />
                        <path
                          d="M5 8L7 10L11 6"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                      <span>{cap}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Project Details -->
              <div class="content-section">
                <div class="section-label">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                  <span>Project Details</span>
                </div>
                <div class="details-grid">
                  <div class="detail-item">
                    <div class="detail-label">Timeline</div>
                    <div class="detail-value">{project.projectDetails.timeline}</div>
                  </div>
                  <div class="detail-item">
                    <div class="detail-label">Role</div>
                    <div class="detail-value">{project.projectDetails.team}</div>
                  </div>
                  <div class="detail-item">
                    <div class="detail-label">Status</div>
                    <div class="detail-value">{project.projectDetails.delivery}</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tech Stack -->
            <div class="tech-section">
              <div class="section-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                  <line x1="8" y1="21" x2="16" y2="21" />
                  <line x1="12" y1="17" x2="12" y2="21" />
                </svg>
                <span>Technology Stack</span>
              </div>
              <div class="tech-grid">
                {project.techStack.map((group) => (
                  <div class="tech-group">
                    <div class="tech-category">{group.category}</div>
                    <div class="tech-items">
                      {group.items.map((item) => (
                        <span class="tech-tag">{item}</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Actions -->
            <div class="actions-section">
              <a
                href={project.links[0].href}
                class="action-btn action-btn--primary"
                target={project.links[0].href.startsWith("http") ? "_blank" : "_self"}
                rel={project.links[0].href.startsWith("http") ? "noopener noreferrer" : ""}
              >
                <span>{project.links[0].label}</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path
                    d="M3.33337 12.6667L12.6667 3.33337M12.6667 3.33337H3.33337M12.6667 3.33337V12.6667"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
              <a
                href={project.links[1].href}
                class="action-btn action-btn--secondary"
                target={project.links[1].href.startsWith("http") ? "_blank" : "_self"}
                rel={project.links[1].href.startsWith("http") ? "noopener noreferrer" : ""}
              >
                <span>{project.links[1].label}</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path
                    d="M6 3L11 8L6 13"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script is:inline>
    const selectorCards = document.querySelectorAll(".selector-card");
    let currentShowcase = document.getElementById("showcase-a-survey");

    const fadeTransition = async (newShowcase) => {
      // Fade out current
      currentShowcase.style.opacity = "0.3";
      currentShowcase.style.transform = "translateY(12px)";
      await new Promise((r) => setTimeout(r, 200));

      // Hide current, show new
      currentShowcase.style.display = "none";
      newShowcase.style.display = "block";
      newShowcase.style.opacity = "0.3";
      newShowcase.style.transform = "translateY(12px)";

      await new Promise((r) => setTimeout(r, 50));

      // Fade in new
      newShowcase.style.opacity = "1";
      newShowcase.style.transform = "translateY(0)";

      currentShowcase = newShowcase;
    };

    selectorCards.forEach((card) => {
      card.addEventListener("click", () => {
        const project = JSON.parse(decodeURIComponent(card.dataset.project));
        const newShowcase = document.getElementById(`showcase-${project.id}`);

        if (newShowcase && newShowcase !== currentShowcase) {
          selectorCards.forEach((c) => c.classList.remove("selector-card--active"));
          card.classList.add("selector-card--active");
          fadeTransition(newShowcase);
        }
      });
    });
  </script>

  <style>
    .work-section {
      padding: 6rem 0;
      color: #ffffff;
    }

    :global(.light) .work-section {
      color: #0a0a0b;
    }

    .work-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Section Header */
    .section-header {
      text-align: center;
      margin-bottom: 4rem;
    }

    .header-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.65);
      margin-bottom: 1.5rem;
    }

    :global(.light) .header-badge {
      background: rgba(255, 255, 255, 0.8);
      border-color: rgba(0, 0, 0, 0.08);
      color: rgba(0, 0, 0, 0.6);
    }

    .badge-icon {
      width: 14px;
      height: 14px;
      opacity: 0.6;
    }

    .section-title {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.035em;
      margin-bottom: 1rem;
    }

    .section-description {
      font-size: 1.0625rem;
      color: rgba(255, 255, 255, 0.65);
      max-width: 48rem;
      margin: 0 auto;
      line-height: 1.6;
    }

    :global(.light) .section-description {
      color: rgba(0, 0, 0, 0.6);
    }

    /* Layout */
    .work-layout {
      display: grid;
      gap: 2rem;
      grid-template-columns: 1fr;
    }

    @media (min-width: 1024px) {
      .work-layout {
        grid-template-columns: 320px 1fr;
        gap: 2.5rem;
      }
    }

    /* Project Selector (MAKE STICKY — design unchanged) */
    .project-selector {
      display: grid;
      gap: 1rem;
      height: fit-content;

      position: sticky;
      top: 6rem;
      align-self: start;
    }

    .selector-card {
      position: relative;
      padding: 1.5rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      text-align: left;
      cursor: pointer;
      transition: all 0.3s ease;
      backdrop-filter: blur(20px);
      overflow: hidden;
    }

    .selector-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 3px;
      height: 100%;
      background: transparent;
      transition: all 0.3s ease;
    }

    .selector-card:hover {
      background: rgba(255, 255, 255, 0.03);
      border-color: rgba(255, 255, 255, 0.1);
      transform: translateX(4px);
    }

    .selector-card--active {
      background: rgba(255, 255, 255, 0.04);
      border-color: rgba(59, 130, 246, 0.4);
      box-shadow: 0 0 30px rgba(59, 130, 246, 0.12);
    }

    .selector-card--active::before {
      background: linear-gradient(180deg, #3b82f6, #2563eb);
    }

    :global(.light) .selector-card {
      background: rgba(255, 255, 255, 0.8);
      border-color: rgba(0, 0, 0, 0.08);
    }

    :global(.light) .selector-card:hover {
      background: rgba(255, 255, 255, 0.95);
      border-color: rgba(0, 0, 0, 0.12);
    }

    :global(.light) .selector-card--active {
      border-color: rgba(59, 130, 246, 0.4);
    }

    .selector-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .selector-category {
      font-size: 0.6875rem;
      font-weight: 600;
      padding: 0.25rem 0.625rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 6px;
      color: rgba(255, 255, 255, 0.65);
    }

    :global(.light) .selector-category {
      background: rgba(0, 0, 0, 0.04);
      border-color: rgba(0, 0, 0, 0.08);
      color: rgba(0, 0, 0, 0.6);
    }

    .selector-arrow {
      color: rgba(255, 255, 255, 0.3);
      transition: all 0.3s ease;
    }

    .selector-card:hover .selector-arrow {
      color: #3b82f6;
      transform: translateX(3px);
    }

    .selector-title {
      font-size: 1.125rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 0.5rem;
      line-height: 1.3;
    }

    :global(.light) .selector-title {
      color: #0a0a0b;
    }

    .selector-tagline {
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.4);
      line-height: 1.5;
      margin-bottom: 1rem;
    }

    :global(.light) .selector-tagline {
      color: rgba(0, 0, 0, 0.5);
    }

    .selector-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .selector-badge {
      font-size: 0.6875rem;
      font-weight: 600;
      padding: 0.25rem 0.625rem;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      color: rgba(255, 255, 255, 0.65);
    }

    .selector-badge--green {
      background: rgba(34, 197, 94, 0.1);
      border-color: rgba(34, 197, 94, 0.2);
      color: #22c55e;
    }

    .selector-badge--blue {
      background: rgba(59, 130, 246, 0.1);
      border-color: rgba(59, 130, 246, 0.2);
      color: #3b82f6;
    }

    .selector-badge--purple {
      background: rgba(168, 85, 247, 0.1);
      border-color: rgba(168, 85, 247, 0.2);
      color: #a855f7;
    }

    .selector-badge--orange {
      background: rgba(249, 115, 22, 0.1);
      border-color: rgba(249, 115, 22, 0.2);
      color: #f97316;
    }

    :global(.light) .selector-badge {
      background: rgba(0, 0, 0, 0.04);
      border-color: rgba(0, 0, 0, 0.08);
      color: rgba(0, 0, 0, 0.6);
    }

    /* Showcase */
    .showcase {
      padding: 2.5rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 24px;
      backdrop-filter: blur(20px);
      transition: opacity 0.3s ease, transform 0.3s ease;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    }

    :global(.light) .showcase {
      background: rgba(255, 255, 255, 0.85);
      border-color: rgba(0, 0, 0, 0.08);
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
    }

    /* Header */
    .showcase-header {
      padding-bottom: 2.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      margin-bottom: 2.5rem;
    }

    :global(.light) .showcase-header {
      border-bottom-color: rgba(0, 0, 0, 0.08);
    }

    .header-meta {
      display: flex;
      align-items: center;
