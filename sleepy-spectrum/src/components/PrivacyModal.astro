---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

import enTranslations from '../translations/en.json';
import daTranslations from '../translations/da.json';
import frTranslations from '../translations/fr.json';
import svTranslations from '../translations/sv.json';
import nlTranslations from '../translations/nl.json';

// Get the right translations based on lang prop
const translations = {
  en: enTranslations,
  da: daTranslations,
  fr: frTranslations,
  sv: svTranslations,
  nl: nlTranslations
}[lang] || enTranslations;

// Get privacy-specific translations
const t = translations.privacy;

// Dynamic date formatting
const today = new Date();
const monthNames: { [key: string]: string[] } = {
  en: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
  da: ['Januar', 'Februar', 'Marts', 'April', 'Maj', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'December'],
  fr: ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'],
  sv: ['Januari', 'Februari', 'Mars', 'April', 'Maj', 'Juni', 'Juli', 'Augusti', 'September', 'Oktober', 'November', 'December'],
  nl: ['Januari', 'Februari', 'Maart', 'April', 'Mei', 'Juni', 'Juli', 'Augustus', 'September', 'Oktober', 'November', 'December']
};

const currentMonth = monthNames[lang]?.[today.getMonth()] || monthNames.en[today.getMonth()];
const currentYear = today.getFullYear();

const lastUpdatedText = lang === 'da' ? `Sidst opdateret: ${currentMonth} ${currentYear}` :
                        lang === 'fr' ? `Dernière mise à jour : ${currentMonth} ${currentYear}` :
                        lang === 'sv' ? `Senast uppdaterad: ${currentMonth} ${currentYear}` :
                        lang === 'nl' ? `Laatst bijgewerkt: ${currentMonth} ${currentYear}` :
                        `Last Updated: ${currentMonth} ${currentYear}`;
---

<div id="privacy-modal" class="privacy-modal">
  <div class="privacy-modal__overlay">
    <div class="privacy-modal__content">
      <!-- Header -->
      <div class="privacy-modal__header">
        <div class="header-text">
          <h2 class="privacy-modal__title">{t.title}</h2>
          <p class="privacy-modal__updated">{lastUpdatedText}</p>
        </div>
        <button 
          type="button"
          class="privacy-modal__close" 
          data-close-privacy-modal
          aria-label="Close modal"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Scrollable Body -->
      <div class="privacy-modal__body">
        <!-- Introduction -->
        <div class="privacy-section">
          <div class="section-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 16v-4"></path>
              <path d="M12 8h.01"></path>
            </svg>
          </div>
          <h3 class="privacy-section__title">{t.sections.intro.title}</h3>
          <p class="privacy-section__text">{t.sections.intro.content}</p>
        </div>

        <!-- Data Collection -->
        <div class="privacy-section">
          <div class="section-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <h3 class="privacy-section__title">{t.sections.dataCollection.title}</h3>
          <p class="privacy-section__text">{t.sections.dataCollection.content}</p>
        </div>

        <!-- Data Usage -->
        <div class="privacy-section">
          <div class="section-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
          </div>
          <h3 class="privacy-section__title">{t.sections.dataUsage.title}</h3>
          <p class="privacy-section__text">{t.sections.dataUsage.content}</p>
        </div>

        <!-- Data Storage -->
        <div class="privacy-section">
          <div class="section-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
              <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
            </svg>
          </div>
          <h3 class="privacy-section__title">{t.sections.dataStorage.title}</h3>
          <p class="privacy-section__text">{t.sections.dataStorage.content}</p>
        </div>

        <!-- User Rights -->
        <div class="privacy-section">
          <div class="section-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <h3 class="privacy-section__title">{t.sections.userRights.title}</h3>
          <p class="privacy-section__text">{t.sections.userRights.content}</p>
        </div>

        <!-- Retention -->
        <div class="privacy-section">
          <div class="section-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </div>
          <h3 class="privacy-section__title">{t.sections.retention.title}</h3>
          <p class="privacy-section__text">{t.sections.retention.content}</p>
        </div>

        <!-- Cookies -->
        <div class="privacy-section">
          <div class="section-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v20M2 12h20"></path>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <h3 class="privacy-section__title">{t.sections.cookies.title}</h3>
          <p class="privacy-section__text">{t.sections.cookies.content}</p>
        </div>

        <!-- Contact -->
        <div class="privacy-section privacy-section--contact">
          <div class="section-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <h3 class="privacy-section__title">{t.sections.contact.title}</h3>
          <p class="privacy-section__text">{t.sections.contact.content}</p>
        </div>
      </div>

      <!-- Footer -->
      <div class="privacy-modal__footer">
        <button 
          type="button"
          class="privacy-modal__button" 
          data-close-privacy-modal
        >
          <span>{t.closeButton}</span>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="12" y1="4" x2="4" y2="12"></line>
            <line x1="4" y1="4" x2="12" y2="12"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Modal Container */
  .privacy-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), 
                visibility 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .privacy-modal--open {
    opacity: 1;
    visibility: visible;
  }

  /* Overlay */
  .privacy-modal__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  /* Content Card */
  .privacy-modal__content {
    position: relative;
    width: 100%;
    max-width: 850px;
    max-height: 85vh;
    background: rgba(0, 0, 0, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6),
                0 0 0 1px rgba(255, 255, 255, 0.03),
                inset 0 1px 0 rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    transform: scale(0.9) translateY(20px);
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .privacy-modal--open .privacy-modal__content {
    transform: scale(1) translateY(0);
  }

  :global(.light) .privacy-modal__overlay {
    background: rgba(0, 0, 0, 0.5);
  }

  :global(.light) .privacy-modal__content {
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.12),
                0 0 0 1px rgba(0, 0, 0, 0.03);
  }

  /* Header */
  .privacy-modal__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.5rem 2.5rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  :global(.light) .privacy-modal__header {
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .header-text {
    flex: 1;
  }

  .privacy-modal__title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .privacy-modal__updated {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .privacy-modal__updated::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    opacity: 0.5;
  }

  .privacy-modal__close {
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    color: var(--text-muted);
  }

  .privacy-modal__close:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--text-primary);
    transform: rotate(90deg);
  }

  :global(.light) .privacy-modal__close {
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  :global(.light) .privacy-modal__close:hover {
    background: rgba(0, 0, 0, 0.06);
    border-color: rgba(0, 0, 0, 0.12);
  }

  /* Body - Scrollable */
  .privacy-modal__body {
    flex: 1;
    overflow-y: auto;
    padding: 2rem 2.5rem;
  }

  /* Custom Scrollbar */
  .privacy-modal__body::-webkit-scrollbar {
    width: 6px;
  }

  .privacy-modal__body::-webkit-scrollbar-track {
    background: transparent;
  }

  .privacy-modal__body::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
  }

  .privacy-modal__body::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.15);
  }

  :global(.light) .privacy-modal__body::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.1);
  }

  :global(.light) .privacy-modal__body::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.15);
  }

  /* Privacy Sections */
  .privacy-section {
    margin-bottom: 2.5rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .privacy-section:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .privacy-section:last-child {
    margin-bottom: 0;
  }

  .privacy-section--contact {
    background: rgba(59, 130, 246, 0.05);
    border-color: rgba(59, 130, 246, 0.15);
  }

  .privacy-section--contact:hover {
    background: rgba(59, 130, 246, 0.08);
    border-color: rgba(59, 130, 246, 0.25);
  }

  :global(.light) .privacy-section {
    background: rgba(0, 0, 0, 0.02);
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  :global(.light) .privacy-section:hover {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.08);
  }

  :global(.light) .privacy-section--contact {
    background: rgba(59, 130, 246, 0.05);
    border-color: rgba(59, 130, 246, 0.2);
  }

  :global(.light) .privacy-section--contact:hover {
    background: rgba(59, 130, 246, 0.08);
    border-color: rgba(59, 130, 246, 0.3);
  }

  .section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 8px;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .privacy-section__title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.875rem;
    letter-spacing: -0.02em;
  }

  .privacy-section__text {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin: 0;
  }

  /* Footer */
  .privacy-modal__footer {
    padding: 1.5rem 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: flex-end;
    background: rgba(255, 255, 255, 0.01);
  }

  :global(.light) .privacy-modal__footer {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    background: rgba(0, 0, 0, 0.01);
  }

  .privacy-modal__button {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1.75rem;
    background: rgba(59, 130, 246, 0.12);
    color: var(--accent);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 10px;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
  }

  .privacy-modal__button:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.4);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
  }

  :global(.light) .privacy-modal__button {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.3);
  }

  :global(.light) .privacy-modal__button:hover {
    background: rgba(59, 130, 246, 0.18);
    border-color: rgba(59, 130, 246, 0.5);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.1);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .privacy-modal__overlay {
      padding: 0;
      align-items: flex-end;
    }

    .privacy-modal__content {
      max-height: 92vh;
      border-radius: 20px 20px 0 0;
    }

    .privacy-modal__header {
      padding: 2rem 1.5rem 1.25rem;
      gap: 1rem;
    }

    .privacy-modal__body {
      padding: 1.5rem 1.5rem;
    }

    .privacy-modal__footer {
      padding: 1.25rem 1.5rem;
    }

    .privacy-modal__title {
      font-size: 1.375rem;
    }

    .privacy-section {
      padding: 1.25rem;
      margin-bottom: 1.5rem;
    }

    .privacy-section__title {
      font-size: 1rem;
    }

    .privacy-section__text {
      font-size: 0.875rem;
      line-height: 1.65;
    }

    .section-icon {
      width: 32px;
      height: 32px;
    }

    .privacy-modal__button {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  function initPrivacyModal() {
    const modal = document.getElementById('privacy-modal');
    if (!modal) return;

    const openButtons = document.querySelectorAll('[data-open-privacy-modal]');
    const closeButtons = document.querySelectorAll('[data-close-privacy-modal]');
    const modalOverlay = modal.querySelector('.privacy-modal__overlay');

    // Open modal
    openButtons.forEach(button => {
      button.addEventListener('click', () => {
        modal.classList.add('privacy-modal--open');
        document.body.style.overflow = 'hidden';
      });
    });

    // Close modal function
    const closeModal = () => {
      if (modal) {
        modal.classList.remove('privacy-modal--open');
      }
      document.body.style.overflow = '';
    };

    // Close buttons
    closeButtons.forEach(button => {
      button.addEventListener('click', closeModal);
    });

    // Click outside to close
    if (modalOverlay) {
      modalOverlay.addEventListener('click', (e) => {
        if (e.target === modalOverlay) {
          closeModal();
        }
      });
    }

    // ESC key to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('privacy-modal--open')) {
        closeModal();
      }
    });
  }

  // Initialize on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPrivacyModal);
  } else {
    initPrivacyModal();
  }
</script>