---
/**
 * SERVICES SECTION — Console-style layout
 * - Sticky left sidebar with overview
 * - Bento grid on right with service cards
 * - Design pattern: pure black, glassmorphism, blue accents
 */

const services = [
  {
    id: "01",
    title: "API Development",
    blurb: "Production-ready RESTful & GraphQL endpoints with complete documentation and testing.",
    bullets: ["JWT Authentication", "Swagger/OpenAPI docs", "Rate limiting & caching"],
    outputs: ["Deployed API", "Complete docs", "Test suite", "CI/CD pipeline"],
    timeline: "1-3 weeks",
    price: "€2.5K - €5K",
    tech: ["ASP.NET Core", "Entity Framework", "SQL Server"],
  },
  {
    id: "02",
    title: "Web Applications",
    blurb: "Full-stack solutions with modern UI, real-time features, and scalable architecture.",
    bullets: ["Angular or Blazor frontend", "Real-time with SignalR", "Role-based access control"],
    outputs: ["Live application", "Source code", "User docs", "Admin training"],
    timeline: "2-6 weeks",
    price: "€5K - €15K",
    tech: ["Angular", "Blazor", "ASP.NET Core"],
  },
  {
    id: "03",
    title: "Database Design & Optimization",
    blurb: "Scalable database architecture with performance tuning and migration strategies.",
    bullets: ["Schema design & normalization", "Query optimization", "Indexing strategies"],
    outputs: ["Database schema", "Migration scripts", "Performance report", "Backup strategy"],
    timeline: "1-2 weeks",
    price: "€1.5K - €4K",
    tech: ["SQL Server", "PostgreSQL", "Entity Framework"],
  },
  {
    id: "04",
    title: "UI/UX Design",
    blurb: "User-centered design with modern interfaces, prototypes, and complete design systems.",
    bullets: ["User research & wireframes", "High-fidelity mockups", "Design system creation"],
    outputs: ["Figma designs", "Prototype", "Design system", "Style guide"],
    timeline: "2-4 weeks",
    price: "€3K - €7K",
    tech: ["Figma", "Adobe XD", "Design Systems"],
  },
  {
    id: "05",
    title: "AI Integration",
    blurb: "Add intelligence to your systems with OpenAI, Azure AI, or custom ML models.",
    bullets: ["OpenAI/Azure AI setup", "Custom integrations", "Cost optimization"],
    outputs: ["AI-powered features", "Integration docs", "Usage monitoring"],
    timeline: "2-4 weeks",
    price: "€3K - €8K",
    tech: ["OpenAI", "Azure AI", "ML.NET"],
  },
  {
    id: "06",
    title: "Mobile App Development",
    blurb: "Cross-platform mobile applications with native performance and seamless user experience.",
    bullets: ["iOS & Android apps", "Native performance", "Offline-first architecture"],
    outputs: ["Published apps", "Source code", "Documentation", "App store assets"],
    timeline: "4-8 weeks",
    price: "€8K - €20K",
    tech: [".NET MAUI", "Xamarin", "React Native"],
  },
  {
    id: "07",
    title: "E-commerce Solutions",
    blurb: "Complete online store with payment integration, inventory management, and analytics.",
    bullets: ["Product catalog & cart", "Payment processing", "Order management"],
    outputs: ["Live store", "Admin dashboard", "Payment setup", "Analytics"],
    timeline: "4-6 weeks",
    price: "€7K - €15K",
    tech: ["ASP.NET Core", "Stripe", "Azure"],
  },
  {
    id: "08",
    title: "Maintenance & Support",
    blurb: "Keep your systems secure, fast, and up-to-date with proactive monitoring.",
    bullets: ["Security patches", "Performance tuning", "24-hour response time"],
    outputs: ["Monthly reports", "Priority bug fixes", "Performance optimization"],
    timeline: "Ongoing",
    price: "€800 - €2K/mo",
    tech: [".NET", "Azure", "DevOps"],
  },
];

const highlights = [
  "Fixed-scope pricing",
  "Predictable timelines",
  "Production-grade quality",
  "Complete documentation",
  "Clean architecture",
  "Direct communication"
];
---

<section id="services" class="services-section">
  <div class="services-container">
    <!-- Top Section Badge -->
    <div class="section-badge">
      <div class="badge-content">
        <svg class="badge-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
          <path d="M2 17l10 5 10-5"/>
          <path d="M2 12l10 5 10-5"/>
        </svg>
        <span>AVAILABLE FOR PROJECTS</span>
      </div>
    </div>

    <div class="services-layout">
      <!-- LEFT: Sticky Console -->
      <aside class="console-sidebar">
        <div class="console-sticky">
          <div class="console-header">
            <div class="console-eyebrow">Services & Pricing</div>
          </div>

          <h2 class="console-title">
            Build Your
            <span class="console-title-accent">Perfect Solution</span>
          </h2>

          <p class="console-description">
            Fixed-scope projects with clear deliverables and predictable timelines. No hourly rates, just results.
          </p>

          <!-- Command Terminal -->
          <div class="terminal-widget">
            <div class="terminal-header">
              <div class="terminal-dots">
                <span class="terminal-dot terminal-dot--red"></span>
                <span class="terminal-dot terminal-dot--yellow"></span>
                <span class="terminal-dot terminal-dot--green"></span>
              </div>
              <span class="terminal-path">/services</span>
              <div class="terminal-status">
                <span class="status-pulse"></span>
                <span class="status-text">live</span>
              </div>
            </div>

            <div class="terminal-body">
              <div class="terminal-section">
                <div class="section-header">
                  <svg class="section-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 11 12 14 22 4"/>
                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                  </svg>
                  <p class="terminal-label">WHAT YOU GET</p>
                </div>

                <ul class="highlights-list">
                  {highlights.map((highlight) => (
                    <li class="highlight-item">
                      <div class="highlight-icon">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                          <polyline points="20 6 9 17 4 12"/>
                        </svg>
                      </div>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="terminal-actions">
                <a href="#contact" class="terminal-btn terminal-btn--primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                  <span>Start Project</span>
                </a>
                <a href="#work" class="terminal-btn terminal-btn--secondary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                  <span>View Work</span>
                </a>
              </div>
            </div>
          </div>

          <p class="console-footer">
            All projects include documentation, testing, and deployment support.
          </p>
        </div>
      </aside>

      <!-- RIGHT: Bento Grid -->
      <div class="bento-grid">
        {services.map((service, idx) => (
          <article class="service-card">
            <!-- Animated border (on hover) -->
            <div class="card-border-glow"></div>

            <div class="card-content">
              <!-- Header -->
              <div class="card-header">
                <div class="card-meta">
                  <span class="card-number">{service.id}</span>
                  {idx === 0 && (
                    <span class="popular-badge">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                      Popular
                    </span>
                  )}
                </div>
              </div>

              <h3 class="card-title">{service.title}</h3>
              <p class="card-blurb">{service.blurb}</p>

              <!-- Timeline Badge Only -->
              <div class="card-info-row">
                <div class="info-badge info-badge--time">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  <span>{service.timeline}</span>
                </div>
              </div>

              <!-- Two-column spec -->
              <div class="card-specs">
                <div class="spec-box">
                  <div class="spec-header">
                    <svg class="spec-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <polyline points="9 11 12 14 22 4"/>
                      <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                    </svg>
                    <p class="spec-label">WHAT WE DO</p>
                  </div>
                  <ul class="spec-list">
                    {service.bullets.map((bullet) => (
                      <li class="spec-item">
                        <div class="check-icon">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"/>
                          </svg>
                        </div>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="spec-box">
                  <div class="spec-header">
                    <svg class="spec-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                      <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    <p class="spec-label">YOU GET</p>
                  </div>
                  <ul class="spec-list">
                    {service.outputs.slice(0, 3).map((output) => (
                      <li class="spec-item">
                        <div class="check-icon">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"/>
                          </svg>
                        </div>
                        <span>{output}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Tech Stack Pills -->
              <div class="tech-stack">
                <div class="tech-label">Stack:</div>
                <div class="tech-pills">
                  {service.tech.map((tech) => (
                    <span class="tech-pill">{tech}</span>
                  ))}
                </div>
              </div>

              <!-- Expandable Pricing -->
              <details class="pricing-details">
                <summary class="pricing-summary">
                  <span class="summary-icon">+</span>
                  <span>View Pricing</span>
                </summary>
                <div class="pricing-content">
                  <div class="price-display">
                    <span class="price-label">Investment:</span>
                    <span class="price-value">{service.price}</span>
                  </div>
                </div>
              </details>

              <!-- Footer CTA -->
              <div class="card-footer">
                <a href="#contact" class="card-cta">
                  <span>Start Project</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Bottom Status Bar -->
    <div class="status-bar">
      <p class="status-message">
        Need something custom? Let's discuss your specific requirements and build a tailored solution.
      </p>
      <div class="status-indicators">
        <span class="status-dot"></span>
        <span class="status-label">system: ready</span>
        <span class="status-separator">|</span>
        <span class="status-label">response: 24h</span>
      </div>
    </div>
  </div>

  <style>
    .services-section {
      padding: 6rem 0;
      color: #ffffff;
      position: relative;
    }

    :global(.light) .services-section {
      color: #0a0a0b;
    }

    .services-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    /* Section Badge */
    .section-badge {
      text-align: center;
      margin-bottom: 4rem;
    }

    .badge-content {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      padding: 0.5rem 1.125rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 9999px;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    :global(.light) .badge-content {
      background: rgba(255, 255, 255, 0.8);
      border-color: rgba(0, 0, 0, 0.08);
    }

    .badge-icon {
      width: 14px;
      height: 14px;
      color: rgba(255, 255, 255, 0.6);
      opacity: 0.8;
    }

    :global(.light) .badge-icon {
      color: rgba(0, 0, 0, 0.6);
    }

    .badge-content span {
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.2em;
      color: rgba(255, 255, 255, 0.6);
    }

    :global(.light) .badge-content span {
      color: rgba(0, 0, 0, 0.6);
    }

    /* Layout */
    .services-layout {
      display: grid;
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    @media (min-width: 1024px) {
      .services-layout {
        grid-template-columns: 380px 1fr;
        gap: 4rem;
      }
    }

    /* Console Sidebar */
    .console-sidebar {
      position: relative;
    }

    @media (min-width: 1024px) {
      .console-sticky {
        position: sticky;
        top: 6rem;
      }
    }

    .console-header {
      margin-bottom: 1rem;
    }

    .console-eyebrow {
      font-size: 0.8125rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.5);
      letter-spacing: 0.02em;
    }

    :global(.light) .console-eyebrow {
      color: rgba(0, 0, 0, 0.5);
    }

    .console-title {
      font-size: 2.5rem;
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.035em;
      margin-bottom: 1rem;
    }

    .console-title-accent {
      color: #3b82f6;
    }

    .console-description {
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.65);
      line-height: 1.6;
      margin-bottom: 1.75rem;
    }

    :global(.light) .console-description {
      color: rgba(0, 0, 0, 0.65);
    }

    /* Terminal Widget */
    .terminal-widget {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      overflow: hidden;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      margin-bottom: 1.25rem;
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);
    }

    :global(.light) .terminal-widget {
      background: rgba(255, 255, 255, 0.8);
      border-color: rgba(0, 0, 0, 0.08);
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
    }

    .terminal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.875rem 1.125rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      background: rgba(255, 255, 255, 0.02);
      position: relative;
    }

    :global(.light) .terminal-header {
      border-bottom-color: rgba(0, 0, 0, 0.06);
      background: rgba(0, 0, 0, 0.02);
    }

    .terminal-dots {
      display: flex;
      gap: 0.4375rem;
      z-index: 1;
    }

    .terminal-dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }

    .terminal-dot--red { background: #ff5f56; }
    .terminal-dot--yellow { background: #ffbd2e; }
    .terminal-dot--green { background: #27ca40; }

    .terminal-path {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.6875rem;
      font-family: 'JetBrains Mono', monospace;
      color: rgba(255, 255, 255, 0.4);
      font-weight: 500;
    }

    :global(.light) .terminal-path {
      color: rgba(0, 0, 0, 0.4);
    }

    .terminal-status {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.25rem 0.625rem;
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: 6px;
      z-index: 1;
    }

    .status-pulse {
      width: 6px;
      height: 6px;
      background: #3b82f6;
      border-radius: 50%;
      animation: pulse-blue 2s ease-in-out infinite;
    }

    @keyframes pulse-blue {
      0%, 100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7); }
      50% { box-shadow: 0 0 0 6px rgba(59, 130, 246, 0); }
    }

    .status-text {
      font-size: 0.625rem;
      font-weight: 700;
      color: #3b82f6;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .terminal-body {
      padding: 1.5rem 1.25rem;
    }

    .terminal-section {
      margin-bottom: 1.5rem;
    }

    .section-header {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    :global(.light) .section-header {
      border-bottom-color: rgba(0, 0, 0, 0.08);
    }

    .section-icon {
      color: #3b82f6;
      flex-shrink: 0;
    }

    .terminal-label {
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      color: rgba(255, 255, 255, 0.5);
      margin: 0;
    }

    :global(.light) .terminal-label {
      color: rgba(0, 0, 0, 0.5);
    }

    .highlights-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.875rem;
    }

    .highlight-item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.75);
      line-height: 1.5;
      transition: all 0.2s ease;
    }

    .highlight-item:hover {
      color: rgba(255, 255, 255, 0.95);
    }

    :global(.light) .highlight-item {
      color: rgba(0, 0, 0, 0.75);
    }

    :global(.light) .highlight-item:hover {
      color: rgba(0, 0, 0, 0.95);
    }

    .highlight-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      flex-shrink: 0;
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.2);
      border-radius: 4px;
      margin-top: 0.125rem;
      transition: all 0.3s ease;
    }

    .highlight-icon svg {
      width: 10px;
      height: 10px;
      color: #3b82f6;
    }

    .highlight-item:hover .highlight-icon {
      background: rgba(59, 130, 246, 0.15);
      border-color: rgba(59, 130, 246, 0.3);
      transform: scale(1.1);
    }

    .terminal-actions {
      display: flex;
      gap: 0.75rem;
      padding-top: 0.25rem;
    }

    .terminal-btn {
      flex: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.75rem 1.125rem;
      font-size: 0.8125rem;
      font-weight: 700;
      border-radius: 10px;
      text-align: center;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .terminal-btn svg {
      width: 16px;
      height: 16px;
      transition: transform 0.3s ease;
    }

    .terminal-btn--primary {
      background: rgba(59, 130, 246, 0.15);
      color: #3b82f6;
      border: 1px solid rgba(59, 130, 246, 0.3);
    }

    .terminal-btn--primary:hover {
      background: rgba(59, 130, 246, 0.25);
      border-color: rgba(59, 130, 246, 0.5);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(59, 130, 246, 0.25);
    }

    .terminal-btn--primary:hover svg {
      transform: translateX(3px);
    }

    .terminal-btn--secondary {
      background: rgba(255, 255, 255, 0.03);
      color: rgba(255, 255, 255, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .terminal-btn--secondary:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.15);
      color: #ffffff;
      transform: translateY(-2px);
    }

    :global(.light) .terminal-btn--primary {
      background: rgba(59, 130, 246, 0.1);
      border-color: rgba(59, 130, 246, 0.3);
    }

    :global(.light) .terminal-btn--secondary {
      background: rgba(0, 0, 0, 0.04);
      border-color: rgba(0, 0, 0, 0.1);
      color: rgba(0, 0, 0, 0.75);
    }

    :global(.light) .terminal-btn--secondary:hover {
      background: rgba(0, 0, 0, 0.08);
      color: #0a0a0b;
    }
      border-color: rgba(255, 255, 255, 0.1);{
      color: #ffffff;
    }

    :global(.light) .terminal-btn--primary {
      background: rgba(59, 130, 246, 0.1);
      border-color: rgba(59, 130, 246, 0.3);
    }

    :global(.light) .terminal-btn--secondary {
      background: rgba(0, 0, 0, 0.04);
      border-color: rgba(0, 0, 0, 0.08);
      color: rgba(0, 0, 0, 0.7);
    }

    .console-footer {
      font-size: 0.8125rem;
      color: rgba(255, 255, 255, 0.45);
      line-height: 1.5;
    }

    :global(.light) .console-footer {
      color: rgba(0, 0, 0, 0.45);
    }

    /* Bento Grid */
    .bento-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    @media (min-width: 768px) {
      .bento-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    /* Service Cards */
    .service-card {
      position: relative;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 24px;
      overflow: hidden;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      transition: border-color 0.3s ease;
    }

    .service-card:hover {
      border-color: rgba(59, 130, 246, 0.3);
    }

    :global(.light) .service-card {
      background: rgba(255, 255, 255, 0.9);
      border-color: rgba(0, 0, 0, 0.08);
    }

    :global(.light) .service-card:hover {
      border-color: rgba(59, 130, 246, 0.3);
    }

    .card-border-glow {
      display: none;
    }

    .card-content {
      position: relative;
      padding: 2rem;
      z-index: 1;
    }

    /* Card Header */
    .card-header {
