---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

const terminalTags = ["ASP.NET Core", "Angular", "Azure", "AI Integration", "Clean Architecture"];

const availabilityItems = [
  { 
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M12 2L2 7l10 5 10-5-10-5z"/>
      <path d="M2 17l10 5 10-5"/>
      <path d="M2 12l10 5 10-5"/>
    </svg>`,
    text: "Build scalable APIs and modern web apps with clean architecture"
  },
  { 
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="12" r="3"/>
      <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
    </svg>`,
    text: "Integrate AI capabilities into your existing .NET systems"
  },
  { 
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
      <circle cx="12" cy="12" r="10"/>
      <polyline points="12 6 12 12 16 14"/>
    </svg>`,
    text: "Ship faster with predictable delivery and 24h response time"
  },
];
---

<section class="hero">
  <div class="hero__content">
    <h1 class="hero__title">
      Build reliable <span class="accent">APIs</span>, modern<br>
      <span class="accent">web apps</span> & <span class="accent">AI solutions</span>
    </h1>

    <p class="hero__subtitle">
      Senior .NET engineer helping European teams build scalable systems and integrate AI. 
      Clean architecture, predictable delivery.
    </p>

    <div class="terminal-card">
      <div class="terminal-header">
        <div class="terminal-dots">
          <span class="terminal-dot terminal-dot--red"></span>
          <span class="terminal-dot terminal-dot--yellow"></span>
          <span class="terminal-dot terminal-dot--green"></span>
        </div>
        <div class="terminal-title">qais@portfolio:~/work</div>
        <span class="terminal-badge">live</span>
      </div>
      <div class="terminal-body">
        <span class="terminal-prompt">❯</span> <span id="typed"></span><span class="terminal-cursor"></span>
      </div>
      <div class="terminal-footer">
        {terminalTags.map(tag => (
          <span class="terminal-tag">{tag}</span>
        ))}
      </div>
    </div>

    <div class="hero__cta">
      <a class="btn btn--primary btn--lg" href="#work">View Projects</a>
      <a class="btn btn--secondary btn--lg" href="#contact">Contact Me</a>
      <a class="btn btn--ghost btn--lg" href="#">Download CV</a>
    </div>

    <div class="availability-card">
      <div class="availability-grid">
        {availabilityItems.map((item) => (
          <div class="availability-item">
            <span class="availability-icon" set:html={item.icon} />
            <p class="availability-text">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const messages = [
    "dotnet new webapi --name SecureAPI",
    "Integrating OpenAI + Azure AI Services...",
    "ASP.NET Core + Clean Architecture + AI",
    "Building intelligent .NET solutions...",
    "8+ years delivering production excellence"
  ];
  
  let msgIndex = 0;
  let charIndex = 0;
  const typedEl = document.getElementById('typed');
  
  function typeMessage() {
    if (!typedEl) return;
    const msg = messages[msgIndex];
    if (charIndex < msg.length) {
      typedEl.textContent += msg.charAt(charIndex++);
      setTimeout(typeMessage, 45);
    } else {
      setTimeout(() => {
        typedEl.textContent = '';
        charIndex = 0;
        msgIndex = (msgIndex + 1) % messages.length;
        typeMessage();
      }, 2200);
    }
  }
  
  typeMessage();
</script>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 5rem 2rem 3rem;
  }

  .hero__content {
    max-width: 900px;
    width: 100%;
  }

  .hero__title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin-bottom: 1.25rem;
    animation: fadeInUp 0.6s ease both;
  }

  .accent {
    color: var(--accent);
  }

  .hero__subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
    animation: fadeInUp 0.6s ease 0.1s both;
  }

  /* Terminal */
  .terminal-card {
    width: 100%;
    max-width: 540px;
    margin: 0 auto 2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    overflow: hidden;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    animation: fadeInUp 0.6s ease 0.15s both;
  }

  :global(.light) .terminal-card {
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  :global(.light) .terminal-header {
    background: rgba(0, 0, 0, 0.02);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .terminal-dots {
    display: flex;
    gap: 5px;
  }

  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .terminal-dot--red { background: #ff5f56; }
  .terminal-dot--yellow { background: #ffbd2e; }
  .terminal-dot--green { background: #27ca40; }

  .terminal-title {
    flex: 1;
    text-align: center;
    font-size: 10px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  .terminal-badge {
    font-size: 8px;
    padding: 2px 6px;
    background: var(--accent-subtle);
    color: var(--accent);
    border-radius: 50px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .terminal-body {
    padding: 1rem 1.25rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    line-height: 1.8;
    min-height: 60px;
    display: flex;
    align-items: center;
  }

  .terminal-prompt {
    color: var(--success);
  }

  .terminal-cursor {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--accent);
    margin-left: 2px;
    animation: blink 1s step-end infinite;
    vertical-align: text-bottom;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .terminal-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0.625rem 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.01);
    justify-content: center;
  }

  :global(.light) .terminal-footer {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    background: rgba(0, 0, 0, 0.01);
  }

  .terminal-tag {
    font-size: 9px;
    padding: 2px 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  :global(.light) .terminal-tag {
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  /* CTA Buttons */
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 2.5rem;
    animation: fadeInUp 0.6s ease 0.2s both;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Inter', sans-serif;
    border-radius: 8px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    white-space: nowrap;
  }

  .btn--primary {
    background: rgba(59, 130, 246, 0.15);
    color: var(--accent);
    border-color: rgba(59, 130, 246, 0.25);
  }

  .btn--primary:hover {
    background: rgba(59, 130, 246, 0.25);
    border-color: rgba(59, 130, 246, 0.4);
  }

  :global(.light) .btn--primary {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.3);
  }

  :global(.light) .btn--primary:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
  }

  .btn--secondary {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    border-color: rgba(255, 255, 255, 0.06);
  }

  .btn--secondary:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
  }

  :global(.light) .btn--secondary {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.1);
  }

  :global(.light) .btn--secondary:hover {
    background: rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 0, 0, 0.15);
  }

  .btn--ghost {
    background: transparent;
    color: var(--text-muted);
    border-color: rgba(255, 255, 255, 0.04);
  }

  .btn--ghost:hover {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
  }

  :global(.light) .btn--ghost {
    border-color: rgba(0, 0, 0, 0.08);
  }

  :global(.light) .btn--ghost:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .btn--lg {
    padding: 0.625rem 1.25rem;
    font-size: 13px;
    border-radius: 9px;
  }

  /* Availability Card - Glass Style */
  .availability-card {
    width: 100%;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3),
                0 1px 2px rgba(0, 0, 0, 0.2);
    animation: fadeInUp 0.6s ease 0.3s both;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .availability-card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(59, 130, 246, 0.4);
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4),
                0 0 20px rgba(59, 130, 246, 0.15),
                0 0 0 1px rgba(59, 130, 246, 0.2);
  }

  :global(.light) .availability-card {
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08),
                0 1px 2px rgba(0, 0, 0, 0.04);
  }

  :global(.light) .availability-card:hover {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(59, 130, 246, 0.5);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12),
                0 0 20px rgba(59, 130, 246, 0.1),
                0 0 0 1px rgba(59, 130, 246, 0.3);
  }

  .availability-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .availability-item {
    text-align: left;
  }

  .availability-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: 1rem;
    color: var(--text-muted);
    opacity: 0.6;
    transition: all 0.2s ease;
  }

  .availability-item:hover .availability-icon {
    color: var(--accent);
    opacity: 1;
  }

  .availability-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .availability-text {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .hero {
      padding: 5rem 1rem 2rem;
    }

    .hero__title {
      font-size: 1.875rem;
    }

    .availability-card {
      padding: 1.5rem;
    }

    .availability-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .availability-item {
      text-align: center;
    }

    .availability-icon {
      margin: 0 auto 0.75rem;
    }
  }
</style>