---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

// Import translations
import enTranslations from '../translations/en.json';
import daTranslations from '../translations/da.json';
import frTranslations from '../translations/fr.json';
import svTranslations from '../translations/sv.json';
import nlTranslations from '../translations/nl.json';

// Get the right translations based on lang prop
const translations = {
  en: enTranslations,
  da: daTranslations,
  fr: frTranslations,
  sv: svTranslations,
  nl: nlTranslations
}[lang] || enTranslations;

// Get hero-specific translations
const t = translations.hero;

const contractTypes = [
  { 
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 11l3 3L22 4"/>
      <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
    </svg>`,
    title: t.contracts.fixedScope.title,
    duration: t.contracts.fixedScope.duration,
    description: t.contracts.fixedScope.description
  },
  { 
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"/>
      <polyline points="12 6 12 12 16 14"/>
    </svg>`,
    title: t.contracts.shortTerm.title,
    duration: t.contracts.shortTerm.duration,
    description: t.contracts.shortTerm.description
  },
  { 
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
      <polyline points="7 10 12 15 17 10"/>
      <line x1="12" y1="15" x2="12" y2="3"/>
    </svg>`,
    title: t.contracts.aiIntegration.title,
    duration: t.contracts.aiIntegration.duration,
    description: t.contracts.aiIntegration.description
  },
  { 
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 20h9"/>
      <path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
    </svg>`,
    title: t.contracts.consulting.title,
    duration: t.contracts.consulting.duration,
    description: t.contracts.consulting.description
  },
  { 
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
      <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>
    </svg>`,
    title: t.contracts.retainer.title,
    duration: t.contracts.retainer.duration,
    description: t.contracts.retainer.description
  },
  { 
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/>
      <path d="M21 21l-4.35-4.35"/>
      <path d="M11 8a3 3 0 00-3 3"/>
    </svg>`,
    title: t.contracts.audit.title,
    duration: t.contracts.audit.duration,
    description: t.contracts.audit.description
  },
];

const suggestions = [
  { 
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="3"/>
      <path d="M12 1v6m0 6v6M5.6 5.6l4.2 4.2m4.2 4.2l4.2 4.2M1 12h6m6 0h6M5.6 18.4l4.2-4.2m4.2-4.2l4.2-4.2"/>
    </svg>`,
    text: t.suggestions.experience
  },
  { 
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
      <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>
    </svg>`,
    text: t.suggestions.projects
  },
  { 
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2L2 7l10 5 10-5-10-5z"/>
      <path d="M2 17l10 5 10-5"/>
      <path d="M2 12l10 5 10-5"/>
    </svg>`,
    text: t.suggestions.techStack
  },
  { 
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="12" y1="1" x2="12" y2="23"/>
      <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
    </svg>`,
    text: t.suggestions.pricing
  },
  { 
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"/>
      <polyline points="12 6 12 12 16 14"/>
    </svg>`,
    text: t.suggestions.availability
  },
  { 
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
    </svg>`,
    text: t.suggestions.contact
  }
];
---

<section class="hero">
  <div class="hero__content">
    <h1 class="hero__title">
      {t.title} <span class="accent">{t.titleAccent1}</span>{t.titleMid}<br>
      <span class="accent">{t.titleAccent2}</span> {t.titleEnd} <span class="accent">{t.titleAccent3}</span>
    </h1>

    <p class="hero__subtitle">
      {t.subtitle}
    </p>

    <!-- AI Chat Interface - Replaces Project Flow -->
    <div class="chat-container">
      <div class="chat-header">
        <div class="chat-header-left">
          <div class="chat-avatar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <div class="chat-header-info">
            <h3 class="chat-header-title">{t.chatHeader.title}</h3>
            <p class="chat-header-subtitle">{t.chatHeader.subtitle}</p>
          </div>
        </div>
        <div class="chat-header-right">
          <button id="speakerButton" class="speaker-button active" title="Voice responses on">
            <svg class="speaker-on" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
              <path d="M19.07 4.93a10 10 0 010 14.14M15.54 8.46a5 5 0 010 7.07"/>
            </svg>
            <svg class="speaker-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
              <line x1="23" y1="9" x2="17" y2="15"/>
              <line x1="17" y1="9" x2="23" y2="15"/>
            </svg>
          </button>
          <button id="clearChat" class="clear-chat-button" title="Clear conversation">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"/>
              <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/>
            </svg>
          </button>
          <div class="chat-header-badge">
            <span class="status-dot"></span>
            {t.chatHeader.online}
          </div>
        </div>
      </div>

      <div class="chat-messages" id="chatMessages">
        <!-- Messages will be added here dynamically -->
      </div>

      <div class="chat-suggestions" id="chatSuggestions">
        {suggestions.map((suggestion) => (
          <button class="suggestion-chip" data-suggestion={suggestion.text}>
            <span class="suggestion-icon" set:html={suggestion.icon} />
            <span class="suggestion-text">{suggestion.text}</span>
          </button>
        ))}
      </div>

      <div class="chat-input-wrapper">
        <textarea 
          id="chatInput"
          class="chat-input" 
          placeholder={t.chatPlaceholder}
          rows="1"
        ></textarea>
        <div class="chat-input-actions">
          <button id="stopButton" class="stop-button" style="display: none;" title="Stop speaking">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <rect x="6" y="6" width="12" height="12" rx="2"/>
            </svg>
          </button>
          <button id="voiceButton" class="voice-button" title="Voice input">
            <svg class="voice-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/>
              <path d="M19 10v2a7 7 0 01-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="23"/>
              <line x1="8" y1="23" x2="16" y2="23"/>
            </svg>
            <div class="voice-listening" style="display: none;">
              <div class="voice-pulse"></div>
            </div>
          </button>
          <button id="sendMessage" class="chat-send-button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <div class="hero__cta">
     
     
    
    </div>

    <div class="contract-section">
      <div class="contract-header">
        <h3 class="contract-title">{t.contractSection.title}</h3>
        <p class="contract-subtitle">{t.contractSection.subtitle}</p>
      </div>
      
      <div class="contract-grid">
        {contractTypes.map((contract) => (
          <div class="contract-card">
            <div class="contract-card-inner">
              <div class="contract-icon" set:html={contract.icon} />
              <div class="contract-content">
                <h4 class="contract-name">{contract.title}</h4>
                <span class="contract-duration">{contract.duration}</span>
                <p class="contract-description">{contract.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="modal-overlay">
  <div class="modal-content">
    <div class="modal-icon">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
    </div>
    <h3 class="modal-title">{t.modal.title}</h3>
    <p class="modal-message">{t.modal.message}</p>
    <div class="modal-actions">
      <button id="cancelDelete" class="modal-btn modal-btn--cancel">{t.modal.cancel}</button>
      <button id="confirmDelete" class="modal-btn modal-btn--confirm">{t.modal.confirm}</button>
    </div>
  </div>
</div>
<script>
  class ChatInterface {
    messages: Array<{role: string, content: string}>;
    isTyping: boolean;
    messagesContainer: HTMLElement | null;
    input: HTMLTextAreaElement | null;
    sendButton: HTMLElement | null;
    voiceButton: HTMLElement | null;
    speakerButton: HTMLElement | null;
    stopButton: HTMLElement | null;
    suggestions: HTMLElement | null;
    messageCount: number;
    maxMessagesPerSession: number;
    recognition: any;
    isListening: boolean;
    isSpeaking: boolean;
    voiceEnabled: boolean;
    currentAudio: HTMLAudioElement | null;

    constructor() {
      this.messages = [];
      this.isTyping = false;
      this.messageCount = 0;
      this.maxMessagesPerSession = 20;
      this.isListening = false;
      this.isSpeaking = false;
      this.voiceEnabled = true;
      this.currentAudio = null;
      
      this.messagesContainer = document.getElementById('chatMessages');
      this.input = document.getElementById('chatInput') as HTMLTextAreaElement;
      this.sendButton = document.getElementById('sendMessage');
      this.voiceButton = document.getElementById('voiceButton');
      this.speakerButton = document.getElementById('speakerButton');
      this.stopButton = document.getElementById('stopButton');
      this.suggestions = document.getElementById('chatSuggestions');
      
      this.setupVoiceRecognition();
      this.init();
      this.loadChatHistory();
      
      this.updateSpeakerButtonState();
    }

    setupVoiceRecognition() {
      const SpeechRecognition = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
      
      if (!SpeechRecognition) {
        console.log('Speech recognition not supported');
        if (this.voiceButton) {
          this.voiceButton.style.display = 'none';
        }
        return;
      }

      this.recognition = new SpeechRecognition();
      this.recognition.continuous = false;
      this.recognition.interimResults = false;
      this.recognition.lang = 'en-US';

      this.recognition.onstart = () => {
        this.isListening = true;
        const icon = this.voiceButton?.querySelector('.voice-icon') as HTMLElement;
        const pulse = this.voiceButton?.querySelector('.voice-listening') as HTMLElement;
        if (icon) icon.style.display = 'none';
        if (pulse) pulse.style.display = 'flex';
        if (this.voiceButton) {
          this.voiceButton.classList.add('listening');
        }
      };

      this.recognition.onresult = (event: any) => {
        const transcript = event.results[0][0].transcript;
        if (this.input) {
          this.input.value = transcript;
          this.input.style.height = 'auto';
          this.input.style.height = Math.min(this.input.scrollHeight, 120) + 'px';
        }
      };

      this.recognition.onend = () => {
        this.isListening = false;
        const icon = this.voiceButton?.querySelector('.voice-icon') as HTMLElement;
        const pulse = this.voiceButton?.querySelector('.voice-listening') as HTMLElement;
        if (icon) icon.style.display = 'block';
        if (pulse) pulse.style.display = 'none';
        if (this.voiceButton) {
          this.voiceButton.classList.remove('listening');
        }
      };

      this.recognition.onerror = (event: any) => {
        console.error('Speech recognition error:', event.error);
        this.isListening = false;
        const icon = this.voiceButton?.querySelector('.voice-icon') as HTMLElement;
        const pulse = this.voiceButton?.querySelector('.voice-listening') as HTMLElement;
        if (icon) icon.style.display = 'block';
        if (pulse) pulse.style.display = 'none';
        if (this.voiceButton) {
          this.voiceButton.classList.remove('listening');
        }
      };
    }

    toggleVoiceRecognition() {
      if (!this.recognition) return;

      if (this.isListening) {
        this.recognition.stop();
      } else {
        this.recognition.start();
      }
    }

    toggleSpeaker() {
      this.voiceEnabled = !this.voiceEnabled;
      this.updateSpeakerButtonState();
      
      if (!this.voiceEnabled && this.isSpeaking) {
        this.stopSpeaking();
      }
    }

    updateSpeakerButtonState() {
      const speakerOn = this.speakerButton?.querySelector('.speaker-on') as HTMLElement;
      const speakerOff = this.speakerButton?.querySelector('.speaker-off') as HTMLElement;
      
      if (this.voiceEnabled) {
        if (speakerOn) speakerOn.style.display = 'block';
        if (speakerOff) speakerOff.style.display = 'none';
        this.speakerButton?.classList.add('active');
      } else {
        if (speakerOn) speakerOn.style.display = 'none';
        if (speakerOff) speakerOff.style.display = 'block';
        this.speakerButton?.classList.remove('active');
      }
    }

    speak(text: string) {
      if (!this.voiceEnabled) return;

      this.speakerButton?.classList.add('speaking');
      this.isSpeaking = true;
      if (this.stopButton) this.stopButton.style.display = 'flex';

      fetch('/api/tts', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ text }),
      })
        .then(response => response.json())
        .then(data => {
          if (data.audioContent) {
            const audioBlob = this.base64ToBlob(data.audioContent, 'audio/mp3');
            const audioUrl = URL.createObjectURL(audioBlob);
            this.currentAudio = new Audio(audioUrl);

            this.currentAudio.onended = () => {
              this.isSpeaking = false;
              this.speakerButton?.classList.remove('speaking');
              if (this.stopButton) this.stopButton.style.display = 'none';
              URL.revokeObjectURL(audioUrl);
              this.currentAudio = null;
            };

            this.currentAudio.onerror = () => {
              console.error('Audio playback error');
              this.isSpeaking = false;
              this.speakerButton?.classList.remove('speaking');
              if (this.stopButton) this.stopButton.style.display = 'none';
              URL.revokeObjectURL(audioUrl);
              this.currentAudio = null;
            };

            this.currentAudio.play();
          }
        })
        .catch(error => {
          console.error('TTS error:', error);
          this.isSpeaking = false;
          this.speakerButton?.classList.remove('speaking');
          if (this.stopButton) this.stopButton.style.display = 'none';
        });
    }

    stopSpeaking() {
      if (this.currentAudio) {
        this.currentAudio.pause();
        this.currentAudio = null;
      }
      this.isSpeaking = false;
      this.speakerButton?.classList.remove('speaking');
      if (this.stopButton) this.stopButton.style.display = 'none';
    }

    base64ToBlob(base64: string, contentType: string): Blob {
      const byteCharacters = atob(base64);
      const byteArrays = [];

      for (let offset = 0; offset < byteCharacters.length; offset += 512) {
        const slice = byteCharacters.slice(offset, offset + 512);
        const byteNumbers = new Array(slice.length);
        
        for (let i = 0; i < slice.length; i++) {
          byteNumbers[i] = slice.charCodeAt(i);
        }
        
        const byteArray = new Uint8Array(byteNumbers);
        byteArrays.push(byteArray);
      }

      return new Blob(byteArrays, { type: contentType });
    }

    init() {
      this.sendButton?.addEventListener('click', () => this.sendMessage());
      this.voiceButton?.addEventListener('click', () => this.toggleVoiceRecognition());
      this.speakerButton?.addEventListener('click', () => this.toggleSpeaker());
      this.stopButton?.addEventListener('click', () => this.stopSpeaking());

      const clearButton = document.getElementById('clearChat');
      clearButton?.addEventListener('click', () => this.clearChat());

      const cancelBtn = document.getElementById('cancelDelete');
      const confirmBtn = document.getElementById('confirmDelete');
      const modalOverlay = document.getElementById('deleteModal');
      
      cancelBtn?.addEventListener('click', () => this.hideDeleteModal());
      confirmBtn?.addEventListener('click', () => this.confirmClearChat());
      modalOverlay?.addEventListener('click', (e) => {
        if (e.target === modalOverlay) {
          this.hideDeleteModal();
        }
      });

      this.input?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          this.sendMessage();
        }
      });

      this.input?.addEventListener('input', (e) => {
        const target = e.target as HTMLTextAreaElement;
        if (target) {
          target.style.height = '48px';
          if (target.scrollHeight > 48) {
            target.style.height = Math.min(target.scrollHeight, 120) + 'px';
            target.style.overflowY = 'auto';
          } else {
            target.style.overflowY = 'hidden';
          }
        }
      });

      document.querySelectorAll('.suggestion-chip').forEach(chip => {
        chip.addEventListener('click', (e) => {
          const suggestion = (e.currentTarget as HTMLElement).getAttribute('data-suggestion');
          if (suggestion && this.input) {
            this.input.value = suggestion;
            this.sendMessage();
          }
        });
      });
    }

    loadChatHistory() {
      try {
        const savedMessages = localStorage.getItem('chatHistory');
        if (savedMessages) {
          const history = JSON.parse(savedMessages);
          this.messages = history.messages || [];
          this.messageCount = history.messageCount || 0;
          
          if (history.messages && history.messages.length > 0) {
            history.messages.forEach((msg: any) => {
              if (msg.role === 'user') {
                this.addMessage(msg.content, 'user', false);
              } else if (msg.role === 'assistant') {
                this.addMessage(msg.content, 'ai', false);
              }
            });
          }
        }
      } catch (error) {
        console.error('Failed to load chat history:', error);
      }
    }

    saveChatHistory() {
      try {
        localStorage.setItem('chatHistory', JSON.stringify({
          messages: this.messages,
          messageCount: this.messageCount,
          timestamp: Date.now()
        }));
      } catch (error) {
        console.error('Failed to save chat history:', error);
      }
    }

    logConversation(question: string, response: string) {
      try {
        const sessionId = sessionStorage.getItem('chatSessionId') || 
          (sessionStorage.setItem('chatSessionId', crypto.randomUUID()), 
           sessionStorage.getItem('chatSessionId'));

        const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        const countryMap: Record<string, string> = {
          'Europe/Paris': 'France',
          'Europe/Copenhagen': 'Denmark',
          'Europe/Stockholm': 'Sweden',
          'Europe/Amsterdam': 'Netherlands',
          'Europe/London': 'UK',
          'Europe/Berlin': 'Germany',
          'America/New_York': 'USA (East)',
          'America/Los_Angeles': 'USA (West)'
        };

        fetch('/api/log', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question: question,
            response: response,
            sessionId: sessionId,
            page: window.location.pathname,
            referrer: document.referrer || 'direct',
            device: /Mobile|Android|iPhone/i.test(navigator.userAgent) ? 'mobile' : 'desktop',
            language: navigator.language,
            country: countryMap[timezone] || timezone,
            screenSize: `${window.innerWidth}x${window.innerHeight}`,
            conversationLength: this.messages.length / 2
          })
        }).catch(() => {});
      } catch {
      }
    }

    showDeleteModal() {
      const modal = document.getElementById('deleteModal');
      if (modal) {
        modal.style.display = 'flex';
        setTimeout(() => {
          modal.classList.add('show');
        }, 10);
      }
    }

    hideDeleteModal() {
      const modal = document.getElementById('deleteModal');
      if (modal) {
        modal.classList.remove('show');
        setTimeout(() => {
          modal.style.display = 'none';
        }, 300);
      }
    }

    confirmClearChat() {
      this.hideDeleteModal();
      
      if (this.messagesContainer) {
        this.messagesContainer.innerHTML = '';
      }
      
      this.messages = [];
      this.messageCount = 0;
      
      localStorage.removeItem('chatHistory');

      if (this.suggestions) {
        this.suggestions.style.display = 'flex';
      }

      const tempMessage = document.createElement('div');
      tempMessage.className = 'message message--ai';
      tempMessage.innerHTML = `
        <div class="message-avatar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
        </div>
        <div class="message-content">
          <div class="message-bubble" style="background: rgba(34, 197, 94, 0.1); border-color: rgba(34, 197, 94, 0.2);">
            Conversation cleared!
          </div>
        </div>
      `;
      
      this.messagesContainer?.appendChild(tempMessage);
      
      setTimeout(() => {
        tempMessage.remove();
      }, 2000);
    }

    clearChat() {
      this.showDeleteModal();
    }

    clearOldHistory() {
      try {
        const saved = localStorage.getItem('chatHistory');
        if (saved) {
          const history = JSON.parse(saved);
          const oneDayAgo = Date.now() - (24 * 60 * 60 * 1000);
          if (history.timestamp && history.timestamp < oneDayAgo) {
            localStorage.removeItem('chatHistory');
            this.messages = [];
            this.messageCount = 0;
          }
        }
      } catch (error) {
        console.error('Failed to clear old history:', error);
      }
    }

    addMessage(text: string, role: 'user' | 'ai', typewriter = false) {
      if (!this.messagesContainer) return;

      const messageDiv = document.createElement('div');
      messageDiv.className = `message message--${role}`;
      
      // FORCE user message styling with inline styles
      if (role === 'user') {
        messageDiv.style.display = 'flex';
        messageDiv.style.flexDirection = 'column';
        messageDiv.style.justifyContent = 'space-around';
        messageDiv.style.width = '100%';
        messageDiv.style.marginLeft = 'auto';
        messageDiv.style.alignItems = 'flex-end';
      }
      
      // FORCE AI message styling to LEFT side with VERTICAL stacking
      if (role === 'ai') {
        messageDiv.style.display = 'flex';
        messageDiv.style.flexDirection = 'column'; // Stack vertically
        messageDiv.style.justifyContent = 'flex-start';
        messageDiv.style.alignItems = 'flex-start'; // Align to LEFT
        messageDiv.style.width = '100%';
      }
      
      const avatar = document.createElement('div');
      avatar.className = 'message-avatar';
      avatar.innerHTML = role === 'ai' 
        ? `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
             <rect x="2" y="2" width="20" height="20" rx="5" fill="#3B82F6" class="avatar-bg"/>
             <text x="12" y="17" font-family="Arial, sans-serif" font-size="14" font-weight="700" fill="white" text-anchor="middle" class="avatar-letter">G</text>
           </svg>`
        : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
             <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
             <circle cx="12" cy="7" r="4"/>
           </svg>`;

      const content = document.createElement('div');
      content.className = 'message-content';
      
      // FORCE content alignment for user messages
      if (role === 'user') {
        content.style.alignItems = 'flex-end';
        content.style.display = 'flex';
        content.style.flexDirection = 'column';
      }
      
      // FORCE content alignment for AI messages
      if (role === 'ai') {
        content.style.alignItems = 'flex-start';
        content.style.display = 'flex';
        content.style.flexDirection = 'column';
      }
      
      const bubble = document.createElement('div');
      bubble.className = 'message-bubble';
      
      if (typewriter) {
        this.typewriterEffect(bubble, text);
      } else {
        bubble.textContent = text;
      }

      content.appendChild(bubble);
      messageDiv.appendChild(avatar);
      messageDiv.appendChild(content);
      this.messagesContainer.appendChild(messageDiv);
      
      this.scrollToBottom();
    }

    typewriterEffect(element: HTMLElement, text: string) {
      let index = 0;
      const speed = 15;
      
      if (this.voiceEnabled) {
        this.speak(text);
      }
      
      const type = () => {
        if (index < text.length) {
          element.textContent += text.charAt(index);
          index++;
          this.scrollToBottom();
          setTimeout(type, speed);
        }
      };
      
      type();
    }

    showThinking() {
      if (!this.messagesContainer) return;
      
      const thinkingDiv = document.createElement('div');
      thinkingDiv.className = 'message message--ai';
      thinkingDiv.id = 'thinkingIndicator';
      
      // FORCE LEFT alignment with VERTICAL stacking for thinking indicator
      thinkingDiv.style.display = 'flex';
      thinkingDiv.style.flexDirection = 'column'; // Stack vertically
      thinkingDiv.style.justifyContent = 'flex-start';
      thinkingDiv.style.alignItems = 'flex-start'; // Align to LEFT
      thinkingDiv.style.width = '100%';
      
      thinkingDiv.innerHTML = `
        <div class="message-avatar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="20" height="20" rx="5" fill="#3B82F6" class="avatar-bg"/>
            <text x="12" y="17" font-family="Arial, sans-serif" font-size="14" font-weight="700" fill="white" text-anchor="middle" class="avatar-letter">G</text>
          </svg>
        </div>
        <div class="message-content" style="align-items: flex-start; display: flex; flex-direction: column;">
          <div class="thinking-indicator" style="margin-left: 0; margin-right: auto;">
            <div class="spinner-loader"></div>
            <span>Thinking...</span>
          </div>
        </div>
      `;
      
      this.messagesContainer.appendChild(thinkingDiv);
      this.scrollToBottom();
    }

    hideThinking() {
      const thinkingIndicator = document.getElementById('thinkingIndicator');
      thinkingIndicator?.remove();
    }

    showTyping() {
      if (!this.messagesContainer) return;
      
      const typingDiv = document.createElement('div');
      typingDiv.className = 'message message--ai typing-indicator';
      typingDiv.id = 'typingIndicator';
      
      // FORCE LEFT alignment with VERTICAL stacking for typing indicator
      typingDiv.style.display = 'flex';
      typingDiv.style.flexDirection = 'column'; // Stack vertically
      typingDiv.style.justifyContent = 'flex-start';
      typingDiv.style.alignItems = 'flex-start'; // Align to LEFT
      typingDiv.style.width = '100%';
      
      typingDiv.innerHTML = `
        <div class="message-avatar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="2" y="2" width="20" height="20" rx="5" fill="#3B82F6" class="avatar-bg"/>
            <text x="12" y="17" font-family="Arial, sans-serif" font-size="14" font-weight="700" fill="white" text-anchor="middle" class="avatar-letter">G</text>
          </svg>
        </div>
        <div class="message-content" style="align-items: flex-start; display: flex; flex-direction: column;">
          <div class="message-bubble" style="margin-left: 0; margin-right: auto;">
            <div class="typing-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>
        </div>
      `;
      
      this.messagesContainer.appendChild(typingDiv);
      this.scrollToBottom();
    }

    hideTyping() {
      const typingIndicator = document.getElementById('typingIndicator');
      typingIndicator?.remove();
    }

    scrollToBottom() {
      if (this.messagesContainer) {
        this.messagesContainer.scrollTop = this.messagesContainer.scrollHeight;
      }
    }

    async sendMessage() {
      const text = this.input?.value.trim();
      if (!text || this.isTyping) return;

      if (this.messageCount >= this.maxMessagesPerSession) {
        this.addMessage(
          `You've reached the limit of ${this.maxMessagesPerSession} messages for this session. For more help, email qais@seosoft.dk directly!`,
          'ai'
        );
        return;
      }

      this.isTyping = true;
      if (this.sendButton) {
        this.sendButton.style.opacity = '0.5';
        this.sendButton.style.cursor = 'not-allowed';
        this.sendButton.style.pointerEvents = 'none';
      }

      this.addMessage(text, 'user');
      if (this.input) {
        this.input.value = '';
        this.input.style.height = '48px';
        this.input.style.overflowY = 'hidden';
      }

      this.messageCount++;

      // Show thinking indicator for 5-8 seconds (more realistic)
      this.showThinking();
      await new Promise(resolve => setTimeout(resolve, 5000 + Math.random() * 3000));
      this.hideThinking();
      
      this.showTyping();

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            messages: [
              ...this.messages,
              { role: 'user', content: text }
            ]
          })
        });

        if (!response.ok) {
          throw new Error(`HTTP error! status: ${response.status}`);
        }

        const data = await response.json();
        
        this.hideTyping();

        if (data.content && data.content[0]) {
          const aiMessage = data.content[0].text;
          this.addMessage(aiMessage, 'ai', true);
          
          this.messages.push(
            { role: 'user', content: text },
            { role: 'assistant', content: aiMessage }
          );

          this.logConversation(text, aiMessage);

          this.saveChatHistory();
        }
        else {
          throw new Error('Invalid response');
        }
      } catch (error) {
        console.error('Chat error:', error);
        this.hideTyping();
        this.addMessage(
          "Hmm, something's not working right now. Try emailing qais@seosoft.dk directly or check back in a few minutes.",
          'ai'
        );
      } finally {
        this.isTyping = false;
        if (this.sendButton) {
          this.sendButton.style.opacity = '1';
          this.sendButton.style.cursor = 'pointer';
          this.sendButton.style.pointerEvents = 'auto';
        }
      }
    }
  }

  declare global {
    interface Window {
      chatInitialized?: boolean;
    }
  }

  if (!window.chatInitialized) {
    window.chatInitialized = true;
    document.addEventListener('DOMContentLoaded', () => {
      const chat = new ChatInterface();
      chat.clearOldHistory();
    });
  }
</script>

