---

<section class="hero">
  <div class="hero__content">
    <h1 class="hero__title">
      Build reliable <span class="accent">APIs</span>, modern<br>
      <span class="accent">web apps</span> & <span class="accent">AI solutions</span>
    </h1>

    <p class="hero__subtitle">
      Senior .NET engineer helping European teams build scalable systems and integrate AI. 
      Clean architecture, predictable delivery.
    </p>

    <div class="flow-diagram-card">
      <div class="flow-diagram-header">
        <div class="flow-diagram-title">
          <div class="title-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
          </div>
          <span>Project Flow</span>
        </div>
        <span class="flow-diagram-badge">
          <span class="badge-dot"></span>
          END-TO-END PROCESS
        </span>
      </div>
      
      <div class="flow-diagram">
        <div class="flow-wrapper">
          {projectFlowSteps.map((step, index) => (
            <>
              <div class={`flow-step`} data-step={index + 1}>
                <div class="flow-step-node">
                  <div class="node-ring"></div>
                  <div class="node-inner">
                    <div class="flow-step-icon" set:html={step.icon} />
                  </div>
                  <div class="node-glow"></div>
                </div>
                <div class="flow-step-content">
                  <div class="flow-step-label">{step.label}</div>
                  <div class="flow-step-sublabel">{step.sublabel}</div>
                </div>
              </div>
              {index < projectFlowSteps.length - 1 && (
                <div class="flow-connector">
                  <div class="connector-track"></div>
                  <div class="connector-line"></div>
                  <div class="connector-particles">
                    <span class="particle"></span>
                    <span class="particle"></span>
                    <span class="particle"></span>
                  </div>
                </div>
              )}
            </>
          ))}
        </div>
      </div>
    </div>

    <div class="hero__cta">
      <a class="btn btn--primary btn--lg" href="#work">View Projects</a>
      <a class="btn btn--secondary btn--lg" href="#contact">Contact Me</a>
      <a class="btn btn--ghost btn--lg" href="#">Download CV</a>
    </div>

    <div class="contract-section">
      <div class="contract-header">
        <h3 class="contract-title">How I can help</h3>
        <p class="contract-subtitle">Choose the engagement model that fits your needs</p>
      </div>
      
      <div class="contract-grid">
        {contractTypes.map((contract) => (
          <div class="contract-card">
            <div class="contract-card-inner">
              <div class="contract-icon" set:html={contract.icon} />
              <div class="contract-content">
                <h4 class="contract-name">{contract.title}</h4>
                <span class="contract-duration">{contract.duration}</span>
                <p class="contract-description">{contract.description}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function animateFlowDiagram() {
    const steps = document.querySelectorAll('.flow-step');
    const connectors = document.querySelectorAll('.flow-connector');
    
    // First step appears immediately
    if (steps[0]) {
      setTimeout(() => {
        steps[0].classList.add('active');
      }, 100);
    }
    
    // Animate each connector AFTER the previous step is fully active
    connectors.forEach((connector, index) => {
      setTimeout(() => {
        // Wait for previous step to be fully visible before starting line
        setTimeout(() => {
          connector.classList.add('animating');
          
          // After line finishes drawing, mark as completed and show next step
          setTimeout(() => {
            connector.classList.remove('animating');
            connector.classList.add('completed');
            
            // Reveal next step
            if (steps[index + 1]) {
              steps[index + 1].classList.add('active');
            }
          }, 1000);
        }, 400); // Wait 400ms after step appears before starting line
      }, index * 1800);
    });
  }
  
  // Start animation
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(animateFlowDiagram, 400);
  });
</script>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 5rem 2rem 3rem;
  }

  .hero__content {
    max-width: 900px;
    width: 100%;
  }

  .hero__title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.035em;
    margin-bottom: 1.25rem;
    animation: fadeInUp 0.6s ease both;
  }

  .accent {
    color: var(--accent);
  }

  .hero__subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
    animation: fadeInUp 0.6s ease 0.1s both;
  }

  /* Flow Diagram Card */
  .flow-diagram-card {
    width: 100%;
    max-width: 100%;
    margin: 0 auto 2rem;
    background: linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.03) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
    border: 1px solid rgba(59, 130, 246, 0.15);
    border-radius: 20px;
    overflow: hidden;
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4),
                0 1px 2px rgba(59, 130, 246, 0.1),
                inset 0 1px 0 rgba(255, 255, 255, 0.1);
    animation: fadeInUp 0.6s ease 0.15s both;
    position: relative;
  }

  .flow-diagram-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(59, 130, 246, 0.5) 50%,
      transparent
    );
  }

  :global(.light) .flow-diagram-card {
    background: linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.08) 0%,
      rgba(255, 255, 255, 0.95) 100%
    );
    border: 1px solid rgba(59, 130, 246, 0.2);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1),
                0 2px 8px rgba(59, 130, 246, 0.05),
                inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  .flow-diagram-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.75rem;
    background: linear-gradient(
      180deg,
      rgba(59, 130, 246, 0.05) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
    border-bottom: 1px solid rgba(59, 130, 246, 0.1);
  }

  :global(.light) .flow-diagram-header {
    background: linear-gradient(
      180deg,
      rgba(59, 130, 246, 0.06) 0%,
      rgba(255, 255, 255, 0.4) 100%
    );
    border-bottom: 1px solid rgba(59, 130, 246, 0.15);
  }

  .flow-diagram-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .title-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(59, 130, 246, 0.05));
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 8px;
    color: var(--accent);
  }

  .flow-diagram-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 10px;
    padding: 5px 12px;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(59, 130, 246, 0.08));
    color: var(--accent);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 50px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.6);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { 
      opacity: 1;
      transform: scale(1);
    }
    50% { 
      opacity: 0.6;
      transform: scale(0.85);
    }
  }

  .flow-diagram {
    padding: 3.5rem 2rem 3rem;
    overflow: visible;
  }

  .flow-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: 100%;
  }

  /* Flow Steps */
  .flow-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    transform: translateY(30px) scale(0.9);
    transition: all 0.6s  (0.34, 1.56, 0.64, 1);
    flex-shrink: 0;
  }

  .flow-step.active {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .flow-step-node {
    width: 60px;
    height: 60px;
    position: relative;
    margin-bottom: 1rem;
  }

  .node-ring {
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 2px solid transparent;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.3), transparent) border-box;
    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .flow-step.active .node-ring {
    opacity: 1;
    animation: rotate 8s linear infinite;
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .node-inner {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.08) 0%,
      rgba(255, 255, 255, 0.03) 100%
    );
    border: 2px solid rgba(59, 130, 246, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    backdrop-filter: blur(10px);
  }

  :global(.light) .node-inner {
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(59, 130, 246, 0.05) 100%
    );
    border-color: rgba(59, 130, 246, 0.25);
  }

  .flow-step.active .node-inner {
    background: linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.2) 0%,
      rgba(59, 130, 246, 0.05) 100%
    );
    border-color: var(--accent);
    box-shadow: 0 0 0 5px rgba(59, 130, 246, 0.1),
                0 8px 24px rgba(59, 130, 246, 0.3),
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .node-glow {
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(59, 130, 246, 0.4) 0%,
      transparent 70%
    );
    opacity: 0;
    filter: blur(16px);
    transition: opacity 0.5s ease;
  }

  .flow-step.active .node-glow {
    opacity: 1;
    animation: glow-pulse 3s ease-in-out infinite;
  }

  @keyframes glow-pulse {
    0%, 100% { 
      opacity: 0.6;
      transform: scale(1);
    }
    50% { 
      opacity: 0.3;
      transform: scale(1.1);
    }
  }

  .flow-step-icon {
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    z-index: 1;
  }

  .flow-step.active .flow-step-icon {
    color: var(--accent);
    filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.6));
    transform: scale(1.1);
  }

  .flow-step-content {
    text-align: center;
  }

  .flow-step-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .flow-step-sublabel {
    font-size: 10px;
    color: var(--text-muted);
    white-space: nowrap;
    font-weight: 500;
  }

  /* Flow Connectors */
  .flow-connector {
    position: relative;
    width: 60px;
    height: 2px;
    flex-shrink: 0;
    align-self: flex-start;
    margin-top: 30px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .flow-connector.animating,
  .flow-connector.completed {
    opacity: 1;
  }

  .connector-track {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      rgba(59, 130, 246, 0.15) 0%,
      rgba(59, 130, 246, 0.05) 50%,
      rgba(59, 130, 246, 0.15) 100%
    );
    border-radius: 1px;
  }

  :global(.light) .connector-track {
    background: linear-gradient(
      90deg,
      rgba(59, 130, 246, 0.2) 0%,
      rgba(59, 130, 246, 0.1) 50%,
      rgba(59, 130, 246, 0.2) 100%
    );
  }

  .connector-line {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: linear-gradient(
      90deg,
      var(--accent),
      rgba(59, 130, 246, 0.8)
    );
    border-radius: 1px;
    box-shadow: 0 0 10px rgba(59, 130, 246, 0.6),
                0 0 20px rgba(59, 130, 246, 0.3);
  }

  .flow-connector.animating .connector-line {
    animation: drawLine 1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .flow-connector.completed .connector-line {
    width: 100%;
  }

  @keyframes drawLine {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }

  .connector-particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    opacity: 0;
  }

  .flow-connector.animating .connector-particles {
    opacity: 1;
  }

  .particle {
    position: absolute;
    top: 50%;
    width: 3px;
    height: 3px;
    background: #fff;
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(59, 130, 246, 0.8);
    transform: translate(-50%, -50%);
  }

  .flow-connector.animating .particle:nth-child(1) {
    animation: moveParticle 1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .flow-connector.animating .particle:nth-child(2) {
    animation: moveParticle 1s cubic-bezier(0.4, 0, 0.2, 1) 0.15s forwards;
  }

  .flow-connector.animating .particle:nth-child(3) {
    animation: moveParticle 1s cubic-bezier(0.4, 0, 0.2, 1) 0.3s forwards;
  }

  @keyframes moveParticle {
    0% {
      left: 0%;
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  /* CTA Buttons */
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 3rem;
    animation: fadeInUp 0.6s ease 0.2s both;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Inter', sans-serif;
    border-radius: 8px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    white-space: nowrap;
  }

  .btn--primary {
    background: rgba(59, 130, 246, 0.15);
    color: var(--accent);
    border-color: rgba(59, 130, 246, 0.25);
  }

  .btn--primary:hover {
    background: rgba(59, 130, 246, 0.25);
    border-color: rgba(59, 130, 246, 0.4);
  }

  :global(.light) .btn--primary {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.3);
  }

  :global(.light) .btn--primary:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.5);
  }

  .btn--secondary {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    border-color: rgba(255, 255, 255, 0.06);
  }

  .btn--secondary:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
    color: var(--text-primary);
  }

  :global(.light) .btn--secondary {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(0, 0, 0, 0.1);
  }

  :global(.light) .btn--secondary:hover {
    background: rgba(0, 0, 0, 0.08);
    border-color: rgba(0, 0, 0, 0.15);
  }

  .btn--ghost {
