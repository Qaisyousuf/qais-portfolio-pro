---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

const team = [
  {
    name: "Qais Yousuf",
    role: "Senior .NET Engineer",
    company: "TaskSync AI",
    location: "France",
    flag: "🇫🇷",
    image: "https://i.ibb.co/C57tPq1W/Whats-App-Image-2026-01-16-at-1-38-55-PM.jpg",
    bio: "8+ years building scalable .NET systems and AI integrations for European clients.",
    tags: ["ASP.NET Core", "Angular", "Azure", "AI", "Clean Architecture"],
    website: "https://tasksync.ai/",
    problemsData: {
      labels: ['API Development', 'Web Apps', 'AI Integration', 'Cloud Solutions', 'Mobile Apps'],
      values: [30, 25, 20, 15, 10]
    }
  },
  {
    name: "Søren Eggert",
    role: "Founder & CEO",
    company: "SeoSoft ApS",
    location: "Denmark",
    flag: "🇩🇰",
    image: "https://i.ibb.co/4F9Qrht/image.jpg",
    bio: "25+ years mastering Dynamics AX and .NET. Quality isn't what you say—it's what you deliver.",
    tags: ["Dynamics AX", ".NET Core", "SQL Server", "Performance", "Enterprise"],
    website: "https://seosoft.dk/",
    problemsData: {
      labels: ['Dynamics AX', 'Enterprise Apps', 'Database Optimization', 'Legacy Systems', 'Integration'],
      values: [35, 25, 20, 12, 8]
    }
  }
];
---

<section id="team" class="team">
  <div class="team__container">
    <!-- Header -->
    <div class="team__header">
      <div class="header-line"></div>
      <h2 class="team__title">The Team</h2>
      <p class="team__subtitle">30+ years building enterprise solutions</p>
    </div>

    <!-- Team Grid -->
    <div class="team__grid">
      {team.map((member, idx) => (
        <article class="member" data-index={idx}>
          <!-- Header: Image + Name side by side -->
          <div class="member__header">
            <!-- Image Column -->
            <div class="member__visual">
              <div class="image-wrapper">
                <img src={member.image} alt={member.name} class="member-image" />
                <div class="image-border"></div>
                <div class="image-glow"></div>
              </div>
              <div class="visual-flag">{member.flag}</div>
              <div class="status-indicator">
                <span class="status-dot"></span>
                <span class="status-text">Available Now</span>
              </div>
            </div>

            <!-- Name Section -->
            <div class="name-section">
              <h3 class="member-name">{member.name}</h3>
              <div class="role-badge">{member.role}</div>
            </div>
          </div>

          <!-- Content Section -->
          <div class="member__content">

            <!-- Chart Section -->
            <div class="chart-section">
              <h4 class="chart-title">Problems We Solve</h4>
              <div class="chart-wrapper">
                <canvas 
                  id={`chart-${idx}`} 
                  class="member-chart"
                  data-labels={JSON.stringify(member.problemsData.labels)}
                  data-values={JSON.stringify(member.problemsData.values)}
                  data-index={idx}
                ></canvas>
              </div>
            </div>

            <!-- Company -->
            <div class="company-line">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
              </svg>
              <span>{member.company}</span>
            </div>

            <!-- Bio -->
            <p class="member-bio">{member.bio}</p>

            <!-- Tech Stack -->
            <div class="tech-stack">
              {member.tags.map((tag, i) => (
                <span class="tech-tag" style={`animation-delay: ${i * 0.1}s`}>{tag}</span>
              ))}
            </div>

            <!-- Action -->
            <a href={member.website} class="profile-link" target="_blank" rel="noopener noreferrer">
              <span class="link-bg"></span>
              <span class="link-text">Visit Site</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script is:inline>
  function initCharts() {
    // @ts-ignore
    if (typeof Chart === 'undefined') {
      setTimeout(initCharts, 100);
      return;
    }

    const isDark = !document.documentElement.classList.contains('light');

    document.querySelectorAll('.member-chart').forEach((canvas) => {
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const labels = JSON.parse(canvas.dataset.labels || '[]');
      const values = JSON.parse(canvas.dataset.values || '[]');
      const idx = parseInt(canvas.dataset.index || '0');

      // Color schemes for each member
      const colorSchemes = [
        {
          // Qais - Blue shades
          colors: isDark ? [
            'rgba(59, 130, 246, 0.9)',
            'rgba(96, 165, 250, 0.9)',
            'rgba(147, 197, 253, 0.9)',
            'rgba(191, 219, 254, 0.9)',
            'rgba(219, 234, 254, 0.9)'
          ] : [
            'rgba(37, 99, 235, 1)',
            'rgba(59, 130, 246, 1)',
            'rgba(96, 165, 250, 1)',
            'rgba(147, 197, 253, 1)',
            'rgba(191, 219, 254, 1)'
          ]
        },
        {
          // Søren - Purple shades
          colors: isDark ? [
            'rgba(139, 92, 246, 0.9)',
            'rgba(167, 139, 250, 0.9)',
            'rgba(196, 181, 253, 0.9)',
            'rgba(221, 214, 254, 0.9)',
            'rgba(237, 233, 254, 0.9)'
          ] : [
            'rgba(124, 58, 237, 1)',
            'rgba(139, 92, 246, 1)',
            'rgba(167, 139, 250, 1)',
            'rgba(196, 181, 253, 1)',
            'rgba(221, 214, 254, 1)'
          ]
        }
      ];

      const scheme = colorSchemes[idx] || colorSchemes[0];

      // @ts-ignore
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: labels,
          datasets: [{
            data: values,
            backgroundColor: scheme.colors,
            borderColor: isDark ? '#000' : '#fff',
            borderWidth: 2,
            hoverOffset: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          plugins: {
            legend: {
              display: true,
              position: 'right',
              labels: {
                color: isDark ? 'rgba(255, 255, 255, 0.8)' : 'rgba(0, 0, 0, 0.8)',
                font: { size: 11, weight: '600' },
                padding: 10,
                usePointStyle: true,
                pointStyle: 'circle'
              }
            },
            tooltip: {
              enabled: true,
              backgroundColor: isDark ? 'rgba(0, 0, 0, 0.9)' : 'rgba(255, 255, 255, 0.95)',
              titleColor: isDark ? '#fff' : '#000',
              bodyColor: isDark ? '#fff' : '#000',
              borderColor: scheme.colors[0],
              borderWidth: 2,
              padding: 10,
              titleFont: { size: 12, weight: 'bold' },
              bodyFont: { size: 11 },
              callbacks: {
                label: function(context) {
                  return context.label + ': ' + context.parsed + '%';
                }
              }
            }
          },
          animation: {
            animateRotate: true,
            animateScale: true,
            duration: 1500,
            easing: 'easeInOutQuart'
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCharts);
  } else {
    initCharts();
  }

  const themeObserver = new MutationObserver(() => {
    // @ts-ignore
    if (typeof Chart !== 'undefined' && Chart.instances) {
      // @ts-ignore
      Object.values(Chart.instances).forEach((instance) => {
        instance.destroy();
      });
      initCharts();
    }
  });
  themeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  });
</script>

<script>
  const members = document.querySelectorAll('.member');

  const intersectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1 }
  );

  members.forEach((member) => intersectionObserver.observe(member));
</script>

<style>
  .team {
    padding: 8rem 2rem;
    background: #000000;
    position: relative;
    overflow: hidden;
  }

  .team__container {
    max-width: 1400px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .team__header {
    margin-bottom: 5rem;
    position: relative;
  }

  .header-line {
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, #3b82f6, transparent);
    margin-bottom: 1.5rem;
  }

  .team__title {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    margin-bottom: 0.5rem;
    color: #ffffff;
    line-height: 1;
  }

  .team__subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 300;
    letter-spacing: 0.05em;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4rem;
  }

  .member {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .member.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Top section - image and name side by side */
  .member__header {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  /* Qais - image on left */
  .member:nth-child(1) .member__header {
    flex-direction: row;
  }

  /* Søren - image on right */
  .member:nth-child(2) .member__header {
    flex-direction: row-reverse;
  }

  .member__visual {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
    position: relative;
    flex-shrink: 0;
  }

  /* Remove specific alignment for desktop */
  .member:nth-child(1) .member__visual,
  .member:nth-child(2) .member__visual {
    align-items: center;
  }

  .image-wrapper {
    position: relative;
    width: 100px;
    height: 100px;
  }

  .member-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    filter: grayscale(40%) contrast(1.1);
    transition: all 0.6s ease;
    position: relative;
    z-index: 2;
  }

  .member:hover .member-image {
    filter: grayscale(0%) contrast(1);
    transform: scale(1.05);
  }

  .image-border {
    position: absolute;
    inset: -4px;
    border: 2px solid #3b82f6;
    border-radius: 8px;
    opacity: 0;
    transition: all 0.6s ease;
    z-index: 1;
  }

  .member:hover .image-border {
    opacity: 1;
    inset: -6px;
  }

  .image-glow {
    position: absolute;
    inset: -20px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.3) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.6s ease;
    z-index: 0;
    filter: blur(20px);
  }

  .member:hover .image-glow {
    opacity: 1;
  }

  .visual-flag {
    font-size: 3rem;
    line-height: 1;
    filter: drop-shadow(0 4px 12px rgba(59, 130, 246, 0.3));
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 11px;
    color: #10b981;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    background: #10b981;
    border-radius: 50%;
    animation: statusPulse 2s ease-in-out infinite;
    box-shadow: 0 0 12px rgba(16, 185, 129, 0.8);
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.2); }
  }

  .member__content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
  }

  .name-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .member-name {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #ffffff;
    margin: 0;
    line-height: 1.1;
  }

  .role-badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(59, 130, 246, 0.05));
    border-left: 3px solid #3b82f6;
    color: #3b82f6;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Chart Section */
  .chart-section {
    width: 100%;
  }

  .chart-title {
    font-size: 14px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 1rem 0;
    letter-spacing: 0.02em;
  }

  :global(.light) .chart-title {
    color: rgba(0, 0, 0, 0.9);
  }

  .chart-wrapper {
    width: 100%;
    max-width: 300px;
    
    margin: 0 auto;
    padding: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .chart-wrapper:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(59, 130, 246, 0.3);
  }

  :global(.light) .chart-wrapper {
    background: rgba(0, 0, 0, 0.02);
    border-color: rgba(0, 0, 0, 0.1);
  }

  :global(.light) .chart-wrapper:hover {
    background: rgba(0, 0, 0, 0.04);
    border-color: rgba(59, 130, 246, 0.4);
  }

  .member-chart {
    width: 100% !important;
    height: 140px !important;
    max-height: 140px !important;
  }

  .company-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
  }

  .company-line svg {
    opacity: 0.7;
  }

  .member-bio {
    font-size: 15px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    max-width: 600px;
    text-align: center;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .tech-tag {
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    font-weight: 600;
    border-radius: 4px;
    transition: all 0.3s ease;
    opacity: 0;
    transform: translateY(10px);
    animation: fadeInUp 0.6s ease forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tech-tag:hover {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.3);
    color: #3b82f6;
    transform: translateY(-2px);
  }

  .profile-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.75rem;
    position: relative;
    color: #3b82f6;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    overflow: hidden;
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-radius: 6px;
    transition: all 0.4s ease;
  }

  .link-bg {
    position: absolute;
    inset: 0;
    background: rgba(59, 130, 246, 0.1);
    transform: translateX(-100%);
    transition: transform 0.4s ease;
  }

  .profile-link:hover .link-bg {
    transform: translateX(0);
  }

  .link-text {
    position: relative;
    z-index: 1;
  }

  .profile-link svg {
    position: relative;
    z-index: 1;
    transition: transform 0.4s ease;
  }

  .profile-link:hover svg {
    transform: translate(2px, -2px);
  }

  .profile-link:hover {
    border-color: #3b82f6;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
  }

  :global(.light) .team {
    background: #f8fafc;
  }

  :global(.light) .team__title {
    color: #000000;
  }

  :global(.light) .team__subtitle {
    color: rgba(0, 0, 0, 0.5);
  }

  :global(.light) .member-name {
    color: #000000;
  }

  :global(.light) .company-line {
    color: rgba(0, 0, 0, 0.6);
  }

  :global(.light) .member-bio {
    color: rgba(0, 0, 0, 0.7);
  }

  :global(.light) .tech-tag {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.1);
    color: rgba(0, 0, 0, 0.9);
  }

  :global(.light) .tech-tag:hover {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.3);
    color: #3b82f6;
  }

  @media (max-width: 1024px) {
    .team__grid {
      grid-template-columns: 1fr;
      gap: 5rem;
    }

    .member {
      gap: 2.5rem;
    }

    /* Center header on tablet */
    .member__header {
      justify-content: center;
    }

    .member:nth-child(1) .member__header,
    .member:nth-child(2) .member__header {
      flex-direction: row;
    }

    .image-wrapper {
      width: 90px;
      height: 90px;
    }

    .visual-flag {
      font-size: 2.5rem;
    }

    .member-name {
      font-size: 2rem;
    }

    .chart-wrapper {
      max-width: 280px;
      height: 180px;
    }

    .member-chart {
      height: 120px !important;
      max-height: 120px !important;
    }
  }

  @media (max-width: 640px) {
    .team {
      padding: 4rem 1rem;
    }

    .team__grid {
      gap: 4rem;
    }

    .member {
      gap: 2rem;
    }

    /* Stack image above name on mobile */
    .member__header {
      flex-direction: column !important;
      align-items: center;
      gap: 1rem;
    }

    .image-wrapper {
      width: 80px;
      height: 80px;
    }

    .visual-flag {
      font-size: 2rem;
    }

    .member-name {
      font-size: 1.75rem;
      text-align: center;
    }

    .name-section {
      align-items: center;
      text-align: center;
    }

    .chart-wrapper {
      padding: 1rem;
      
      width: 100%;
      height: 117px;
    }

    .chart-title {
      font-size: 12px;
      text-align: center;
    }

    .member-chart {
      height: 110px !important;
      max-height: 110px !important;
    }

    .profile-link {
      padding: 0.75rem 1.5rem;
      font-size: 12px;
     
      justify-content: center;
    }

    .tech-stack {
      justify-content: center;
    }

    .member-bio {
      text-align: center;
    }

    .company-line {
      justify-content: center;
    }
  }
</style>