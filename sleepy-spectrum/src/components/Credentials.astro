---
import GlassCard from './GlassCard.astro';

const credentials = [
  {
    flag: "🇫🇷",
    title: "TaskSync AI",
    subtitle: "France • Auto-entrepreneur",
    details: [
      { label: "SIRET", value: "99194243400010" },
      { label: "Services", value: "AI Integration, Consulting" },
      { label: "Status", value: "Active" },
    ],
  },
  {
    flag: "🇩🇰",
    title: "SeoSoft ApS",
    subtitle: "Denmark • Official Partner",
    details: [
      { label: "Role", value: "Senior Developer" },
      { label: "Services", value: "Enterprise Solutions" },
      { label: "Market", value: "Danish Business Sector" },
    ],
  },
];

const stats = [
  { value: "8+", label: "Years Experience" },
  { value: "50+", label: "Projects Delivered" },
  { value: "5", label: "Languages" },
  { value: "100%", label: "Remote Ready" },
];
---

<section class="section" id="credentials">
  <div class="container">
    <div class="section__header">
      <span class="section__label">Professional Credentials</span>
      <h2 class="section__title">Established European Presence</h2>
      <p class="section__desc">Dual business registrations for seamless contracting across EU markets.</p>
    </div>

    <div class="credentials-grid">
      {credentials.map(cred => (
        <GlassCard class="credential-card">
          <span class="credential-card__badge">
            <svg width="10" height="10" viewBox="0 0 16 16" fill="currentColor">
              <path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/>
            </svg>
            Verified
          </span>
          <div class="credential-card__header">
            <span class="credential-card__flag">{cred.flag}</span>
            <div>
              <div class="credential-card__title">{cred.title}</div>
              <div class="credential-card__subtitle">{cred.subtitle}</div>
            </div>
          </div>
          <div class="credential-details">
            {cred.details.map(detail => (
              <div class="credential-row">
                <span class="credential-row__label">{detail.label}</span>
                <span class="credential-row__value">{detail.value}</span>
              </div>
            ))}
          </div>
        </GlassCard>
      ))}
    </div>

    <div class="stats-grid">
      {stats.map(stat => (
        <GlassCard class="stat-card">
          <div class="stat-card__value">{stat.value}</div>
          <div class="stat-card__label">{stat.label}</div>
        </GlassCard>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 6rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  :global(.light) .section {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section__label {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 1rem;
    padding: 0.375rem 1rem;
    background: var(--accent-subtle);
    border-radius: 50px;
  }

  .section__title {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 0.875rem;
  }

  .section__desc {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 540px;
    margin: 0 auto;
  }

  .credentials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .credential-card {
    position: relative;
  }

  .credential-card__badge {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 10px;
    font-weight: 600;
    color: var(--success);
    background: var(--success-subtle);
    padding: 0.375rem 0.625rem;
    border-radius: 50px;
    border: 1px solid var(--success-border);
  }

  .credential-card__header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .credential-card__flag {
    font-size: 38px;
    line-height: 1;
  }

  .credential-card__title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .credential-card__subtitle {
    font-size: 12px;
    color: var(--text-muted);
  }

  .credential-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  :global(.light) .credential-details {
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .credential-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .credential-row__label {
    font-size: 12px;
    color: var(--text-muted);
  }

  .credential-row__value {
    font-size: 12px;
    font-weight: 500;
    font-family: 'JetBrains Mono', monospace;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .stat-card {
    text-align: center;
    padding: 1.5rem 1rem;
  }

  .stat-card__value {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-card__label {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 1rem;
    }

    .section {
      padding: 4rem 0;
    }

    .credentials-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>