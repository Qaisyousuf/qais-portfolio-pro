---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

import enTranslations from '../translations/en.json';
import daTranslations from '../translations/da.json';
import frTranslations from '../translations/fr.json';
import svTranslations from '../translations/sv.json';
import nlTranslations from '../translations/nl.json';

const translations = {
  en: enTranslations,
  da: daTranslations,
  fr: frTranslations,
  sv: svTranslations,
  nl: nlTranslations
}[lang] || enTranslations;

const t = translations.credentials;

const projectCards = [
  { 
    name: t.projects.cards.aiMentalHealth.name, 
    tag: t.projects.cards.aiMentalHealth.tag, 
    desc: t.projects.cards.aiMentalHealth.desc, 
    category: "ai" 
  },
  { 
    name: t.projects.cards.ortoDOC.name, 
    tag: t.projects.cards.ortoDOC.tag, 
    desc: t.projects.cards.ortoDOC.desc, 
    category: "workflow" 
  },
  { 
    name: t.projects.cards.aSurvey.name, 
    tag: t.projects.cards.aSurvey.tag, 
    desc: t.projects.cards.aSurvey.desc, 
    category: "analytics" 
  },
  { 
    name: t.projects.cards.smsReminder.name, 
    tag: t.projects.cards.smsReminder.tag, 
    desc: t.projects.cards.smsReminder.desc, 
    category: "automation" 
  },
  { 
    name: t.projects.cards.aiModels.name, 
    tag: t.projects.cards.aiModels.tag, 
    desc: t.projects.cards.aiModels.desc, 
    category: "ai" 
  },
  { 
    name: t.projects.cards.cyberLearn.name, 
    tag: t.projects.cards.cyberLearn.tag, 
    desc: t.projects.cards.cyberLearn.desc, 
    category: "education" 
  },
  { 
    name: t.projects.cards.batchVision.name, 
    tag: t.projects.cards.batchVision.tag, 
    desc: t.projects.cards.batchVision.desc, 
    category: "automation" 
  },
  { 
    name: t.projects.cards.taskSyncAI.name, 
    tag: t.projects.cards.taskSyncAI.tag, 
    desc: t.projects.cards.taskSyncAI.desc, 
    category: "ai" 
  },
];
---

<section class="credentials-section">
  <div class="credentials-container">
    <div class="badge-wrapper">
      <span class="section-badge">{t.badge}</span>
    </div>

    <div class="section-header">
      <h2 class="section-title">{t.title}</h2>
      <p class="section-subtitle">{t.subtitle}</p>
    </div>

    <div class="cards-grid">
      <!-- TaskSync AI Card -->
      <article class="company-card tasksync-card">
        <div class="card-glow tasksync-glow"></div>

        <div class="card-header">
          <div class="company-info">
            <div class="flag-container">
              <div class="flag france-flag">
                <div class="france-blue"></div>
                <div class="france-white"></div>
                <div class="france-red"></div>
              </div>
            </div>
            <div class="company-details">
              <h3 class="company-name">TaskSync AI</h3>
              <p class="company-country">{t.taskSync.country}</p>
            </div>
          </div>
          <span class="verified-badge">
            <span class="verified-dot"></span>
            {t.verified}
          </span>
        </div>

        <p class="card-description">{t.taskSync.description}</p>

        <div class="card-content">
          <div class="info-box">
            <div class="info-label">{t.taskSync.siret}</div>
            <div class="info-value">99194243400010</div>
          </div>

          <div class="info-box">
            <div class="info-label">{t.taskSync.focusAreas}</div>
            <div class="metrics-grid">
              <div class="metric-badge blue">
                <svg class="metric-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <span>{t.taskSync.aiHealth}</span>
              </div>
              <div class="metric-badge purple">
                <svg class="metric-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                <span>{t.taskSync.automation}</span>
              </div>
              <div class="metric-badge emerald">
                <svg class="metric-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
                <span>{t.taskSync.analytics}</span>
              </div>
              <div class="metric-badge amber">
                <svg class="metric-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                </svg>
                <span>{t.taskSync.workflows}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="card-footer">
          <a href="https://tasksync.ai/" target="_blank" rel="noopener noreferrer" class="card-link blue-link">
            <span>{t.taskSync.visitWebsite}</span>
            <svg class="link-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
        </div>
      </article>

      <!-- Center Connector -->
      <div class="connector">
        <div class="connector-wrapper">
          <div class="connector-line"></div>
          <div class="connector-dots">
            <div class="dot dot-blue dot-1 animate-flow-right"></div>
            <div class="dot dot-blue dot-2 animate-flow-right"></div>
            <div class="dot dot-emerald dot-3 animate-flow-left"></div>
            <div class="dot dot-emerald dot-4 animate-flow-left"></div>
          </div>
          <div class="connector-badge">
            <span>{t.partnership}</span>
          </div>
        </div>
      </div>

      <!-- SeoSoft ApS Card -->
      <article class="company-card seosoft-card">
        <div class="card-glow seosoft-glow"></div>

        <div class="card-header">
          <div class="company-info">
            <div class="flag-container">
              <div class="flag denmark-flag">
                <div class="denmark-cross-h"></div>
                <div class="denmark-cross-v"></div>
              </div>
            </div>
            <div class="company-details">
              <h3 class="company-name">SeoSoft ApS</h3>
              <p class="company-country">{t.seoSoft.country}</p>
            </div>
          </div>
          <span class="verified-badge">
            <span class="verified-dot"></span>
            {t.verified}
          </span>
        </div>

        <p class="card-description">{t.seoSoft.description}</p>

        <div class="card-content">
          <div class="info-box">
            <div class="info-label">{t.seoSoft.role}</div>
            <div class="info-value">{t.seoSoft.roleValue}</div>
          </div>

          <div class="info-box">
            <div class="info-label">{t.seoSoft.expertise}</div>
            <div class="metrics-grid">
              <div class="metric-badge cyan">
                <svg class="metric-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
                <span>{t.seoSoft.enterprise}</span>
              </div>
              <div class="metric-badge violet">
                <svg class="metric-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span>{t.seoSoft.security}</span>
              </div>
              <div class="metric-badge rose">
                <svg class="metric-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
                </svg>
                <span>{t.seoSoft.databases}</span>
              </div>
              <div class="metric-badge teal">
                <svg class="metric-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span>{t.seoSoft.devops}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="card-footer">
          <a href="https://seosoft.dk/" target="_blank" rel="noopener noreferrer" class="card-link emerald-link">
            <span>{t.seoSoft.visitWebsite}</span>
            <svg class="link-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
        </div>
      </article>
    </div>

    <!-- Projects Section -->
    <div class="projects-section">
      <div class="projects-header">
        <div class="projects-header-content">
          <div class="projects-badge">
            <span class="projects-badge-dot"></span>
            {t.projects.badge}
          </div>
          <h4 class="projects-title">{t.projects.title}</h4>
          <p class="projects-subtitle">{t.projects.subtitle}</p>
        </div>
      </div>

      <div class="filter-buttons">
        <button class="filter-btn active" data-filter="all">
          <svg class="filter-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          {t.projects.filters.all}
        </button>
        <button class="filter-btn" data-filter="ai">
          <svg class="filter-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          {t.projects.filters.ai}
        </button>
        <button class="filter-btn" data-filter="workflow">
          <svg class="filter-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
          </svg>
          {t.projects.filters.workflow}
        </button>
        <button class="filter-btn" data-filter="analytics">
          <svg class="filter-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          {t.projects.filters.analytics}
        </button>
        <button class="filter-btn" data-filter="automation">
          <svg class="filter-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          {t.projects.filters.automation}
        </button>
        <button class="filter-btn" data-filter="education">
          <svg class="filter-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
          {t.projects.filters.education}
        </button>
      </div>

      <div id="projects-grid" class="projects-grid">
        {projectCards.map((p) => (
          <article class="project-card" data-category={p.category}>
            <div class="project-card-header">
              <div class="project-info">
                <h5 class="project-name">{p.name}</h5>
                <p class="project-tag">{p.tag}</p>
              </div>
              <span class="project-status">
                <span class="project-status-dot"></span>
                <span class="project-status-text">{t.projects.active}</span>
              </span>
            </div>
            <p class="project-description">{p.desc}</p>
            <div class="project-divider"></div>
            <div class="project-footer">
              <span>{t.projects.sharedBuild}</span>
              <span class="project-view">{t.projects.view} →</span>
            </div>
          </article>
        ))}
      </div>

      <p class="projects-footer-text">{t.projects.footer}</p>
    </div>
  </div>
</section>

<style>
  /* ==================== */
  /* Base Section Styles  */
  /* ==================== */
  .credentials-section {
    position: relative;
    overflow: hidden;
    margin-top: 1.5rem;
    padding: 4rem 2rem;
  }

  .credentials-container {
    margin: 0 auto;
    max-width: 80rem;
  }

  /* ==================== */
  /* Section Header       */
  /* ==================== */
  .badge-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .section-badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(59, 130, 246, 0.2);
    background: rgba(59, 130, 246, 0.1);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgb(96, 165, 250);
  }

  .section-header {
    text-align: center;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .section-title {
      font-size: 3.75rem;
    }
  }

  .section-subtitle {
    margin: 1.25rem auto 0;
    max-width: 48rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* ==================== */
  /* Cards Grid Layout    */
  /* ==================== */
  .cards-grid {
    position: relative;
    display: grid;
    align-items: stretch;
    gap: 13rem;
    margin-top: 4rem;
  }

  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  /* ==================== */
  /* Company Card Base    */
  /* ==================== */
  .company-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.02);
    padding: 1.75rem;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04);
    
    transition: all 0.3s ease;
  }

  .company-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
    transform: translateY(-8px);
  }

  .tasksync-card:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(59, 130, 246, 0.15);
  }

  .seosoft-card:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4), 0 0 20px rgba(16, 185, 129, 0.15);
  }

  /* Card Glow Effect */
  .card-glow {
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .company-card:hover .card-glow {
    opacity: 1;
  }

  .tasksync-glow {
    background: radial-gradient(600px circle at 20% 10%, rgba(59, 130, 246, 0.18), transparent 45%);
  }

  .seosoft-glow {
    background: radial-gradient(600px circle at 80% 10%, rgba(16, 185, 129, 0.18), transparent 45%);
  }

  /* ==================== */
  /* Card Header          */
  /* ==================== */
  .card-header {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .company-info {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .flag-container {
    display: flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.3);
  }

  .flag {
    width: 2.25rem;
    height: 1.5rem;
    overflow: hidden;
    border-radius: 0.125rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* France Flag */
  .france-flag {
    display: flex;
    height: 100%;
    width: 100%;
  }

  .france-blue {
    height: 100%;
    width: 33.33%;
    background: rgb(37, 99, 235);
  }

  .france-white {
    height: 100%;
    width: 33.33%;
    background: white;
  }

  .france-red {
    height: 100%;
    width: 33.33%;
    background: rgb(220, 38, 38);
  }

  /* Denmark Flag */
  .denmark-flag {
    position: relative;
    height: 100%;
    width: 100%;
    background: rgb(220, 38, 38);
  }

  .denmark-cross-v {
    position: absolute;
    left: 34%;
    top: 0;
    height: 100%;
    width: 14%;
    background: white;
  }

  .denmark-cross-h {
    position: absolute;
    left: 0;
    top: 44%;
    height: 16%;
    width: 100%;
    background: white;
  }

  .company-details {
    display: flex;
    flex-direction: column;
  }

  .company-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .company-country {
    margin-top: 0.25rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Verified Badge */
  .verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid rgba(16, 185, 129, 0.2);
    background: rgba(16, 185, 129, 0.1);
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(110, 231, 183);
  }

  .verified-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: rgb(52, 211, 153);
  }

  /* ==================== */
  /* Card Description     */
  /* ==================== */
  .card-description {
    position: relative;
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
  }

  /* ==================== */
  /* Card Content         */
  /* ==================== */
  .card-content {
    position: relative;
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
  }

  .info-box {
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.2);
    padding: 1rem;
  }

  .info-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.4);
  }

  .info-value {
    margin-top: 0.25rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* ==================== */
  /* Metrics Grid         */
  /* ==================== */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .metric-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem;
    border-radius: 0.5rem;
    border: 1px solid;
  }

  .metric-badge span {
    font-size: 0.75rem;
    font-weight: 600;
  }

  .metric-icon {
    width: 1rem;
    height: 1rem;
  }

  /* Metric Badge Colors */
  .metric-badge.blue {
    border-color: rgba(59, 130, 246, 0.2);
    background: rgba(59, 130, 246, 0.1);
    color: rgb(147, 197, 253);
  }

  .metric-badge.purple {
    border-color: rgba(168, 85, 247, 0.2);
    background: rgba(168, 85, 247, 0.1);
    color: rgb(216, 180, 254);
  }

  .metric-badge.emerald {
