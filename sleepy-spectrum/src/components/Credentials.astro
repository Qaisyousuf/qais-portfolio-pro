
---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;


import enTranslations from '../translations/en.json';
import daTranslations from '../translations/da.json';
import frTranslations from '../translations/fr.json';
import svTranslations from '../translations/sv.json';
import nlTranslations from '../translations/nl.json';

// Get the right translations based on lang prop
const translations = {
  en: enTranslations,
  da: daTranslations,
  fr: frTranslations,
  sv: svTranslations,
  nl: nlTranslations
}[lang] || enTranslations;

// Get credentials-specific translations
const t = translations.credentials;

const projectCards = [
  { 
    name: t.projects.cards.aiMentalHealth.name, 
    tag: t.projects.cards.aiMentalHealth.tag, 
    desc: t.projects.cards.aiMentalHealth.desc, 
    category: "ai" 
  },
  { 
    name: t.projects.cards.ortoDOC.name, 
    tag: t.projects.cards.ortoDOC.tag, 
    desc: t.projects.cards.ortoDOC.desc, 
    category: "workflow" 
  },
  { 
    name: t.projects.cards.aSurvey.name, 
    tag: t.projects.cards.aSurvey.tag, 
    desc: t.projects.cards.aSurvey.desc, 
    category: "analytics" 
  },
  { 
    name: t.projects.cards.smsReminder.name, 
    tag: t.projects.cards.smsReminder.tag, 
    desc: t.projects.cards.smsReminder.desc, 
    category: "automation" 
  },
  { 
    name: t.projects.cards.aiModels.name, 
    tag: t.projects.cards.aiModels.tag, 
    desc: t.projects.cards.aiModels.desc, 
    category: "ai" 
  },
  { 
    name: t.projects.cards.cyberLearn.name, 
    tag: t.projects.cards.cyberLearn.tag, 
    desc: t.projects.cards.cyberLearn.desc, 
    category: "education" 
  },
  { 
    name: t.projects.cards.batchVision.name, 
    tag: t.projects.cards.batchVision.tag, 
    desc: t.projects.cards.batchVision.desc, 
    category: "automation" 
  },
  { 
    name: t.projects.cards.taskSyncAI.name, 
    tag: t.projects.cards.taskSyncAI.tag, 
    desc: t.projects.cards.taskSyncAI.desc, 
    category: "ai" 
  },
];
---

<section class="credentials-section relative overflow-hidden mt-6">
  <!-- Top divider line -->
  

  <div class="mx-auto max-w-7xl">
    <div class="flex justify-center mb-10">
      <span class="inline-block px-4 py-1.5 rounded-full border border-blue-500/20 bg-blue-500/10 text-xs font-semibold tracking-wider text-blue-400 uppercase">
        {t.badge}
      </span>
    </div>

    <div class="text-center">
      <h2 class="text-4xl font-extrabold tracking-tight sm:text-6xl">
        {t.title}
      </h2>
      <p class="mx-auto mt-5 max-w-3xl text-white/70">
        {t.subtitle}
      </p>
    </div>

    <div class="relative mt-16 grid items-stretch gap-8 lg:grid-cols-3">
      <!-- TaskSync AI Card -->
      <article class="group relative isolate overflow-hidden rounded-2xl border border-white/10 bg-white/[0.02] p-7 shadow-[0_0_0_1px_rgba(255,255,255,0.04)] backdrop-blur transition-all duration-300 hover:border-white/20 hover:bg-white/[0.06] hover:-translate-y-2 hover:shadow-[0_12px_40px_rgba(0,0,0,0.4),0_0_20px_rgba(59,130,246,0.15)]">
        <div class="pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background: radial-gradient(600px circle at 20% 10%, rgba(59,130,246,0.18), transparent 45%);"></div>

        <div class="relative flex items-start justify-between gap-4">
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-white/10 bg-black/30">
              <div class="h-6 w-9 overflow-hidden rounded-sm border border-white/10">
                <div class="flex h-full w-full">
                  <div class="h-full w-1/3 bg-blue-600"></div>
                  <div class="h-full w-1/3 bg-white"></div>
                  <div class="h-full w-1/3 bg-red-600"></div>
                </div>
              </div>
            </div>
            <div>
              <h3 class="text-xl font-bold">TaskSync AI</h3>
              <p class="mt-1 text-sm text-white/50">{t.taskSync.country}</p>
            </div>
          </div>
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300">
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
            {t.verified}
          </span>
        </div>

        <p class="relative mt-5 text-sm text-white/70">
          {t.taskSync.description}
        </p>

        <div class="relative mt-6 grid gap-3 text-sm">
          <div class="rounded-xl border border-white/10 bg-black/20 p-4">
            <div class="text-xs uppercase tracking-wider text-white/40">{t.taskSync.siret}</div>
            <div class="mt-1 font-semibold">99194243400010</div>
          </div>

          <!-- COOL METRICS INSTEAD OF FEED -->
          <div class="rounded-xl border border-white/10 bg-black/20 p-4">
            <div class="text-xs uppercase tracking-wider text-white/40 mb-3">{t.taskSync.focusAreas}</div>
            <div class="grid grid-cols-2 gap-3">
              <div class="flex items-center gap-2 rounded-lg border border-blue-500/20 bg-blue-500/10 p-2">
                <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <span class="text-xs font-semibold text-blue-300">{t.taskSync.aiHealth}</span>
              </div>
              <div class="flex items-center gap-2 rounded-lg border border-purple-500/20 bg-purple-500/10 p-2">
                <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
                <span class="text-xs font-semibold text-purple-300">{t.taskSync.automation}</span>
              </div>
              <div class="flex items-center gap-2 rounded-lg border border-emerald-500/20 bg-emerald-500/10 p-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
                <span class="text-xs font-semibold text-emerald-300">{t.taskSync.analytics}</span>
              </div>
              <div class="flex items-center gap-2 rounded-lg border border-amber-500/20 bg-amber-500/10 p-2">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                </svg>
                <span class="text-xs font-semibold text-amber-300">{t.taskSync.workflows}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="relative mt-7">
          <a href="https://tasksync.ai/" target="_blank" rel="noopener noreferrer" class="group/link relative inline-flex items-center justify-center gap-2 rounded-lg border border-blue-500/20 bg-blue-500/10 px-4 py-2.5 text-sm font-semibold text-blue-400 transition-all hover:border-blue-500/30 hover:bg-blue-500/15 hover:scale-[1.02]">
            <span>{t.taskSync.visitWebsite}</span>
            <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
        </div>
      </article>

      <!-- Center Connector -->
      <div class="relative hidden lg:flex items-center justify-center">
        <div class="relative w-full">
          <div class="h-px w-full bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
          <div class="pointer-events-none absolute inset-0">
            <!-- Left dots flowing right -->
            <div class="absolute left-[10%] -top-1 h-2 w-2 rounded-full bg-blue-500/70 animate-flow-right"></div>
            <div class="absolute left-[20%] -top-1 h-2 w-2 rounded-full bg-blue-500/50 animate-flow-right" style="animation-delay: 0.3s;"></div>
            <!-- Right dots flowing left -->
            <div class="absolute right-[10%] -top-1 h-2 w-2 rounded-full bg-emerald-500/70 animate-flow-left"></div>
            <div class="absolute right-[20%] -top-1 h-2 w-2 rounded-full bg-emerald-500/50 animate-flow-left" style="animation-delay: 0.3s;"></div>
          </div>
          <div class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2">
            <span class="rounded-full border border-white/15 bg-black/80 px-4 py-2 text-xs font-semibold tracking-wider text-white/80 backdrop-blur-sm">
              {t.partnership}
            </span>
          </div>
        </div>
      </div>

      <!-- SeoSoft ApS Card -->
      <article class="group relative isolate overflow-hidden rounded-2xl border border-white/10 bg-white/[0.01] p-7 shadow-[0_0_0_1px_rgba(255,255,255,0.04)] backdrop-blur transition-all duration-300 hover:border-white/20 hover:bg-white/[0.06] hover:-translate-y-2 hover:shadow-[0_12px_40px_rgba(0,0,0,0.4),0_0_20px_rgba(16,185,129,0.15)]">
        <div class="pointer-events-none absolute inset-0 rounded-2xl opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background: radial-gradient(600px circle at 80% 10%, rgba(16,185,129,0.18), transparent 45%);"></div>

        <div class="relative flex items-start justify-between gap-4">
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-white/10 bg-black/30">
              <div class="relative h-6 w-9 overflow-hidden rounded-sm border border-white/10 bg-red-600">
                <div class="absolute left-[34%] top-0 h-full w-[14%] bg-white"></div>
                <div class="absolute left-0 top-[44%] h-[16%] w-full bg-white"></div>
              </div>
            </div>
            <div>
              <h3 class="text-xl font-bold">SeoSoft ApS</h3>
              <p class="mt-1 text-sm text-white/50">{t.seoSoft.country}</p>
            </div>
          </div>
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300">
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
            {t.verified}
          </span>
        </div>

        <p class="relative mt-5 text-sm text-white/70">
          {t.seoSoft.description}
        </p>

        <div class="relative mt-6 grid gap-3 text-sm">
          <div class="rounded-xl border border-white/10 bg-black/20 p-4">
            <div class="text-xs uppercase tracking-wider text-white/40">{t.seoSoft.role}</div>
            <div class="mt-1 font-semibold">{t.seoSoft.roleValue}</div>
          </div>

          <!-- COOL METRICS -->
          <div class="rounded-xl border border-white/10 bg-black/20 p-4">
            <div class="text-xs uppercase tracking-wider text-white/40 mb-3">{t.seoSoft.expertise}</div>
            <div class="grid grid-cols-2 gap-3">
              <div class="flex items-center gap-2 rounded-lg border border-cyan-500/20 bg-cyan-500/10 p-2">
                <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
                <span class="text-xs font-semibold text-cyan-300">{t.seoSoft.enterprise}</span>
              </div>
              <div class="flex items-center gap-2 rounded-lg border border-violet-500/20 bg-violet-500/10 p-2">
                <svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
                <span class="text-xs font-semibold text-violet-300">{t.seoSoft.security}</span>
              </div>
              <div class="flex items-center gap-2 rounded-lg border border-rose-500/20 bg-rose-500/10 p-2">
                <svg class="w-4 h-4 text-rose-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
                </svg>
                <span class="text-xs font-semibold text-rose-300">{t.seoSoft.databases}</span>
              </div>
              <div class="flex items-center gap-2 rounded-lg border border-teal-500/20 bg-teal-500/10 p-2">
                <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span class="text-xs font-semibold text-teal-300">{t.seoSoft.devops}</span>
              </div>
            </div>
          </div>
        </div>

        <div class="relative mt-7">
          <a href="https://seosoft.dk/" target="_blank" rel="noopener noreferrer" class="group/link relative inline-flex items-center justify-center gap-2 rounded-lg border border-emerald-500/20 bg-emerald-500/10 px-4 py-2.5 text-sm font-semibold text-emerald-400 transition-all hover:border-emerald-500/30 hover:bg-emerald-500/15 hover:scale-[1.02]">
            <span>{t.seoSoft.visitWebsite}</span>
            <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M7 17L17 7M17 7H7M17 7V17"/>
            </svg>
          </a>
        </div>
      </article>
    </div>

    <!-- Projects Section with Filter -->
    <div class="mt-14 rounded-2xl border border-white/10 bg-white/[0.01] p-8 backdrop-blur">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-black/30 px-4 py-2 text-xs font-semibold text-white/80">
            <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
            {t.projects.badge}
          </div>
          <h4 class="mt-4 text-2xl font-extrabold tracking-tight">
            {t.projects.title}
          </h4>
          <p class="mt-2 max-w-2xl text-sm text-white/70">
            {t.projects.subtitle}
          </p>
        </div>
      </div>

      <!-- FILTER BUTTONS WITH ICONS -->
      <div class="mt-6 flex flex-wrap gap-2">
        <button class="filter-btn active" data-filter="all">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
          {t.projects.filters.all}
        </button>
        <button class="filter-btn" data-filter="ai">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          {t.projects.filters.ai}
        </button>
        <button class="filter-btn" data-filter="workflow">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"/>
          </svg>
          {t.projects.filters.workflow}
        </button>
        <button class="filter-btn" data-filter="analytics">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          {t.projects.filters.analytics}
        </button>
        <button class="filter-btn" data-filter="automation">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          {t.projects.filters.automation}
        </button>
        <button class="filter-btn" data-filter="education">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
          {t.projects.filters.education}
        </button>
      </div>

      <div id="projects-grid" class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {projectCards.map((p) => (
          <article class="project-card group rounded-2xl border border-white/10 bg-black/25 p-5 backdrop-blur transition-all duration-300 hover:border-white/20 hover:bg-white/[0.06] hover:-translate-y-1 hover:shadow-[0_8px_24px_rgba(0,0,0,0.3)]" data-category={p.category}>
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0 flex-1">
                <h5 class="font-bold text-white/90 leading-tight">{p.name}</h5>
                <p class="mt-1 text-xs text-white/50">{p.tag}</p>
              </div>
              <span class="flex-shrink-0 inline-flex items-center gap-1.5 text-xs text-emerald-300">
                <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                <span class="hidden sm:inline">{t.projects.active}</span>
              </span>
            </div>
            <p class="mt-3 text-xs leading-relaxed text-white/70">{p.desc}</p>
            <div class="mt-4 h-px w-full bg-gradient-to-r from-transparent via-white/15 to-transparent"></div>
            <div class="mt-3 flex items-center justify-between text-xs text-white/50">
              <span>{t.projects.sharedBuild}</span>
              <span class="opacity-0 transition-opacity group-hover:opacity-100">{t.projects.view} →</span>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-8 text-center text-xs text-white/40">
        {t.projects.footer}
      </p>
    </div>
  </div>
  <style>
    .filter-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.625rem 1rem;
      border-radius: 0.75rem;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(255, 255, 255, 0.03);
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .filter-btn:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.15);
      color: rgba(255, 255, 255, 0.9);
    }

    .filter-btn.active {
      background: rgba(59, 130, 246, 0.15);
      border-color: rgba(59, 130, 246, 0.3);
      color: rgb(96, 165, 250);
    }

    .project-card {
      transition: all 0.3s ease;
    }

    .project-card.hidden {
      display: none;
    }

    .project-card h5 {
      font-size: 0.9375rem;
      line-height: 1.3;
    }

    /* Flowing dots animation */
    @keyframes flow-right {
      0% {
        transform: translateX(0);
        opacity: 0;
      }
      50% {
        opacity: 1;
      }
      100% {
        transform: translateX(200px);
        opacity: 0;
      }
    }

    @keyframes flow-left {
      0% {
        transform: translateX(0);
        opacity: 0;
      }
      50% {
        opacity: 1;
      }
      100% {
        transform: translateX(-200px);
        opacity: 0;
