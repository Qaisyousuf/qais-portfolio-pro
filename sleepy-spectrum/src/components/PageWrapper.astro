---
// PageWrapper.astro - Wraps content and shows it after loader
---

<div id="page-wrapper" class="page-wrapper">
  <slot />
</div>

<style>
  .page-wrapper {
    display: none;
    opacity: 0;
  }
  
  .page-wrapper.show {
    display: block;
    animation: revealContent 0.8s ease forwards;
  }
  
  @keyframes revealContent {
    to {
      opacity: 1;
    }
  }
</style>

<script>
  // Listen for loader completion
  window.addEventListener('loader-complete', () => {
    const wrapper = document.getElementById('page-wrapper');
    
    // Small delay then show content with animation
    setTimeout(() => {
      wrapper?.classList.add('show');
    }, 100);
  });
</script>