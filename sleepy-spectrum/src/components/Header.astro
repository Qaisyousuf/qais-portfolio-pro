---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

const navLinks = [
  { href: "#credentials", label: "Credentials" },
  { href: "#work", label: "Work" },
  { href: "#services", label: "Services" },
  { href: "#process", label: "Process" },
  { href: "#contact", label: "Contact" },
];

const languages = [
  { code: "en", flag: "🇬🇧", label: "English", href: "/" },
  { code: "da", flag: "🇩🇰", label: "Dansk", href: "/da/" },
  { code: "fr", flag: "🇫🇷", label: "Français", href: "/fr/" },
  { code: "sv", flag: "🇸🇪", label: "Svenska", href: "/sv/" },
  { code: "nl", flag: "🇳🇱", label: "Nederlands", href: "/nl/" },
];

const currentLang = languages.find(l => l.code === lang) || languages[0];
---

<header class="header">
  <div class="header__inner">
    <a class="logo" href="#top">
      <span class="logo__mark">Q</span>
      <span class="logo__text">
        <span class="logo__name">Qais Yousuf</span>
        <span class="logo__role">.NET Engineer</span>
      </span>
    </a>

    <nav class="nav">
      {navLinks.map(link => (
        <a href={link.href} class="nav__link">{link.label}</a>
      ))}
    </nav>

    <div class="header__actions">
      <div class="lang-dropdown">
        <button class="lang-btn" type="button">
          <span class="lang-btn__flag">{currentLang.flag}</span>
          <span>{currentLang.code.toUpperCase()}</span>
          <svg class="lang-btn__caret" viewBox="0 0 12 12" fill="currentColor">
            <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" fill="none"/>
          </svg>
        </button>
        <div class="lang-menu">
          {languages.map(language => (
            <a 
              href={language.href} 
              class={`lang-option ${language.code === lang ? 'lang-option--active' : ''}`}
            >
              <span class="lang-option__flag">{language.flag}</span>
              <span>{language.label}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="theme-toggle" onclick="toggleTheme()"></div>

      <button class="hamburger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0.875rem 2rem;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: all 0.25s ease;
  }

  :global(.light) .header {
    background: rgba(255, 255, 255, 0.8);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .header__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .logo__mark {
    width: 38px;
    height: 38px;
    background: linear-gradient(135deg, var(--accent), var(--accent-secondary));
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 18px;
    color: white;
    box-shadow: 0 4px 12px var(--accent-glow);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .logo__name {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.02em;
  }

  .logo__role {
    font-size: 11px;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav__link {
    padding: 0.5rem 1rem;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .nav__link:hover {
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.02);
  }

  :global(.light) .nav__link:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .lang-dropdown {
    position: relative;
  }

  .lang-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 8px;
    color: var(--text-secondary);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
    font-family: 'Inter', sans-serif;
  }

  .lang-btn:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.06);
    color: var(--text-primary);
  }

  :global(.light) .lang-btn {
    background: rgba(0, 0, 0, 0.03);
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  :global(.light) .lang-btn:hover {
    background: rgba(0, 0, 0, 0.06);
    border-color: rgba(0, 0, 0, 0.1);
  }

  .lang-btn__flag {
    font-size: 17px;
    line-height: 1;
  }

  .lang-btn__caret {
    width: 10px;
    height: 10px;
    opacity: 0.5;
    transition: transform 0.15s ease;
  }

  .lang-dropdown:hover .lang-btn__caret {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 160px;
    background: var(--bg-secondary);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
    padding: 6px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px) scale(0.96);
    transition: all 0.15s ease;
    z-index: 200;
  }

  :global(.light) .lang-menu {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
  }

  .lang-dropdown:hover .lang-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .lang-option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
  }

  .lang-option:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-primary);
  }

  :global(.light) .lang-option:hover {
    background: rgba(0, 0, 0, 0.04);
  }

  .lang-option--active {
    background: var(--accent-subtle);
    color: var(--accent);
  }

  .lang-option__flag {
    font-size: 18px;
  }

  .theme-toggle {
    width: 48px;
    height: 26px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 13px;
    position: relative;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  :global(.light) .theme-toggle {
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .theme-toggle::before {
    content: '🌙';
    position: absolute;
    left: 2px;
    top: 50%;
    transform: translateY(-50%);
    width: 20px;
    height: 20px;
    background: rgba(59, 130, 246, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    transition: all 0.25s ease;
  }

  :global(.light) .theme-toggle::before {
    content: '☀️';
    left: calc(100% - 22px);
    background: rgba(245, 158, 11, 0.25);
  }

  .hamburger {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
  }

  .hamburger span {
    width: 18px;
    height: 2px;
    background: var(--text-secondary);
    border-radius: 2px;
  }

  @media (max-width: 768px) {
    .header {
      padding: 0.75rem 1rem;
    }
    
    .nav {
      display: none;
    }
    
    .hamburger {
      display: flex;
    }
  }
</style>