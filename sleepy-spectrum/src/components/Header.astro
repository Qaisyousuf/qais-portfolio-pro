---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

// Import translations
import enTranslations from '../translations/en.json';
import daTranslations from '../translations/da.json';
import frTranslations from '../translations/fr.json';
import svTranslations from '../translations/sv.json';
import nlTranslations from '../translations/nl.json';

// Get the right translations based on lang prop
const translations = {
  en: enTranslations,
  da: daTranslations,
  fr: frTranslations,
  sv: svTranslations,
  nl: nlTranslations
}[lang] || enTranslations;

// Now use translations instead of hardcoded text
const navLinks = [
  { href: "#partner", label: translations.nav.partner },
  { href: "#work", label: translations.nav.work },
  { href: "#services", label: translations.nav.services },
  { href: "#process", label: translations.nav.process },
  { href: "#team", label: translations.nav.team },
];

const languages = [
  { code: "en", flag: "GB", label: "English", href: "/" },
  { code: "da", flag: "DK", label: "Dansk", href: "/da/" },
  { code: "fr", flag: "FR", label: "Français", href: "/fr/" },
  { code: "sv", flag: "SE", label: "Svenska", href: "/sv/" },
  { code: "nl", flag: "NL", label: "Nederlands", href: "/nl/" },
];

const currentLang = languages.find(l => l.code === lang) || languages[0];
---

<!-- Rest of your HTML stays exactly the same -->
<header class="header">
