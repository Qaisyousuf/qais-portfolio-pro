---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

import enTranslations from '../translations/en.json';
import daTranslations from '../translations/da.json';
import frTranslations from '../translations/fr.json';
import svTranslations from '../translations/sv.json';
import nlTranslations from '../translations/nl.json';

// Get the right translations based on lang prop
const translations = {
  en: enTranslations,
  da: daTranslations,
  fr: frTranslations,
  sv: svTranslations,
  nl: nlTranslations
}[lang] || enTranslations;

// Get footer-specific translations
const t = translations.footer;

const socialLinks = [
  {
    name: t.social.github,
    url: "https://github.com/qaisyousuf",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
    </svg>`
  },
  {
    name: t.social.linkedin,
    url: "https://www.linkedin.com/in/qais-yousuf-75261b125/",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
    </svg>`
  },
  {
    name: t.social.email,
    url: "mailto:qais@seosoft.dk",
    icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
      <polyline points="22,6 12,13 2,6"/>
    </svg>`
  }
];
---

<footer class="footer">
  <div class="footer__container">
    <!-- Main Content -->
    <div class="footer__content">
      <!-- Brand Logo -->
      <div class="footer__brand">
        <div class="brand-logo">G</div>
      </div>

      <!-- Tagline -->
      <p class="footer__tagline">
        {t.tagline}
      </p>

      <!-- Social Links -->
      <div class="footer__social">
        {socialLinks.map(social => (
          <a 
            href={social.url} 
            class="social-link"
            aria-label={social.name}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="social-icon" set:html={social.icon} />
          </a>
        ))}
      </div>

      <!-- Copyright with Privacy Link -->
      <p class="footer__copyright">
        © {new Date().getFullYear()} getrok.com . {t.copyright}
        <span class="privacy-separator">•</span>
        <button 
          type="button"
          class="privacy-link" 
          data-open-privacy-modal
        >
          {t.privacy}
        </button>
      </p>
    </div>
  </div>
</footer>

<style>

    .footer__copyright {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .privacy-separator {
    color: var(--text-muted);
    opacity: 0.5;
  }

  .privacy-link {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: inherit;
    font-family: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
    padding: 0;
  }

  .privacy-link:hover {
    color: var(--accent);
  }
  .footer {
    position: relative;
    background: #000000;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 4rem 2rem;
    overflow: hidden;
  }

  .footer__glow {
    position: absolute;
    top: -80px;
    left: 50%;
    transform: translateX(-50%);
    width: 500px;
    height: 160px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .footer__container {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .footer__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
  }

  /* Brand Logo */
  .footer__brand {
    margin-bottom: 0.5rem;
  }

  .brand-logo {
    width: 56px;
    height: 56px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.03em;
    transition: all 0.4s ease;
    cursor: default;
  }

  .brand-logo:hover {
    transform: scale(1.05) rotate(-5deg);
    box-shadow: 0 8px 24px rgba(59, 130, 246, 0.3);
  }

  /* Tagline */
  .footer__tagline {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    max-width: 400px;
  }

  /* Social Links */
  .footer__social {
    display: flex;
    gap: 1rem;
  }

  .social-link {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .social-link:hover {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.4);
    color: #3b82f6;
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(59, 130, 246, 0.2);
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Copyright */
  .footer__copyright {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
    padding-top: 1rem;
  }

  /* Light Theme */
  :global(.light) .footer {
    background: #f8fafc;
    border-top-color: rgba(0, 0, 0, 0.08);
  }

  :global(.light) .footer__glow {
    background: radial-gradient(circle, rgba(59, 130, 246, 0.06) 0%, transparent 70%);
  }

  :global(.light) .footer__tagline {
    color: rgba(0, 0, 0, 0.5);
  }

  :global(.light) .social-link {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.1);
    color: rgba(0, 0, 0, 0.6);
  }

  :global(.light) .social-link:hover {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.4);
    color: #3b82f6;
    box-shadow: 0 8px 16px rgba(59, 130, 246, 0.15);
  }

  :global(.light) .footer__copyright {
    color: rgba(0, 0, 0, 0.4);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .footer {
      padding: 3rem 1rem;
    }

    .brand-logo {
      width: 48px;
      height: 48px;
      font-size: 20px;
    }

    .footer__tagline {
      font-size: 14px;
    }

    .social-link {
      width: 40px;
      height: 40px;
    }
  }
</style>