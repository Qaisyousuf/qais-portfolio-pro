---
interface Props {
  lang?: string;
}

const { lang = "en" } = Astro.props;

const steps = [
  {
    key: "discovery",
    title: "Discovery",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/>
      <path d="M21 21l-4.35-4.35"/>
    </svg>`,
    subtitle: "Understand the problem",
    description: "Deep dive into your business needs, technical challenges, and success metrics through detailed stakeholder interviews.",
    bullets: ["Requirements gathering", "Technical feasibility analysis", "Timeline & budget planning"],
    duration: "1-2 weeks"
  },
  {
    key: "planning",
    title: "Planning",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
    </svg>`,
    subtitle: "Define the roadmap",
    description: "Break down the project into clear milestones, prioritize features, and define sprint goals.",
    bullets: ["User stories & priorities", "Sprint planning", "Resource allocation"],
    duration: "1 week"
  },
  {
    key: "architecture",
    title: "Architecture",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2L2 7l10 5 10-5-10-5z"/>
      <path d="M2 17l10 5 10-5"/>
      <path d="M2 12l10 5 10-5"/>
    </svg>`,
    subtitle: "Design the system",
    description: "Clean architecture design with scalability, security, and maintainability in mind.",
    bullets: ["System design", "Technology stack", "Security & scalability"],
    duration: "1-2 weeks"
  },
  {
    key: "development",
    title: "Development",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="16 18 22 12 16 6"/>
      <polyline points="8 6 2 12 8 18"/>
    </svg>`,
    subtitle: "Build with quality",
    description: "Agile development with 2-week sprints, TDD approach, and continuous code reviews.",
    bullets: ["Clean code principles", "TDD development", "Code reviews"],
    duration: "4-12 weeks"
  },
  {
    key: "testing",
    title: "Testing",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 11l3 3L22 4"/>
      <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
    </svg>`,
    subtitle: "Ensure reliability",
    description: "Comprehensive testing strategy including unit, integration, and performance testing.",
    bullets: ["Unit & integration tests", "Performance testing", "Bug fixes & optimization"],
    duration: "1-2 weeks"
  },
  {
    key: "launch",
    title: "Launch",
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 2L2 7l10 5 10-5-10-5z"/>
      <path d="M2 17l10 5 10-5M2 12l10 5 10-5"/>
    </svg>`,
    subtitle: "Deploy & support",
    description: "Production deployment with monitoring, documentation, and ongoing support options.",
    bullets: ["Production deployment", "Documentation & training", "Ongoing support"],
    duration: "1 week + support"
  }
];
---

<section id="process" class="process">
  <div class="process__container">
    <!-- Header -->
    <div class="process__header">
      <div class="process__badge">
        <span class="badge-pulse"></span>
        HOW I WORK
      </div>
      <h2 class="process__title">From Idea to Production</h2>
      <p class="process__subtitle">
        A proven 6-step process that turns unclear problems into clean, reliable products you can trust.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="process__grid">
      {steps.map((step, idx) => (
        <article class="process-card" data-index={idx}>
          <!-- Number -->
          <div class="card-number">{String(idx + 1).padStart(2, '0')}</div>

          <!-- Icon -->
          <div class="card-icon-wrapper">
            <div class="card-icon" set:html={step.icon} />
          </div>

          <!-- Content -->
          <div class="card-content">
            <h3 class="card-title">{step.title}</h3>
            <p class="card-subtitle">{step.subtitle}</p>
            <p class="card-description">{step.description}</p>

            <!-- Bullets -->
            <ul class="card-bullets">
              {step.bullets.map((bullet) => (
                <li class="card-bullet">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA -->
  
  </div>
</section>

<script>
  // Intersection Observer for card animations
  const cards = document.querySelectorAll('.process-card');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.2 }
  );

  cards.forEach((card) => observer.observe(card));
</script>

<style>
  .process {
    min-height: 100vh;
    padding: 6rem 2rem;
    background: transparent;
    position: relative;
  }

  .process__container {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Header */
  .process__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .process__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 50px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .badge-pulse {
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  .process__title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .process__subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 640px;
    margin: 0 auto;
  }

  /* Cards Grid */
  .process__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  /* Process Card */
  .process-card {
    position: relative;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    opacity: 0;
    transform: translateY(40px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .process-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .process-card:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(59, 130, 246, 0.4);
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4),
                0 0 20px rgba(59, 130, 246, 0.15);
  }

  :global(.light) .process-card {
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  }

  :global(.light) .process-card:hover {
    background: rgba(255, 255, 255, 0.95);
    border-color: rgba(59, 130, 246, 0.5);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12),
                0 0 20px rgba(59, 130, 246, 0.1);
  }

  /* Card Number */
  .card-number {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    font-size: 3rem;
    font-weight: 900;
    color: rgba(59, 130, 246, 0.08);
    line-height: 1;
    transition: all 0.3s ease;
  }

  .process-card:hover .card-number {
    color: rgba(59, 130, 246, 0.15);
    transform: scale(1.05);
  }

  /* Icon */
  .card-icon-wrapper {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 12px;
    margin-bottom: 1.25rem;
    transition: all 0.3s ease;
  }

  .process-card:hover .card-icon-wrapper {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.3);
    transform: translateY(-2px);
  }

  .card-icon {
    color: var(--accent);
  }

  /* Content */
  .card-content {
    position: relative;
    z-index: 2;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.375rem;
  }

  .card-subtitle {
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 0.875rem;
  }

  .card-description {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }

  /* Duration - REMOVED */

  /* Bullets */
  .card-bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .card-bullet {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 13px;
    color: var(--text-secondary);
  }

  .card-bullet svg {
    flex-shrink: 0;
    color: var(--accent);
  }

  /* CTA */
  .process-cta {
    padding: 2.5rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    text-align: center;
  }

  :global(.light) .process-cta {
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .cta-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .cta-description {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 1.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    font-size: 14px;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: rgba(59, 130, 246, 0.15);
    color: var(--accent);
    border: 1px solid rgba(59, 130, 246, 0.25);
  }

  .btn-primary:hover {
    background: rgba(59, 130, 246, 0.25);
    border-color: rgba(59, 130, 246, 0.4);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.1);
    transform: translateY(-2px);
  }

  /* Mobile */
  @media (max-width: 768px) {
    .process {
      padding: 4rem 1rem;
    }

    .process__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .process-card {
      padding: 1.5rem;
    }

    .card-number {
      font-size: 2.5rem;
      top: 1.25rem;
      right: 1.25rem;
    }

    .card-icon-wrapper {
      width: 48px;
      height: 48px;
    }

    .card-title {
      font-size: 1.125rem;
    }

    .cta-buttons {
      flex-direction: column;
    }

    .btn {
      width: 100%;
    }
  }

  @media (min-width: 769px) and (max-width: 1023px) {
    .process__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .process__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>