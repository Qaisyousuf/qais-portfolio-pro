---
export const prerender = false;

type Stats = {
  totalMessages: number;
  uniqueSessions: number;
  languages: Record<string, number>;
  devices: Record<string, number>;
  countries: Record<string, number>;
  pages: Record<string, number>;
  referrers: Record<string, number>;
  daily: Record<string, number>;
};

type QuestionItem = {
  question: string;
  timestamp: string;
  language: string;
  sessionId: string;
};

type DashboardResponse =
  | {
      success: true;
      stats: Stats;
      recentQuestions: QuestionItem[];
      lastUpdated: string;
    }
  | {
      success: false;
      error: string;
    };

const r = await fetch(new URL("/api/dashboard", Astro.url), { cache: "no-store" });
const data = (await r.json()) as DashboardResponse;

function sortedEntries(obj: Record<string, number>) {
  return Object.entries(obj || {}).sort((a, b) => b[1] - a[1]);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dashboard</title>
    <style>
      body { font-family: system-ui, Arial; padding: 24px; max-width: 1100px; margin: 0 auto; }
      .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .card { border: 1px solid #ddd; border-radius: 12px; padding: 16px; }
      h1 { margin: 0 0 16px; }
      h2 { margin: 0 0 12px; font-size: 18px; }
      ul { margin: 0; padding-left: 18px; }
      .muted { color: #666; font-size: 13px; }
      table { width: 100%; border-collapse: collapse; }
      td { padding: 6px 0; border-bottom: 1px solid #eee; vertical-align: top; }
      td:last-child { text-align: right; white-space: nowrap; }
      .q { margin: 10px 0; padding: 10px; border: 1px solid #eee; border-radius: 10px; }
    </style>
  </head>

  <body>
    <h1>Dashboard</h1>

    {data.success ? (
      <>
        <p class="muted">Last updated: {data.lastUpdated}</p>

        <div class="grid">
          <div class="card">
            <h2>Summary</h2>
            <ul>
              <li><b>Total messages:</b> {data.stats.totalMessages}</li>
              <li><b>Unique sessions:</b> {data.stats.uniqueSessions}</li>
            </ul>
          </div>

          <div class="card">
            <h2>Daily</h2>
            <table>
              <tbody>
                {sortedEntries(data.stats.daily).slice(0, 10).map(([day, count]) => (
                  <tr>
                    <td>{day}</td>
                    <td>{count}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="muted">Showing top 10 days</p>
          </div>

          <div class="card">
            <h2>Languages</h2>
            <table>
              <tbody>
                {sortedEntries(data.stats.languages).slice(0, 10).map(([k, v]) => (
                  <tr>
                    <td>{k}</td>
                    <td>{v}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="card">
            <h2>Devices</h2>
            <table>
              <tbody>
                {sortedEntries(data.stats.devices).slice(0, 10).map(([k, v]) => (
                  <tr>
                    <td>{k}</td>
                    <td>{v}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="card">
            <h2>Countries</h2>
            <table>
              <tbody>
                {sortedEntries(data.stats.countries).slice(0, 10).map(([k, v]) => (
                  <tr>
                    <td>{k}</td>
                    <td>{v}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="card">
            <h2>Pages</h2>
            <table>
              <tbody>
                {sortedEntries(data.stats.pages).slice(0, 10).map(([k, v]) => (
                  <tr>
                    <td style="word-break: break-all;">{k}</td>
                    <td>{v}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="card" style="margin-top: 16px;">
          <h2>Recent Questions</h2>

          {data.recentQuestions.length === 0 ? (
            <p class="muted">No questions found yet.</p>
          ) : (
            data.recentQuestions.map((q: QuestionItem, idx: number) => (
              <div class="q">
                <div><b>{q.question}</b></div>
                <div class="muted">
                  {q.timestamp} — {q.language || "n/a"} — {q.sessionId || "n/a"}
                </div>
              </div>
            ))
          )}
        </div>
      </>
    ) : (
      <div class="card">
        <h2>Error</h2>
        <p>{data.error}</p>
      </div>
    )}
  </body>
</html>
