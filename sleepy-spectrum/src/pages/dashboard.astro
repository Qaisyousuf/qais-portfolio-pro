---
/**
 * PRIVATE DASHBOARD - GetRok Analytics
 * URL: getrok.com/dashboard?key=YOUR_DASHBOARD_SECRET
 */
import Layout from '../layouts/Layout.astro';
---

<Layout title="GetRok Dashboard">
  <main class="min-h-screen px-4 py-8 md:px-6 lg:px-8 max-w-[80rem] mx-auto">

    <!-- Login Screen -->
    <div id="loginScreen" class="flex items-center justify-center min-h-screen">
      <div class="w-full max-w-[400px] p-8 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl text-center overflow-hidden">
        <div class="w-14 h-14 mx-auto mb-6 rounded-xl bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-2xl font-extrabold text-white">G</div>
        <h1 class="text-2xl font-extrabold mb-2">GetRok Dashboard</h1>
        <p class="text-sm text-[var(--text-muted)] mb-8">Enter your access key to view analytics</p>
        <input type="password" id="loginKey" placeholder="Access key..."
          class="box-border w-full max-w-full px-4 py-3 rounded-lg border border-white/10 bg-black/20 text-[var(--text-primary)] text-sm outline-none focus:border-blue-500 placeholder:text-[var(--text-muted)] mb-4" style="box-sizing:border-box" />
        <button id="loginBtn"
          class="w-full py-3 rounded-lg border border-blue-500/20 bg-blue-500/10 text-blue-400 text-sm font-semibold cursor-pointer hover:bg-blue-500/20 hover:border-blue-500/40 transition-all">
          Access Dashboard
        </button>
        <p id="loginError" class="text-rose-400 text-xs mt-3 hidden">Invalid access key. Try again.</p>
      </div>
    </div>

    <!-- Loading Screen -->
    <div id="loadingScreen" class="hidden items-center justify-center min-h-screen">
      <div class="w-10 h-10 border-[3px] border-white/10 border-t-blue-500 rounded-full animate-spin"></div>
    </div>

    <!-- Dashboard Content -->
    <div id="dashboard" class="hidden">

      <!-- Header -->
      <div class="flex items-center justify-between mb-10 flex-wrap gap-4">
        <div class="flex items-center gap-4">
          <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-lg font-extrabold text-white">G</div>
          <div>
            <h1 class="text-2xl font-extrabold tracking-tight">GetRok Analytics</h1>
            <div class="flex items-center gap-1.5 mt-1 text-xs text-emerald-400">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Live Data
            </div>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span id="lastUpdated" class="text-xs text-[var(--text-muted)]"></span>
          <button id="refreshBtn"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-white/10 bg-white/[0.03] text-[var(--text-secondary)] text-xs font-semibold cursor-pointer hover:border-white/20 hover:text-white transition-all">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Refresh
          </button>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4 mb-8">
        <div class="p-5 md:p-6 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl hover:border-white/20 hover:bg-white/[0.06] hover:-translate-y-1 transition-all duration-300">
          <div class="w-10 h-10 rounded-[0.625rem] flex items-center justify-center mb-4 bg-blue-500/10 border border-blue-500/20">
            <svg class="w-5 h-5 text-blue-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <div id="totalMessages" class="text-3xl md:text-4xl font-extrabold tracking-tight leading-tight">—</div>
          <div class="text-[0.6875rem] text-[var(--text-muted)] mt-1 uppercase tracking-widest font-semibold">Total Messages</div>
        </div>

        <div class="p-5 md:p-6 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl hover:border-white/20 hover:bg-white/[0.06] hover:-translate-y-1 transition-all duration-300">
          <div class="w-10 h-10 rounded-[0.625rem] flex items-center justify-center mb-4 bg-emerald-500/10 border border-emerald-500/20">
            <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div id="uniqueSessions" class="text-3xl md:text-4xl font-extrabold tracking-tight leading-tight">—</div>
          <div class="text-[0.6875rem] text-[var(--text-muted)] mt-1 uppercase tracking-widest font-semibold">Unique Sessions</div>
        </div>

        <div class="p-5 md:p-6 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl hover:border-white/20 hover:bg-white/[0.06] hover:-translate-y-1 transition-all duration-300">
          <div class="w-10 h-10 rounded-[0.625rem] flex items-center justify-center mb-4 bg-purple-500/10 border border-purple-500/20">
            <svg class="w-5 h-5 text-purple-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <div id="avgMessages" class="text-3xl md:text-4xl font-extrabold tracking-tight leading-tight">—</div>
          <div class="text-[0.6875rem] text-[var(--text-muted)] mt-1 uppercase tracking-widest font-semibold">Avg per Session</div>
        </div>

        <div class="p-5 md:p-6 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl hover:border-white/20 hover:bg-white/[0.06] hover:-translate-y-1 transition-all duration-300">
          <div class="w-10 h-10 rounded-[0.625rem] flex items-center justify-center mb-4 bg-amber-500/10 border border-amber-500/20">
            <svg class="w-5 h-5 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
              <path d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"/>
            </svg>
          </div>
          <div id="hotLeads" class="text-3xl md:text-4xl font-extrabold tracking-tight leading-tight">—</div>
          <div class="text-[0.6875rem] text-[var(--text-muted)] mt-1 uppercase tracking-widest font-semibold">Hot Leads (5+ msgs)</div>
        </div>
      </div>

      <!-- Charts Row -->
      <div class="grid grid-cols-1 lg:grid-cols-[2fr_1fr] gap-3 md:gap-4 mb-8">
        <div class="p-5 md:p-6 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl">
          <div class="text-sm font-bold mb-5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            Daily Activity
          </div>
          <div class="relative w-full h-[250px]">
            <canvas id="dailyChart"></canvas>
          </div>
        </div>

        <div class="p-5 md:p-6 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl">
          <div class="text-sm font-bold mb-5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Languages
          </div>
          <div class="relative w-full h-[250px]">
            <canvas id="languageChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Small Charts Row -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4 mb-8">
        <div class="p-5 md:p-6 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl">
          <div class="text-sm font-bold mb-5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-purple-500"></span>
            Devices
          </div>
          <div class="relative w-full h-[200px]">
            <canvas id="deviceChart"></canvas>
          </div>
        </div>

        <div class="p-5 md:p-6 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl">
          <div class="text-sm font-bold mb-5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            Top Referrers
          </div>
          <div class="relative w-full h-[200px]">
            <canvas id="referrerChart"></canvas>
          </div>
        </div>

        <div class="p-5 md:p-6 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl">
          <div class="text-sm font-bold mb-5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
            Pages
          </div>
          <div class="relative w-full h-[200px]">
            <canvas id="pageChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Recent Questions Table -->
      <div class="p-5 md:p-6 rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur-xl mb-8">
        <div class="flex items-center justify-between mb-5">
          <div class="text-sm font-bold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            Recent Questions
          </div>
          <span id="questionCount" class="text-xs text-[var(--text-muted)] px-3 py-1 rounded-full border border-white/10 bg-black/20">0 questions</span>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-[0.8125rem]" style="table-layout:fixed">
            <thead>
              <tr>
                <th class="text-left p-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-[var(--text-muted)] border-b border-white/10" style="width:2.5rem"></th>
                <th class="text-left p-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-[var(--text-muted)] border-b border-white/10" style="width:5rem">Time</th>
                <th class="text-left p-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-[var(--text-muted)] border-b border-white/10">Question</th>
                <th class="text-left p-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-[var(--text-muted)] border-b border-white/10" style="width:6.5rem">Lang</th>
                <th class="text-left p-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-[var(--text-muted)] border-b border-white/10" style="width:5rem">Session</th>
                <th class="text-left p-3 text-[0.6875rem] font-semibold uppercase tracking-widest text-[var(--text-muted)] border-b border-white/10" style="width:3.5rem">Msgs</th>
              </tr>
            </thead>
            <tbody id="questionsBody"></tbody>
          </table>
        </div>
        <!-- Pagination -->
        <div id="pagination" class="flex items-center justify-center gap-2 mt-5 flex-wrap"></div>
      </div>

    </div>
  </main>

  <!-- Chart.js CDN -->
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

  <script is:inline>
    var dashboardKey = '';
    var chartInstances = {};
    var currentPage = 1;
    var pageSize = 10;
    var allSessions = [];

    var loginScreen = document.getElementById('loginScreen');
    var loadingScreen = document.getElementById('loadingScreen');
    var dashboard = document.getElementById('dashboard');
    var loginBtn = document.getElementById('loginBtn');
    var loginKey = document.getElementById('loginKey');
    var loginError = document.getElementById('loginError');

    var urlParams = new URLSearchParams(window.location.search);
    var urlKey = urlParams.get('key');
    if (urlKey) { dashboardKey = urlKey; showLoading(); fetchData(); }

    loginBtn.addEventListener('click', handleLogin);
    loginKey.addEventListener('keypress', function(e) { if (e.key === 'Enter') handleLogin(); });

    function handleLogin() {
      dashboardKey = loginKey.value.trim();
      if (!dashboardKey) return;
      loginError.classList.add('hidden');
      showLoading(); fetchData();
    }

    function showLoading() { loginScreen.style.display='none'; loadingScreen.style.display='flex'; dashboard.style.display='none'; }
    function showDashboard() { loginScreen.style.display='none'; loadingScreen.style.display='none'; dashboard.style.display='block'; }
    function showLoginError() { loginScreen.style.display='flex'; loadingScreen.style.display='none'; dashboard.style.display='none'; loginError.classList.remove('hidden'); }

    async function fetchData() {
      try {
        var res = await fetch('/api/dashboard?key=' + encodeURIComponent(dashboardKey));
        if (res.status === 401) { showLoginError(); return; }
        var data = await res.json();
        if (!data.success) { showLoginError(); return; }
        window._lastData = data;
        renderDashboard(data); showDashboard();
      } catch (err) { console.error(err); showLoginError(); }
    }

    document.getElementById('refreshBtn').addEventListener('click', function() { showLoading(); fetchData(); });

    function renderDashboard(data) {
      var stats = data.stats;
      var questions = data.recentQuestions || [];
      document.getElementById('totalMessages').textContent = stats.totalMessages.toLocaleString();
      document.getElementById('uniqueSessions').textContent = stats.uniqueSessions.toLocaleString();
      document.getElementById('avgMessages').textContent = stats.uniqueSessions > 0 ? (stats.totalMessages / stats.uniqueSessions).toFixed(1) : '0';
      var sc = {};
      questions.forEach(function(q) { if (q.sessionId) sc[q.sessionId] = (sc[q.sessionId]||0)+1; });
      document.getElementById('hotLeads').textContent = Object.values(sc).filter(function(c){return c>=5;}).length;
      document.getElementById('lastUpdated').textContent = 'Updated ' + new Date(data.lastUpdated).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'});
      renderCharts(data); renderQuestions(questions);
    }

    function getChartColors() {
      return { grid:'rgba(255,255,255,0.06)', text:'rgba(255,255,255,0.5)', blue:'rgb(59,130,246)', blueBg:'rgba(59,130,246,0.15)', emerald:'rgb(16,185,129)', purple:'rgb(168,85,247)', amber:'rgb(245,158,11)', rose:'rgb(244,63,94)', cyan:'rgb(6,182,212)', palette:['rgb(59,130,246)','rgb(244,63,94)','rgb(168,85,247)','rgb(245,158,11)','rgb(6,182,212)','rgb(16,185,129)'] };
    }

    function destroyCharts() { Object.values(chartInstances).forEach(function(c){c.destroy();}); chartInstances={}; }

    function renderCharts(data) {
      destroyCharts();
      var c = getChartColors(), s = data.stats;
      var dL = Object.keys(s.daily).sort().slice(-30), dV = dL.map(function(d){return s.daily[d];});
      chartInstances.daily = new Chart(document.getElementById('dailyChart'), { type:'line', data:{labels:dL.map(function(d){return new Date(d).toLocaleDateString([],{month:'short',day:'numeric'});}),datasets:[{label:'Messages',data:dV,borderColor:c.blue,backgroundColor:c.blueBg,fill:true,tension:0.4,borderWidth:2,pointRadius:3,pointBackgroundColor:c.blue}]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{color:c.grid},ticks:{color:c.text,font:{size:11},maxRotation:45}},y:{grid:{color:c.grid},ticks:{color:c.text,font:{size:11}},beginAtZero:true}}} });

      // Compute languages from PAGE field (e.g. /da/ = Danish, /fr/ = French, / = English)
      var langNameMap={'en':'English','fr':'French','da':'Danish','sv':'Swedish','nl':'Dutch'};
      var langColorMap={'English':'rgb(59,130,246)','French':'rgb(244,63,94)','Danish':'rgb(168,85,247)','Swedish':'rgb(245,158,11)','Dutch':'rgb(6,182,212)'};
      var questions = data.recentQuestions || [];
      var langCounts={};
      questions.forEach(function(q){
        var code=detectLang(q);
        var name=langNameMap[code]||code.toUpperCase();
        langCounts[name]=(langCounts[name]||0)+1;
      });
      var normLabels=Object.keys(langCounts),normValues=Object.values(langCounts);
      var normColors=normLabels.map(function(l){return langColorMap[l]||c.palette[normLabels.indexOf(l)%c.palette.length];});
      chartInstances.language = new Chart(document.getElementById('languageChart'), { type:'doughnut', data:{labels:normLabels,datasets:[{data:normValues,backgroundColor:normColors,borderWidth:0,hoverOffset:8}]}, options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{position:'bottom',labels:{color:c.text,font:{size:12,weight:'bold'},padding:16,usePointStyle:true}}}} });

      var dvL=Object.keys(s.devices),dvV=Object.values(s.devices);
      chartInstances.device = new Chart(document.getElementById('deviceChart'), { type:'bar', data:{labels:dvL.map(function(d){return d.charAt(0).toUpperCase()+d.slice(1);}),datasets:[{data:dvV,backgroundColor:[c.purple,c.cyan,c.amber,c.emerald].slice(0,dvL.length),borderRadius:8,borderSkipped:false}]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{display:false},ticks:{color:c.text,font:{size:11}}},y:{grid:{color:c.grid},ticks:{color:c.text,font:{size:11}},beginAtZero:true}}} });

      var rE=Object.entries(s.referrers).sort(function(a,b){return b[1]-a[1];}).slice(0,6);
      chartInstances.referrer = new Chart(document.getElementById('referrerChart'), { type:'bar', data:{labels:rE.map(function(e){var l=e[0];return l.length>20?l.substring(0,20)+'...':l||'Direct';}),datasets:[{data:rE.map(function(e){return e[1];}),backgroundColor:c.amber,borderRadius:8,borderSkipped:false}]}, options:{responsive:true,maintainAspectRatio:false,indexAxis:'y',plugins:{legend:{display:false}},scales:{x:{grid:{color:c.grid},ticks:{color:c.text,font:{size:11}},beginAtZero:true},y:{grid:{display:false},ticks:{color:c.text,font:{size:10}}}}} });

      var pE=Object.entries(s.pages).sort(function(a,b){return b[1]-a[1];}).slice(0,6);
      chartInstances.page = new Chart(document.getElementById('pageChart'), { type:'bar', data:{labels:pE.map(function(e){return e[0]||'/';}),datasets:[{data:pE.map(function(e){return e[1];}),backgroundColor:c.cyan,borderRadius:8,borderSkipped:false}]}, options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{grid:{display:false},ticks:{color:c.text,font:{size:11}}},y:{grid:{color:c.grid},ticks:{color:c.text,font:{size:11}},beginAtZero:true}}} });
    }

    function renderQuestions(questions) {
      var sessionMap = {};
      questions.forEach(function(q) { if (!q.sessionId) return; if (!sessionMap[q.sessionId]) sessionMap[q.sessionId]=[]; sessionMap[q.sessionId].push(q); });
      var seen = {}; allSessions = [];
      questions.forEach(function(q) { if (!q.sessionId||seen[q.sessionId]) return; seen[q.sessionId]=true; allSessions.push({firstQuestion:q,messages:sessionMap[q.sessionId]||[],sessionId:q.sessionId}); });
      document.getElementById('questionCount').textContent = allSessions.length+' sessions \u00B7 '+questions.length+' messages';
      currentPage=1; renderPage();
    }

    function renderPage() {
      var tbody = document.getElementById('questionsBody');
      var totalPages = Math.ceil(allSessions.length/pageSize);
      if (currentPage>totalPages) currentPage=totalPages;
      if (currentPage<1) currentPage=1;
      var start=(currentPage-1)*pageSize, end=Math.min(start+pageSize,allSessions.length);
      tbody.innerHTML='';

      allSessions.slice(start,end).forEach(function(session,idx) {
        var q=session.firstQuestion, msgs=session.messages, gIdx=start+idx;
        var time=q.timestamp?formatTime(q.timestamp):'\u2014';
        var lang=detectLang(q);
        var lc={en:'bg-blue-500/10 border-blue-500/20 text-blue-400',da:'bg-rose-500/10 border-rose-500/20 text-rose-400',fr:'bg-purple-500/10 border-purple-500/20 text-purple-400',sv:'bg-amber-500/10 border-amber-500/20 text-amber-400',nl:'bg-cyan-500/10 border-cyan-500/20 text-cyan-400'};
        var langNames={en:'English',da:'Danish',fr:'French',sv:'Swedish',nl:'Dutch'};
        var ss=q.sessionId?q.sessionId.substring(0,8):'\u2014';

        var mainRow=document.createElement('tr');
        mainRow.className='cursor-pointer hover:bg-white/[0.02] transition-colors';
        var h='<td class="p-3 border-b border-white/[0.04]"><span class="inline-block text-xs text-[var(--text-muted)] transition-transform duration-200" style="width:1rem;text-align:center" data-arrow>\u25B6</span></td>';
        h+='<td class="p-3 border-b border-white/[0.04] whitespace-nowrap text-xs">'+time+'</td>';
        h+='<td class="p-3 border-b border-white/[0.04] text-[var(--text-secondary)]" style="max-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+escapeHtml(q.question||'\u2014')+'</td>';
        h+='<td class="p-3 border-b border-white/[0.04]"><span class="inline-flex px-2 py-0.5 rounded-full text-[0.6875rem] font-semibold border '+(lc[lang]||lc.en)+'">'+(langNames[lang]||lang.toUpperCase())+'</span></td>';
        h+='<td class="p-3 border-b border-white/[0.04] font-mono text-[0.6875rem] text-[var(--text-muted)]">'+ss+'</td>';
        h+='<td class="p-3 border-b border-white/[0.04]"><span class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 rounded-full text-[0.625rem] font-bold bg-blue-500/10 border border-blue-500/20 text-blue-400">'+msgs.length+'</span></td>';
        mainRow.innerHTML=h;
        tbody.appendChild(mainRow);

        var detailRow=document.createElement('tr');
        detailRow.className='hidden';
        var dtd=document.createElement('td');
        dtd.setAttribute('colspan','6');
        dtd.className='p-0 border-b border-white/10';

        var panel=document.createElement('div');
        panel.className='p-5 bg-black/15 border-t border-white/10';

        var hdr=document.createElement('div');
        hdr.className='flex items-center justify-between mb-4 flex-wrap gap-2';
        var th='<div class="text-[0.8125rem] font-bold flex items-center gap-2">Session '+ss+' <span class="inline-flex items-center justify-center min-w-5 h-5 px-1.5 rounded-full text-[0.625rem] font-bold bg-blue-500/10 border border-blue-500/20 text-blue-400">'+msgs.length+' msgs</span>';
        if(msgs.length>=5) th+=' <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[0.625rem] font-bold bg-amber-500/10 border border-amber-500/20 text-amber-400">\uD83D\uDD25 Hot Lead</span>';
        th+='</div>';
        var fm=msgs[0]||{};
        var mh='<div class="flex gap-2 flex-wrap">';
        [fm.country||'\u2014',fm.device||'\u2014',fm.referrer||'Direct',fm.page||'/',fm.screenSize||'\u2014'].forEach(function(v){
          var sp=document.createElement('span'); sp.textContent=v;
          mh+='<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full border border-white/10 bg-black/20 text-[0.6875rem] text-[var(--text-secondary)]">'+sp.innerHTML+'</span>';
        });
        mh+='</div>';
        hdr.innerHTML=th+mh;
        panel.appendChild(hdr);

        var md=document.createElement('div');
        md.className='flex flex-col gap-3 max-h-[500px] overflow-y-auto pr-2';
        msgs.forEach(function(msg){
          var mt=msg.timestamp?formatTime(msg.timestamp):'';
          if(msg.question){
            var ub=document.createElement('div');
            ub.className='ml-auto max-w-[85%] p-3.5 rounded-xl rounded-br-sm bg-blue-500/10 border border-blue-500/20 text-blue-400 text-[0.8125rem] leading-relaxed';
            var ul=document.createElement('div'); ul.className='text-[0.625rem] font-bold uppercase tracking-widest mb-1.5 text-blue-400'; ul.textContent='\uD83D\uDC64 Visitor'; ub.appendChild(ul);
            var ut=document.createElement('div'); ut.className='break-words'; ut.textContent=msg.question; ub.appendChild(ut);
            var utt=document.createElement('div'); utt.className='text-[0.625rem] text-[var(--text-muted)] mt-2'; utt.textContent=mt; ub.appendChild(utt);
            md.appendChild(ub);
          }
          if(msg.response){
            var ab=document.createElement('div');
            ab.className='mr-auto max-w-[85%] p-3.5 rounded-xl rounded-bl-sm bg-white/[0.04] border border-white/10 text-[var(--text-secondary)] text-[0.8125rem] leading-relaxed';
            var al=document.createElement('div'); al.className='text-[0.625rem] font-bold uppercase tracking-widest mb-1.5 text-emerald-400'; al.textContent='\uD83E\uDD16 GetRok AI'; ab.appendChild(al);
            var at=document.createElement('div'); at.className='break-words whitespace-pre-wrap'; at.textContent=msg.response; ab.appendChild(at);
            var att=document.createElement('div'); att.className='text-[0.625rem] text-[var(--text-muted)] mt-2'; att.textContent=mt; ab.appendChild(att);
            md.appendChild(ab);
          }
        });
        panel.appendChild(md); dtd.appendChild(panel); detailRow.appendChild(dtd); tbody.appendChild(detailRow);

        mainRow.addEventListener('click',function(){
          var isOpen=!detailRow.classList.contains('hidden');
          document.querySelectorAll('tr.hidden-detail,tr:not(.hidden)[data-open]').forEach(function(){});
          tbody.querySelectorAll('tr').forEach(function(r){
            if(r!==mainRow&&r!==detailRow){
              var arrow=r.querySelector('[data-arrow]');
              if(arrow) arrow.style.transform='rotate(0deg)';
              if(!r.querySelector('th')){
                var next=r.nextElementSibling;
                if(next&&next.querySelector('[colspan]')) next.classList.add('hidden');
              }
            }
          });
          if(!isOpen){
            detailRow.classList.remove('hidden');
            mainRow.querySelector('[data-arrow]').style.transform='rotate(90deg)';
          } else {
            detailRow.classList.add('hidden');
            mainRow.querySelector('[data-arrow]').style.transform='rotate(0deg)';
          }
        });
      });
      renderPagination();
    }

    function renderPagination() {
      var ct=document.getElementById('pagination'), tp=Math.ceil(allSessions.length/pageSize);
      if(allSessions.length===0){ct.innerHTML='';return;}
      var h='';

      // Page info - always show
      var si=(currentPage-1)*pageSize+1;
      var ei=Math.min(currentPage*pageSize,allSessions.length);
      h+='<span class="text-xs text-[var(--text-muted)]">'+si+'\u2013'+ei+' of '+allSessions.length+'</span>';

      // Nav buttons only when multiple pages
      if(tp>1) {
        var bc='inline-flex items-center justify-center min-w-9 h-9 px-2.5 rounded-lg border border-white/10 bg-white/[0.03] text-[var(--text-secondary)] text-[0.8125rem] font-semibold cursor-pointer hover:border-white/20 hover:text-white transition-all';
        var ac='inline-flex items-center justify-center min-w-9 h-9 px-2.5 rounded-lg border border-blue-500/20 bg-blue-500/10 text-blue-400 text-[0.8125rem] font-semibold';
        h+='<button class="'+bc+'" '+(currentPage<=1?'disabled style="opacity:0.3;cursor:default"':'')+' data-page="prev">\u25C0</button>';
        var sp=Math.max(1,currentPage-2),ep=Math.min(tp,sp+4);
        if(ep-sp<4)sp=Math.max(1,ep-4);
        if(sp>1){h+='<button class="'+bc+'" data-page="1">1</button>';if(sp>2)h+='<span class="text-xs text-[var(--text-muted)] px-1">\u2026</span>';}
        for(var i=sp;i<=ep;i++)h+='<button class="'+(i===currentPage?ac:bc)+'" data-page="'+i+'">'+i+'</button>';
        if(ep<tp){if(ep<tp-1)h+='<span class="text-xs text-[var(--text-muted)] px-1">\u2026</span>';h+='<button class="'+bc+'" data-page="'+tp+'">'+tp+'</button>';}
        h+='<button class="'+bc+'" '+(currentPage>=tp?'disabled style="opacity:0.3;cursor:default"':'')+' data-page="next">\u25B6</button>';
      }

      // Page size dropdown - ALWAYS visible
      h+='<select data-action="pagesize" style="padding:0.375rem 2rem 0.375rem 0.625rem;border-radius:0.5rem;border:1px solid rgba(255,255,255,0.15);background-color:#0a0a0a;color:rgba(255,255,255,0.75);font-size:0.75rem;font-weight:500;cursor:pointer;outline:none;appearance:auto;-webkit-appearance:auto">';
      [10,20,50].forEach(function(s){
        h+='<option value="'+s+'" style="background-color:#0a0a0a;color:#ddd;padding:4px"'+(s===pageSize?' selected':'')+'>'+s+' / page</option>';
      });
      h+='</select>';

      ct.innerHTML=h;
    }

    document.getElementById('pagination').addEventListener('click',function(e){
      var btn=e.target.closest('[data-page]');
      if(!btn||btn.disabled)return;
      var p=btn.getAttribute('data-page');
      if(p==='prev')currentPage--;else if(p==='next')currentPage++;else currentPage=parseInt(p);
      renderPage();
    });

    document.getElementById('pagination').addEventListener('change',function(e){
      if(e.target.getAttribute('data-action')==='pagesize'){pageSize=parseInt(e.target.value);currentPage=1;renderPage();}
    });

    function detectLang(q) {
      // Primary: detect from page URL path (most reliable)
      var page = (q.page || '').toLowerCase();
      if (page.indexOf('/da') !== -1) return 'da';
      if (page.indexOf('/fr') !== -1) return 'fr';
      if (page.indexOf('/sv') !== -1) return 'sv';
      if (page.indexOf('/nl') !== -1) return 'nl';
      // Secondary: check referrer URL for language path
      var ref = (q.referrer || '').toLowerCase();
      if (ref.indexOf('/da') !== -1) return 'da';
      if (ref.indexOf('/fr') !== -1) return 'fr';
      if (ref.indexOf('/sv') !== -1) return 'sv';
      if (ref.indexOf('/nl') !== -1) return 'nl';
      // Fallback: use language field if available
      var lang = (q.language || 'en').toLowerCase().substring(0, 2);
      if (['en','da','fr','sv','nl'].indexOf(lang) !== -1) return lang;
      return 'en';
    }

    function formatTime(ts){
      try{var d=new Date(ts),n=new Date(),ms=n-d,hr=ms/(1e3*60*60);
      if(hr<1)return Math.floor(ms/6e4)+'m ago';if(hr<24)return Math.floor(hr)+'h ago';if(hr<48)return 'Yesterday';
      return d.toLocaleDateString([],{month:'short',day:'numeric'});}catch(e){return '\u2014';}
    }

    function escapeHtml(t){var d=document.createElement('div');d.textContent=t||'';return d.innerHTML;}
  </script>
</Layout>